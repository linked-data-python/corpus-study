from rdflib import Graph, Namespace, BNode, URIRef
from atomrdf_context import (
    cmso:,
    ldo:,
    pldo:,
    podo:,
    cdco:,
    prov:,
    Literal,
    asmo:,
    mdo:,
)

def to_graph_calculated_properties(self, graph, simulation):
    @graph graph
    for param in self.calculated_property or []:
        param_uri = param.to_graph(graph)
        +{ {param_uri} asmo:wasCalculatedBy {simulation} }
        for sample_id in param.associate_to_sample or []:
            print(sample_id)
            +{ f<{sample_id}> asmo:hasCalculatedProperty {param_uri} }
