from rdflib.namespace import RDF, NamespaceManager
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .


def _reify(self, g, s):
    """
    Add a statement object to g that binds to s
    """
    n = self.conf['new_graph_uri'](s)
    g += g{
        {n} rdf:type rdf:Statement ;
           rdf:subject {s[0]} ;
           rdf:predicate {s[1]} ;
           rdf:object {s[2]}
    }
    return n
