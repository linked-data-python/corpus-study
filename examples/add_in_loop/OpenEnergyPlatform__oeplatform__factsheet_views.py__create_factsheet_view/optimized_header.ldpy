from rdflib import Literal
from context_shim import obo:, oeo:, rdfs:, xsd:, remove_non_printable, _publications, bundle, study_URI

@graph bundle
for item in _publications:
    publications_URI = f<https://openenergyplatform.org/ontology/oekg/publication/{item['id']}>
    # OEO_00020012
    +{ {publications_URI} oeo:OEO_00390095 {item["id"]} ; a oeo:OEO_00020012 .
       {study_URI} obo:BFO_0000051 {publications_URI} }
    if item["report_title"] != "":
        +{ {publications_URI} rdfs:label {remove_non_printable(item["report_title"])} }

    for author in item["authors"]:
        author_URI = f<https://openenergyplatform.org/ontology/oekg/{author['iri']}>
        +{ {author_URI} a oeo:OEO_00000064 . {publications_URI} oeo:OEO_00000506 {author_URI} }

    if item["doi"] != "":
        +{ {publications_URI} oeo:OEO_00390098 {Literal(item["doi"])} }

    if item["date_of_publication"] not in ("01-01-1900", ""):
        +{ {publications_URI} oeo:OEO_00390096 f"{item['date_of_publication']}"^^xsd:dateTime }

    if item["link_to_study_report"] != "":
        +{ f<{item['link_to_study_report']}> a oeo:OEO_00000353 .
           {publications_URI} oeo:OEO_00390078 f<{item['link_to_study_report']}> }
