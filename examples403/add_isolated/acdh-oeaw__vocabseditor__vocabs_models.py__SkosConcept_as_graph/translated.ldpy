from rdflib import DC, DCTERMS, OWL, RDF, RDFS, SKOS, XSD, Graph, Literal, URIRef
from .utils import modelprops_to_graph
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


def as_graph(self):
    g = Graph()
    subj = self.get_subject()
    main_concept_scheme = self.scheme.get_subject()
    g += g{
        {subj} a skos:Concept ;
           skos:prefLabel {Literal(self.pref_label, lang=self.pref_label_lang)} ;
           skos:inScheme {main_concept_scheme}
    }
    if self.notation != "":
        g += g{ {subj} skos:notation {Literal(self.notation)} }
    if self.broader_concept:
        g += g{ {subj} skos:broader {URIRef(self.broader_concept.create_uri())} }
    else:
        g += g{
            {main_concept_scheme} skos:hasTopConcept {URIRef(subj)} .
            {subj} skos:topConceptOf {main_concept_scheme}
        }
    for x in self.narrower_concepts.all():
        g += g{ {subj} skos:narrower {URIRef(x.create_uri())} }
    for note in self.has_notes.all():
        g = g + note.as_graph()
    for source in self.has_sources.all():
        g += g{ {subj} dc:source {Literal(source.name, lang=source.language)} }
    for label in self.has_labels.all():
        if label.label_type == "prefLabel":
            g += g{ {subj} skos:prefLabel {Literal(label.name, lang=label.language)} }
        elif label.label_type == "altLabel":
            g += g{ {subj} skos:altLabel {Literal(label.name, lang=label.language)} }
        elif label.label_type == "hiddenLabel":
            g += g{ {subj} skos:hiddenLabel {Literal(label.name, lang=label.language)} }
        else:
            g += g{ {subj} skos:altLabel {Literal(label.name, lang=label.language)} }
    return modelprops_to_graph(self, subj, g)
