@prefix sem: <http://example.org/semtech#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
from rdflib import Graph, Namespace, URIRef, Literal
from rdflib.namespace import RDF, RDFS, OWL, SKOS, DCTERMS, XSD, PROV
from context_predecl import BASEDIR, S
SEM = Namespace("http://example.org/semtech#")
g2 = Graph().parse(f"{BASEDIR}/02-ontology/semtech_tbox_v5_2_0.ttl")

@graph g2
for @bindings as b in [
    {"pid": "governsSubject", "plab": "governs subject", "pdef": "This property links a governance role, activity or rule to the taxonomy subject area it governs."},
    {"pid": "performsActivity", "plab": "performs activity", "pdef": "This property links a governance role to the activity it performs.", "prange": SEM.GovernanceActivity},
    {"pid": "appliesRule", "plab": "applies rule", "pdef": "This property links a governance activity to the rule it applies when a change or dispute arises.", "prange": SEM.GovernanceRule},
]:
    +{ sem:{?pid} a owl:ObjectProperty ;
                  rdfs:label {b.raw["plab"]}@en ;
                  skos:definition {b.raw["pdef"]}@en ;
                  dcterms:source {S("R-TOGAF")}@en }
    +{ sem:{?pid} rdfs:range ?prange }
