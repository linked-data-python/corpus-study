michel = <urn:michel>
cheese = <urn:cheese>
likes = <urn:likes>
pizza = <urn:pizza>

def test_create_db(getgraph):
    graph = getgraph
    graph += g{
        {michel} {likes} {pizza} ;
           {likes} {cheese}
    }
    graph.commit()
    assert (
        len(graph) == 5
    )  # f"There must be three triples in the graph after the first data chunk parse, not {len(graph)}"
