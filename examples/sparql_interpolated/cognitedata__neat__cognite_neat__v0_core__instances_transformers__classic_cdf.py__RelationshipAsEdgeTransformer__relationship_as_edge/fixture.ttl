# Input graph for cognitedata__neat__cognite_neat__v0_core__instances_transformers__classic_cdf.py__RelationshipAsEdgeTransformer__relationship_as_edge — written during translation.
# It must cover: several solutions of the pattern the region reads, the
# zero-solution case, and neighbouring triples that must NOT match.
@prefix classic: <http://example.org/classic/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

# rel-1: both source (asset-1) and target (ts-1) resolve -- an edge is built.
classic:rel-1
    rdf:type classic:Relationship ;
    classic:sourceExternalId "asset-1" ;
    classic:targetExternalId "ts-1" ;
    classic:externalId "edge-1" ;
    classic:confidence "0.9" .

# rel-2: sourceExternalId points to an Asset the lookup does not know ->
# ValueError on the first lookup -> [] (zero-solution case for the source
# arm).
classic:rel-2
    rdf:type classic:Relationship ;
    classic:sourceExternalId "asset-unknown" ;
    classic:targetExternalId "ts-1" ;
    classic:externalId "edge-2" .

# rel-3: source resolves but targetExternalId does not -> ValueError on the
# second lookup -> [] (zero-solution case for the target arm).
classic:rel-3
    rdf:type classic:Relationship ;
    classic:sourceExternalId "asset-1" ;
    classic:targetExternalId "ts-unknown" ;
    classic:externalId "edge-3" .

# Neighbourhood that must NOT be picked up when DESCRIBE-ing rel-1/2/3: a
# fourth relationship never queried by any driver call, plus the two
# entities the lookups resolve to, sitting in the same graph but not
# related by any triple visible from a DESCRIBE of the relationship IRIs.
classic:rel-4
    rdf:type classic:Relationship ;
    classic:sourceExternalId "asset-1" ;
    classic:targetExternalId "ts-1" ;
    classic:externalId "edge-4" .

classic:asset-1 rdf:type classic:Asset ; classic:externalId "asset-1" .
classic:ts-1 rdf:type classic:TimeSeries ; classic:externalId "ts-1" .
