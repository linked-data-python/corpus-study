from rdflib import (
    BNode,
    Literal,
    Namespace,
    RDF,
    RDFS,
    URIRef,
    Variable
)
from rdflib.term import Identifier
from infixowl_context import Individual, classOrIdentifier

def _set_type(self, kind):
    if not kind:
        return
    if isinstance(kind, (Individual, Identifier)):
        self.graph += g{ {self.identifier} a {classOrIdentifier(kind)} }
    else:
        for c in kind:
            assert isinstance(c, (Individual, Identifier))
            self.graph += g{ {self.identifier} a {classOrIdentifier(c)} }
