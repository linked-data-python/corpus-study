import yaml
from rdflib import DCAT, DCTERMS, SKOS, Graph, Literal, Namespace, URIRef
from rdflib.namespace import OWL, RDF, RDFS
@prefix nsos: <https://owaspsamm.org/model/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

BASEDIR = Path("external/samm-model")

def parse_maturity(g):
    for f in (BASEDIR / "maturity_levels").glob("*.yml"):
        data = yaml.safe_load(f.read_text())
        id_ = data["id"]
        uri = URIRef(f"{NS_OS}{id_}")
        g += g{
            {uri} a nsos:MaturityLevel ;
               rdfs:label {Literal(data["number"])} ;
               dcterms:identifier {Literal(id_)} ;
               skos:altLabel {Literal(data["number"])} ;
               dcterms:description {Literal(data["description"])}
        }

        # Relation
        hr_uri = URIRef(f"{NS_OS}maturity/{data['number']}")
        g += g{
            {hr_uri} a nsos:MaturityLevel ;
               dcterms:identifier {Literal(id_)} ;
               owl:sameAs {uri}
        }
