# Scenario where every Done feature has evidence, so ev_ok is True: proves
# the b2:hasEvidence island (a wrong predicate turns ev_ok False here).
@prefix b2: <http://example.org/backlog#> .

b2:F1 a b2:Feature ;
    b2:hasState b2:Done ;
    b2:hasEvidence b2:Ev1 .

# falsy literal as evidence: `is not None` still holds on both sides
b2:F2 a b2:Feature ;
    b2:hasState b2:Done ;
    b2:hasEvidence "" .

# two evidence values: value() and .first() both pick one, never None
b2:F3 a b2:Feature ;
    b2:hasState b2:Done ;
    b2:hasEvidence b2:Ev3a, b2:Ev3b .

b2:F4 a b2:Feature ;
    b2:hasState b2:InProgress .

# neighbour that must not match: b2:Done reached by another predicate
# (kills hasState widened to ?p: F5 would be Done and lacks evidence)
b2:F5 a b2:Feature ;
    b2:otherState b2:Done .

# a non-feature subject carrying evidence
b2:Release1 b2:hasEvidence b2:EvR .
