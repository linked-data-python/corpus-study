import ldpy
from rdflib import Graph, URIRef, Literal, BNode, RDF, RDFS, Namespace, SH
from collections import defaultdict
from rdflib.collection import Collection
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .


def combine_shapes_with_same_path(graph):
    @graph graph
    dctsource = <http://purl.org/dc/terms/source>
    dctsource_dict = defaultdict(list)

    # Collect dct:source info and remove
    for ps in m{ [] sh:property ?ps }:
        for o in m{ {ps} {dctsource} ?o }:
            dctsource_dict[ps].append(o)
            -{ {ps} {dctsource} {o} }
    for ps in m{ ?ps a sh:PropertyShape }:
        for o in m{ {ps} {dctsource} ?o }:
            dctsource_dict[ps].append(o)
            -{ {ps} {dctsource} {o} }

    # Find NodeShapes
    for ns in m{ ?ns a sh:NodeShape }:
        path_dict = defaultdict(list)

        # Group property shapes by path
        for ps in m{ {ns} sh:property ?ps }:
            path = m{ {ps} sh:path ?path }.first()
            if path:
                path_dict[path].append(ps)
            -{ {ps} sh:path {ldpy.ANY if path is None else path} }
            -{ {ns} sh:property {ps} }

        # Add refined property shapes
        for path, shapes in path_dict.items():
            if len(shapes) == 1:
                +{
                    {ns} sh:property {shapes[0]} .
                    {shapes[0]} sh:path {path}
                }
                for src in dctsource_dict[shapes[0]]:
                    +{ {shapes[0]} {dctsource} {src} }
                continue

            # graph.remove((ps, sh:path, path))

            # Merge sh:in values
            in_values = set()
            nodeKinds = set()
            dataTypes = set()
            classes = set()
            for ps in shapes:
                for o in m{ {ps} sh:in ?o }:
                    for val in graph.items(o):
                        in_values.add(val)
                    collection = Collection(graph, o)
                    for item in collection:
                        pass  # Just to initialize the collection
                    collection.clear()
                    -{ {ps} sh:in {o} }
                for o in m{ {ps} sh:nodeKind ?o }:
                    nodeKinds.add(o)
                    -{ {ps} sh:nodeKind {o} }
                for o in m{ {ps} sh:datatype ?o }:
                    dataTypes.add(o)
                    -{ {ps} sh:datatype {o} }
                for o in m{ {ps} sh:class ?o }:
                    classes.add(o)
                    -{ {ps} sh:class {o} }

            # Create new merged shape
            merged_ps = BNode()
            # graph.add((merged_ps, rdf:type, sh:PropertyShape))
            +{ {merged_ps} sh:path {path} }

            if in_values:
                in_list = BNode()
                +{ {merged_ps} sh:in {in_list} }
                in_bnode = in_list
                for val in list(in_values)[:-1]:
                    +{ {in_bnode} rdf:first {val} }
                    next_b = BNode()
                    +{ {in_bnode} rdf:rest {next_b} }
                    in_bnode = next_b
                +{
                    {in_bnode} rdf:first {list(in_values)[-1]} ;
                       rdf:rest rdf:nil
                }

            # Merge nodeKind, datatype, class using sh:or if needed
            or_shapes = []

            def add_or_shape(predicate, values):
                if not values:
                    return
                if len(values) == 1:
                    +{ {merged_ps} {predicate} {next(iter(values))} }
                else:
                    for v in values:
                        b = BNode()
                        +{ {b} {predicate} {v} }
                        or_shapes.append(b)

            add_or_shape(sh:nodeKind, nodeKinds)
            add_or_shape(sh:datatype, dataTypes)
            add_or_shape(sh:class, classes)

            if or_shapes:
                or_bnode = BNode()
                +{ {merged_ps} sh:or {or_bnode} }
                current = or_bnode
                for s in or_shapes[:-1]:
                    +{ {current} rdf:first {s} }
                    next_b = BNode()
                    +{ {current} rdf:rest {next_b} }
                    current = next_b
                +{
                    {current} rdf:first {or_shapes[-1]} ;
                       rdf:rest rdf:nil
                }

            +{ {ns} sh:property {merged_ps} }

            for ps in shapes:
                for src in dctsource_dict[ps]:
                    +{ {merged_ps} {dctsource} {src} }

    return graph
