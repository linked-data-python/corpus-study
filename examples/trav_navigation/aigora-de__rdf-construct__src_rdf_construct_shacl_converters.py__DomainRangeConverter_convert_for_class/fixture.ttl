# Input graph for aigora-de__rdf-construct__src_rdf_construct_shacl_converters.py__DomainRangeConverter_convert_for_class — written during translation.
# It must cover: several solutions of the pattern the region reads, the
# zero-solution case, and neighbouring triples that must NOT match.
@prefix ex: <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Solution 1: a datatype property with domain ex:Person, range xsd:string,
# a label and a comment — every optional field present.
ex:name rdfs:domain ex:Person ;
    rdfs:range xsd:string ;
    rdfs:label "name" ;
    rdfs:comment "The person's name" .

# Solution 2: an object property with domain ex:Person, range a class
# (not a datatype), no label, no comment — the independently-optional
# fields must each be absent on their own, not lost together.
ex:knows rdfs:domain ex:Person ;
    rdfs:range ex:Person ;
    rdfs:seeAlso ex:Friendship .

# Solution 3: domain ex:Person, only a label configured, range absent
# entirely (zero-solution case for the range lookup on this property).
ex:nickname rdfs:domain ex:Person ;
    rdfs:label "nickname" .

# Neighbouring data that must NOT match: a property whose domain is a
# different class.
ex:title rdfs:domain ex:Book ;
    rdfs:range xsd:string ;
    rdfs:label "title" .

# A blank-node subject with the right domain: filtered out by the
# isinstance(prop, URIRef) guard, not by the pattern itself.
_:bn rdfs:domain ex:Person ;
    rdfs:range xsd:string .

# --- Repair (2026-10-30) ----------------------------------------------------
# Solution 4: empty label and comment: `if label:` / `if comment:` are false
# on "", so name and description stay None; `is not None` would set "".
ex:empty rdfs:domain ex:Person ;
    rdfs:label "" ;
    rdfs:comment "" .

# Solution 5: a range declared rdfs:Datatype outside the XSD namespace (the
# second arm of _is_datatype), and several labels: `.first()` must take the
# value `value()` takes.
ex:status rdfs:domain ex:Person ;
    rdfs:range ex:StatusCode ;
    rdfs:label "status", "state" .
ex:StatusCode a rdfs:Datatype .

# Neighbours for the "bound term widened to a variable" mutants:
# ex:related shares the object ex:Person with the domain motif under another
# predicate, so `?prop ?p {cls}` would pick it up.
ex:related rdfs:seeAlso ex:Person ;
    rdfs:label "related" .
# ex:knows carries an rdfs:seeAlso and no label nor comment: a label or
# comment read widened to `{prop} ?p ?x` would find it.

# ex:Place (the driver's last call) has no property at all: zero solutions,
# the region returns [].
