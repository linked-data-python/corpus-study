from rdflib import Graph
from rdflib.namespace import RDF, RDFS, OWL, SKOS, DCTERMS, XSD
from semtech_context import EC
@prefix sem: <http://example.org/semtech#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

