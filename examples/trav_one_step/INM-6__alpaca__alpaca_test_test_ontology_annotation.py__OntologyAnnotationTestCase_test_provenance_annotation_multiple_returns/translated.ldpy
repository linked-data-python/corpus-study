import io
from rdflib import Literal, URIRef, Namespace, Graph, RDF, PROV
from alpaca import activate, deactivate, Provenance, save_provenance
from alpaca.ontology import ALPACA
from alpaca_context import InputObject, process_multiple  # context shim -- see meta.json
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .


def test_provenance_annotation_multiple_returns(self):
    activate(clear=True)
    input_object = InputObject()
    name, output_object = process_multiple(input_object, 45)
    deactivate()

    prov_data = save_provenance()

    # Read PROV information as RDF
    prov_graph = Graph()
    with io.StringIO(prov_data) as data_stream:
        prov_graph.parse(data_stream, format='turtle')

    @graph prov_graph

    # Check that the annotations exist (1 per class is expected. None
    # are expected for the classes of `process`)
    self.assertEqual(
        m{ ?s rdf:type {self.ONTOLOGY.Parameter} }.count(), 1)
    self.assertEqual(
        m{ ?s rdf:type {self.ONTOLOGY.ProcessFunctionMultiple} }.count(), 1)
    self.assertEqual(
        m{ ?s rdf:type {self.ONTOLOGY.ProcessedDataMultiple} }.count(), 1)
    self.assertEqual(
        m{ ?s rdf:type {self.ONTOLOGY.InputObject} }.count(), 1)
    self.assertEqual(
        m{ ?s rdf:type {self.ONTOLOGY.OutputObject} }.count(), 1)
    self.assertEqual(
        m{ ?s rdf:type {self.ONTOLOGY.ProcessFunction} }.count(), 0)
    self.assertEqual(
        m{ ?s rdf:type {self.ONTOLOGY.ProcessedData} }.count(), 0)

    # FunctionExecution is ProcessFunctionMultiple
    execution_uri = m{ ?s rdf:type {ALPACA.FunctionExecution} }.first()
    self.assertTrue(bool(m{ {execution_uri} rdf:type
                     {self.ONTOLOGY.ProcessFunctionMultiple} }))

    # Check parameter name
    parameter_node = m{ ?s rdf:type {self.ONTOLOGY.Parameter} }.first()
    self.assertTrue(bool(m{ {parameter_node}
                     {ALPACA.pairName} "param_1" }))
    self.assertTrue(bool(m{ {parameter_node}
                     {ALPACA.pairValue} 45 }))

    # Check returned value
    output_node = m{ ?s rdf:type {self.ONTOLOGY.ProcessedDataMultiple} }.first()
    self.assertTrue(bool(m{ {output_node}
                     prov:wasGeneratedBy {execution_uri} }))
    self.assertTrue(bool(m{ {output_node}
                     rdf:type {ALPACA.DataObjectEntity} }))
    self.assertTrue(bool(m{ {output_node}
                     rdf:type {self.ONTOLOGY.OutputObject} }))

    # Check attributes of returned value
    expected_attributes = {
        'name': "SpikeTrain#2",
        'channel': 34,
    }
    for attribute in m{ {output_node} {ALPACA.hasAttribute} ?a }:
        name = m{ {attribute} {ALPACA.pairName} ?v }.first().toPython()
        value = m{ {attribute} {ALPACA.pairValue} ?v }.first().toPython()
        self.assertEqual(value, expected_attributes[name])

        # Check if attribute annotation is present for `name`
        if name == 'name':
            self.assertTrue(bool(m{ {attribute} rdf:type
                             {self.ONTOLOGY.Attribute} }))

    # Check input value
    input_node = m{ ?s rdf:type {self.ONTOLOGY.InputObject} }.first()
    self.assertTrue(bool(m{ {execution_uri}
                     prov:used {input_node} }))
    self.assertTrue(bool(m{ {input_node}
                     rdf:type {ALPACA.DataObjectEntity} }))
    self.assertTrue(bool(m{ {output_node}
                     prov:wasDerivedFrom {input_node} }))


# Test harness only (see meta.json): the region is a unittest.TestCase
# method that only ever asserts and returns None, and it needs `self` (for
# both self.ONTOLOGY and the assert* methods) which the extracted method no
# longer has -- driver.py supplies a minimal real unittest.TestCase
# instance. `demo` turns a failed assertion into a comparable value instead
# of letting it abort the driver, same convention as the trav_existence /
# trav_one_step siblings in this stratum that translate a bare `test_*`.
def demo(self) -> object:
    try:
        test_provenance_annotation_multiple_returns(self)
        return "ok"
    except AssertionError as e:
        return ("assertion-failed", str(e))
