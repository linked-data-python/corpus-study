def findNode(self, node):
    @graph self.initial_graph
    for o in m{ {node} sh:node ?o }:
        self.adjusted_shape.append(o)
        for target in (sh:targetClass, sh:targetNode, sh:targetObjectsOf, sh:targetSubjectsOf):
            -{ {o} {target} ?x }
        self.findNode(o)
