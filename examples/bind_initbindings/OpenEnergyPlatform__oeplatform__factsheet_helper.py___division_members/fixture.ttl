# Input graph for OpenEnergyPlatform__oeplatform__factsheet_helper.py___division_members
# -- written during translation. Covers, for a call with division=ex:division1:
#   - one solution per UNION branch of SECTOR_MEMBERS_QUERY (three solutions);
#   - a sector equal to the division itself, excluded by FILTER (?sector != ?division);
#   - a blank-node sector, matching the pattern but excluded by the Python-side
#     `isinstance(row[0], URIRef)` filter;
#   - neighbouring triples, of each branch's shape, that must NOT match
#     (wrong division, wrong predicate, wrong onProperty);
#   - distinct rdfs:label values so the label-sort has an unambiguous order.
# A call with division=ex:divisionZero (never a ?division in any triple
# below) is the zero-solution case.
@prefix ex: <http://example.org/> .
@prefix oeo: <https://openenergyplatform.org/ontology/oeo/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# Branch 1: direct membership via oeo:OEO_00000504.
ex:transport oeo:OEO_00000504 ex:division1 ;
    rdfs:label "Transport" .

# Branch 2: rdf:type an owl:Restriction with someValuesFrom division1.
ex:energy rdf:type ex:restrictionA ;
    rdfs:label "Energy" .
ex:restrictionA a owl:Restriction ;
    owl:onProperty oeo:OEO_00000504 ;
    owl:someValuesFrom ex:division1 .

# Branch 3: rdfs:subClassOf a Restriction with someValuesFrom division1.
ex:agriculture rdfs:subClassOf ex:restrictionB ;
    rdfs:label "Agriculture" .
ex:restrictionB a owl:Restriction ;
    owl:onProperty oeo:OEO_00000504 ;
    owl:someValuesFrom ex:division1 .

# sector == division: must be excluded by FILTER (?sector != ?division).
ex:division1 oeo:OEO_00000504 ex:division1 .

# a blank-node sector: matches the graph pattern but must be excluded by
# `isinstance(row[0], URIRef)` in Python.
[] oeo:OEO_00000504 ex:division1 .

# neighbourhood: same predicate, but a DIFFERENT division -> must not match
# a call for division1.
ex:other_sector oeo:OEO_00000504 ex:division2 ;
    rdfs:label "Other" .

# neighbourhood: right shape, wrong predicate -> must not match branch 1.
ex:wrong_predicate_sector ex:unrelatedProp ex:division1 ;
    rdfs:label "WrongPredicate" .

# neighbourhood: a Restriction, but on a DIFFERENT property -> must not
# match branch 2 (or 3).
ex:wrong_prop_sector rdf:type ex:restrictionC ;
    rdfs:label "WrongProp" .
ex:restrictionC a owl:Restriction ;
    owl:onProperty ex:someOtherProperty ;
    owl:someValuesFrom ex:division1 .

# --- added by the repair (see meta.json "repair") ---------------------------
# Neighbours that share the other terms of branch 3 (rdfs:subClassOf a
# restriction) and must NOT match it, one per bound term:
#   - right type, right someValuesFrom, WRONG owl:onProperty (restrictionC,
#     above, now also reached through rdfs:subClassOf);
#   - right onProperty, right someValuesFrom, but the restriction node is NOT
#     typed owl:Restriction (notRestriction), reached by BOTH rdf:type (branch
#     2's shape) and rdfs:subClassOf (branch 3's shape);
#   - right type and onProperty, WRONG filler: someValuesFrom division2
#     (restrictionD) and owl:allValuesFrom division1 (restrictionE), reached
#     by both shapes.
ex:wrong_prop_sector_sub rdfs:subClassOf ex:restrictionC ;
    rdfs:label "WrongPropSub" .

ex:notRestriction a ex:SomethingElse ;
    owl:onProperty oeo:OEO_00000504 ;
    owl:someValuesFrom ex:division1 .
ex:typed_by_non_restriction rdf:type ex:notRestriction ;
    rdfs:label "TypedByNonRestriction" .
ex:sub_of_non_restriction rdfs:subClassOf ex:notRestriction ;
    rdfs:label "SubOfNonRestriction" .

# Division2 has members of its own, through every branch: a call for division2
# returns them and none of division1's.
ex:restrictionD a owl:Restriction ;
    owl:onProperty oeo:OEO_00000504 ;
    owl:someValuesFrom ex:division2 .
ex:typed_division2 rdf:type ex:restrictionD ;
    rdfs:label "TypedDivision2" .
ex:sub_division2 rdfs:subClassOf ex:restrictionD ;
    rdfs:label "SubDivision2" .

ex:restrictionE a owl:Restriction ;
    owl:onProperty oeo:OEO_00000504 ;
    owl:allValuesFrom ex:division1 .
ex:typed_all_values rdf:type ex:restrictionE ;
    rdfs:label "TypedAllValues" .
ex:sub_all_values rdfs:subClassOf ex:restrictionE ;
    rdfs:label "SubAllValues" .

# Sort key: a member of division1 with a LOWERCASE label ("biomass" sorts
# before "Energy" only if the key lower-cases) and a member with no label (the
# key falls back to its IRI, which sorts between "energy" and "transport").
ex:biomass oeo:OEO_00000504 ex:division1 ;
    rdfs:label "biomass" .
ex:unlabelled oeo:OEO_00000504 ex:division1 .
