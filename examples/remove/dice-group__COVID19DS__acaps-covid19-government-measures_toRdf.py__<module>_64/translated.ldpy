import urllib.parse
import urllib
import re
from context_shim import pd, xls   # context shim -- see meta.json
@prefix cvdo: <https://covid-19ds.data.dice-research.org/ontology/> .   #(for Object)
@prefix cvdr: <https://covid-19ds.data.dice-research.org/resource/> .   #(for Subject/Resource)
@prefix dbpediaowl: <http://dbpedia.org/ontology/> .
@prefix dcmi: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dowl: <http://dbpedia.org/ontology/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@graph as g
csv_data = pd.read_excel(xls, 'Dataset')
csv_data = csv_data.fillna("unknown")

for index, row in csv_data.iterrows():
     dice = str(row['ID'])+'_GovMeasure'
     print(dice)
     iso = row["ISO"]
     +{ cvdr:{dice} cvdo:hasISO3 cvdr:{iso} .
        cvdr:{iso} a cvdo:Iso ;
            dowl:isoCodeRegion {row["ISO"]}^^xsd:string }
     # +{ cvdr:{str(row["ID"])} cvdo:hasISO {row["ISO"]}^^xsd:string }

     +{ cvdr:{dice} a cvdo:Covid19Measure }
     #+{ cvdr:ISO a lgdo:Feature }

     +{ cvdr:{dice} cvdo:hasCountry cvdr:{row["COUNTRY"]} }

     +{ cvdr:{str(row["COUNTRY"])} rdfs:label {row["COUNTRY"]}@en ;
            a dbpediaowl:Country }

     +{ cvdr:{dice} cvdo:hasRegion {row["REGION"]}^^xsd:string }

     +{ cvdr:{dice} cvdo:hasAdminLevelName {row['ADMIN_LEVEL_NAME']}^^xsd:string }

     +{ cvdr:{dice} cvdo:hasPCODE {row['PCODE']}^^xsd:integer }

     +{ cvdr:{dice} cvdo:hasLogType {row['LOG_TYPE']}^^xsd:string }

     +{ cvdr:{dice} dbpediaowl:category {row['CATEGORY']}^^xsd:string }

     +{ cvdr:{dice} cvdo:hasMeasure {row['MEASURE']}^^xsd:string }

     +{ cvdr:{dice} cvdo:targetedPopGroup {row['TARGETED_POP_GROUP']}^^xsd:string ;
            rdfs:comment {row['COMMENTS']}^^xsd:string ;
            cvdo:nonCompliance {row['NON_COMPLIANCE']}^^xsd:string ;
            dcmi:date {row['DATE_IMPLEMENTED']}^^xsd:date }

     +{ cvdr:{dice} cvdo:hasSource {row['SOURCE']}@en ;
            cvdo:publisher {row['SOURCE_TYPE']}^^xsd:string }

     row['LINK'] = row['LINK'].strip()
     if " " in row['LINK']:
          row['LINK']=urllib.parse.quote_plus(row['LINK'])

     +{ cvdr:{dice} cvdo:hasSourceLink f<{row['LINK']}> ;
            cvdo:entryDate {row['ENTRY_DATE']}^^xsd:date }

     # row['Alternative source']=urllib.parse.quote_plus(row['Alternative source'])
     altSources = None

     altSources = re.split(';| \+| AND| and', row['Alternative source'])


     if altSources:
          for a in altSources:
               # if a != 'and' and a != 'AND' and a != '':
               +{ cvdr:{dice} cvdo:alternativeSource f<{a.strip().replace(" ", "")}> }
     else:
          if "http" in row['Alternative source']:
               +{ cvdr:{dice} cvdo:alternativeSource f<{row['Alternative source'].strip()}> }
          else:
               +{ cvdr:{dice} cvdo:alternativeSource {row['Alternative source']}^^xsd:string }

     # the provenance
     +{ cvdr:{dice} prov:hadPrimarySource cvdr:GovMeasuresCovidDataset .
        cvdr:GovMeasuresCovidDataset a prov:Entity ;
            prov:generatedAtTime "2021-02-22T02:52:02Z"^^xsd:dateTime ;
            prov:wasDerivedFrom "https://data.humdata.org/dataset/acaps-covid19-government-measures-dataset"^^xsd:string }


     # Remove the triples that I marked as "unknown"
     -{ ?s ?p <unknown> }
     -{ ?s ?p "unknown"^^xsd:string }
     -{ ?s ?p "unknown"^^xsd:integer }
     -{ ?s ?p "unknown"^^xsd:date }
