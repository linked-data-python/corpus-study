from rdflib import RDF, XSD, BNode, Literal, URIRef, Variable
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


def Builtin_DAY(e, ctx):
    d = date(e.arg)
    return Literal(d.day)
