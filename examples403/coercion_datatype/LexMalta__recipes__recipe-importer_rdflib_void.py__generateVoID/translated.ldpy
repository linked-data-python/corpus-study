from rdflib import Graph, Literal, URIRef
from rdflib.namespace import RDF, VOID
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix void: <http://rdfs.org/ns/void#> .


for i, c in enumerate(classes):
    part = URIRef(dataset + "_class%d" % i)
    res += g{
        {dataset} void:classPartition {part} .
        {part} a void:Dataset ;
           void:triples {Literal(classCount[c])} ;
           void:classes 1 ;
           void:class {c} ;
           void:entities {Literal(len(classes[c]))} ;
           void:distinctSubjects {Literal(len(classes[c]))}
    }

    if distinctForPartitions:
        res += g{
            {part} void:properties {Literal(len(classProps[c]))} ;
               void:distinctObjects {Literal(len(classObjects[c]))}
        }
