# --- demo harness (not part of the extracted region; added IDENTICALLY to
# original.py and translated.ldpy so the driver has an observable) ----------
# The region only *declares* the quantity_definitions data structure; Brick's
# generate_brick.py is what walks it into triples.  This walk is a stripped
# down define_concept_hierarchy: it materialises every term of the structure
# so the driver compares all of them.
DEMO_GRAPH = Graph()


def _demo_emit(definitions, graph, parent=None):
    for name, defn in definitions.items():
        concept = BRICK[name]
        if parent is not None:
            graph.add((concept, SKOS.broader, parent))
        for prop, value in defn.items():
            if isinstance(value, dict):
                _demo_emit(value, graph, concept)
            elif isinstance(value, list):
                for item in value:
                    graph.add((concept, prop, item))
            else:
                graph.add((concept, prop, value))


_demo_emit(quantity_definitions, DEMO_GRAPH)
print(len(DEMO_GRAPH), len(set(DEMO_GRAPH.subjects())), len(set(DEMO_GRAPH.predicates())))
