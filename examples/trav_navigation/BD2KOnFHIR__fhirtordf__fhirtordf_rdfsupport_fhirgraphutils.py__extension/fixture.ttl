# Input graph for BD2KOnFHIR__fhirtordf__fhirtordf_rdfsupport_fhirgraphutils.py__extension
@prefix ex: <http://example.org/> .
@prefix fhir: <http://hl7.org/fhir/> .

# The node whose extensions are read.
ex:patient1 fhir:Element.extension ex:extA, ex:extB, ex:extC .

# extA: url does not match ext_pred -- neighbouring extension that must NOT
# match, even though it also carries an Extension.value* predicate.
ex:extA fhir:Extension.url "http://example.org/ext/other" ;
    fhir:Extension.valueString "wrong extension" .

# extB: url matches ext_pred, but its predicate_objects has no
# 'Extension.value*' predicate at all -- must be skipped (falls through
# without returning), proving the inner join term is not decorative.
ex:extB fhir:Extension.url "http://example.org/ext/target" ;
    fhir:Extension.id "b-only-id" .

# extC: url matches ext_pred AND carries the Extension.value* predicate --
# this is the single expected solution of the fused join.
ex:extC fhir:Extension.url "http://example.org/ext/target" ;
    fhir:Extension.valueString "the answer" .

# Zero-solution neighbour: a different patient with no extensions at all.
ex:patient2 fhir:Element.extension ex:extD .
ex:extD fhir:Extension.url "http://example.org/ext/target" ;
    fhir:Extension.id "d-only-id" .

# Repair of 2026-10-31 -- the shape the repository really reads.  In FHIR
# RDF (tests/data/patient-example.ttl:83-94, the graph of the repository's
# own test of `extension`, test_fhirgraphutils.py:34-45) the node is a
# BLANK node (the object of fhir:Patient.birthDate), each extension is a
# blank node with an fhir:index, and both Extension.url and
# Extension.value* are blank nodes carrying fhir:value: the shim's `value`
# then resolves through fhir:value, and `asLiteral` decides between the
# Python value and the Literal.  A second extension with another url is the
# neighbour.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:patient3 fhir:Patient.birthDate [
    fhir:Element.extension [
        fhir:index "1"^^xsd:integer ;
        fhir:Extension.url [ fhir:value "http://example.org/ext/other" ] ;
        fhir:Extension.valueString [ fhir:value "neighbour" ]
    ] , [
        fhir:index "0"^^xsd:integer ;
        fhir:Extension.url [
            fhir:value "http://hl7.org/fhir/StructureDefinition/patient-birthTime"
        ] ;
        fhir:Extension.valueDateTime [
            fhir:value "1974-12-25T14:35:45-05:00"^^xsd:dateTime
        ]
    ] ;
    fhir:value "1974-12-25"^^xsd:date
] .

# Two values on the predicate the region reads through `value()`: an
# extension with two Extension.url -- `value` raises UniquenessError, and the
# translation must raise the same, at the same extension.
ex:patient4 fhir:Element.extension ex:extE .
ex:extE fhir:Extension.url "http://example.org/ext/target" ,
        "http://example.org/ext/target2" ;
    fhir:Extension.valueString "ambiguous" .

# Zero values on it: an Extension.value* but no Extension.url at all.
ex:patient5 fhir:Element.extension ex:extF .
ex:extF fhir:Extension.valueString "no url" .
