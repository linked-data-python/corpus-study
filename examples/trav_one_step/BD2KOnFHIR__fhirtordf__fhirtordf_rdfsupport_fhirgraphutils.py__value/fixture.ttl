# Input graph for BD2KOnFHIR__fhirtordf__fhirtordf_rdfsupport_fhirgraphutils.py__value
# Covers the two `for o in m{ {s} p ?o }`-shaped reads the region performs:
#   1. values = list(set(g.objects(subject, predicate)))
#   2. g.value(v, FHIR.value) for each BNode value found by (1)
@prefix ex: <http://example.org/> .
@prefix fhir: <http://hl7.org/fhir/> .

# Case A: subject/predicate with a single plain-literal object (not a BNode
# branch): exercises the "else" branch, values[0].toPython().
ex:patient1 ex:name "Alice" .

# neighbouring triples that must NOT match (different subject, different
# predicate): they would corrupt the single-value else-branch if the read
# were too broad.
ex:patient1 ex:otherProp "should-not-match" .
ex:patient2 ex:name "Bob" .

# Case B: subject/predicate whose only object is a BNode carrying
# fhir:value -- exercises the BNode branch, vv[0].
ex:patient3 ex:code _:code1 .
_:code1 fhir:value "loinc-123" .

# neighbouring BNode that must NOT match (attached to a different subject).
ex:patient4 ex:code _:code2 .
_:code2 fhir:value "should-not-match" .

# Case C: subject/predicate with no triple at all -- the zero-solution case
# (list(set(m{...})) is empty, function returns None). ex:patient5 has no
# ex:code / ex:name triples at all, so no fixture line is needed for it --
# the query subject/predicate pair used by the driver simply won't appear.
