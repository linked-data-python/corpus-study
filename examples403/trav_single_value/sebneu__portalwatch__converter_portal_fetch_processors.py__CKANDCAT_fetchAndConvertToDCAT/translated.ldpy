import rdflib
from rdflib import URIRef
from rdflib.namespace import RDF
from context_shim import no_ssl_verification
import logging
logger = logging.getLogger(__name__)
from context_shim import namespaces, DCAT, convert_socrata, graph_from_opendatasoft, \
    graph_from_data_gouv_fr, CKANConverter
import quality

def fetchAndConvertToDCAT(self, graph, portal_ref, portal_api, snapshot, activity, format="ttl"):

    @graph graph
    logger.debug('Fetching CKAN portal via RDF endpoint: ' + portal_api)

    with no_ssl_verification():
        graph.parse(portal_api, format=format)
        cur = m{ ?s a {namespaces['hydra'].PagedCollection} }.first()
        next_page = m{ {cur} {namespaces['hydra'].nextPage} ?v }.first()
        page = 0
        while next_page:
            page += 1
            if page % 10 == 0:
                logger.debug('Processed pages:' + str(page))

            p = str(next_page)
            g = rdflib.Graph()
            g.parse(p, format=format)
            next_page = m{ {URIRef(next_page)} {namespaces['hydra'].nextPage} ?v }(g).first()
            graph.parse(p, format=format)

        logger.debug('Total pages:' + str(page))
        logger.info('Fetching finished')

        for d in m{ ?d a {DCAT.Dataset} }:
            quality.add_quality_measures(d, graph, activity)
