from rdflib import DCAT, DCTERMS, OWL, PROV, RDF, XSD, Graph, URIRef, BNode, Literal
from ..pyrdf import AORC
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


def create_graph_triples(meta: CompletedCompositeMetadata, merged_graph: Graph, node_namer: NodeNamer):
    # Create composite dataset
    composite_dataset_uri = URIRef(meta.composite_s3_directory)
    merged_graph += g{ {composite_dataset_uri} a {AORC.CompositeDataset} }

    # Add composite dataset properties
    composite_dataset_period_of_time_node = BNode(node_namer.name_ds_period(meta))
    merged_graph += g{
        {composite_dataset_period_of_time_node} a dcterms:PeriodOfTime .
        {composite_dataset_uri} dcterms:temporal {composite_dataset_period_of_time_node}
    }
    start_time = Literal(meta.start_time, datatype=xsd:dateTime)
    end_time = Literal(meta.end_time, datatype=xsd:dateTime)
    merged_graph += g{
        {composite_dataset_period_of_time_node} dcat:startDate {start_time} ;
           dcat:endDate {end_time}
    }

    # Create distribution
    composite_distribution_uri = URIRef(meta.public_uri)
    merged_graph += g{ {composite_distribution_uri} a {AORC.CompositeDistribution} }
    netcdf_format = <https://publications.europa.eu/resource/authority/file-type/NETCDF>
    merged_graph += g{ {composite_distribution_uri} dcat:packageFormat {netcdf_format} }
    last_modified = Literal(meta.composite_last_modified, datatype=xsd:dateTime)
    merged_graph += g{ {composite_dataset_uri} dcterms:created {last_modified} }
    access_description = Literal(
        "Access is restricted based on users credentials for AWS bucket holding data", datatype=xsd:string
    )
    merged_graph += g{ {composite_distribution_uri} owl:Annotation {access_description} }

    # Create docker image
    docker_image_uri = URIRef(meta.docker_image_url)
    merged_graph += g{ {docker_image_uri} a {AORC.DockerImage} }

    # Create composite job
    composite_job_node = BNode(node_namer.name_composite_job(meta))
    merged_graph += g{ {composite_job_node} a {AORC.CompositeJob} }

    # Create script
    composite_script_node = BNode(meta.composite_script)
    merged_graph += g{
        {composite_script_node} a {AORC.CompositeScript} ;
           dcterms:identifier {Literal(meta.composite_script)} .
        {composite_dataset_uri} {AORC.wasCompositedBy} {composite_job_node} .
        {composite_job_node} prov:wasStartedBy {composite_script_node} .
        {composite_script_node} {AORC.hasDockerImage} {docker_image_uri}
    }

    # Associate members of composite with composite dataset and composite job
    for member_dataset in meta.get_member_datasets():
        member_dataset_uri = URIRef(member_dataset)
        merged_graph += g{
            {composite_dataset_uri} {AORC.isCompositeOf} {member_dataset_uri} .
            {composite_job_node} prov:used {member_dataset_uri}
        }
