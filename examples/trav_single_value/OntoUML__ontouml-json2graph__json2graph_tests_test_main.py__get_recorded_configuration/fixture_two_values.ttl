# Added by the mutation audit of 2026-10-31: the two-solution case of both
# value() reads of get_recorded_configuration.  ex:artifact was generated by
# TWO activities (value() takes the first, `.one()` would raise); each uses
# one configuration entity carrying TWO prov:value literals (value() again
# takes the first).  Both are valid JSON, so the original returns a dict.
@prefix ex: <http://example.org/> .
@prefix prov: <http://www.w3.org/ns/prov#> .

ex:artifact prov:wasGeneratedBy ex:t1, ex:t2 .
ex:t1 prov:used ex:c1 .
ex:t2 prov:used ex:c2 .
ex:c1 prov:value "{\"run\": 1}", "{\"run\": 2}" .
ex:c2 prov:value "{\"run\": 3}", "{\"run\": 4}" .
