from rdflib import Graph, Namespace, Literal, URIRef
from semantic_objects.namespaces import S223, QUDT, UNIT, bind_prefixes

def create_sample_graph():
    """Create a sample RDF graph with spaces and windows for testing."""
    g = Graph()
    bind_prefixes(g)

    # Define a namespace for our test data
    EX = Namespace("http://example.org/building#")
    g.bind("ex", EX)

    # Create a Space with an Area property
    space1 = EX["Space1"]
    g += g{ {space1} <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> {S223["Space"]} }

    # Create Area property for the space
    area1 = EX["Space1_Area"]
    g += g{
        {area1} <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> {S223["QuantifiableObservableProperty"]} ;
           {QUDT["hasQuantityKind"]} <http://qudt.org/vocab/quantitykind/Area> ;
           {S223["hasValue"]} 100.0 ;
           {QUDT["hasUnit"]} {UNIT["FT2"]} .
        {space1} {S223["hasProperty"]} {area1}
    }

    # Create another Space
    space2 = EX["Space2"]
    g += g{ {space2} <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> {S223["Space"]} }

    area2 = EX["Space2_Area"]
    g += g{
        {area2} <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> {S223["QuantifiableObservableProperty"]} ;
           {QUDT["hasQuantityKind"]} <http://qudt.org/vocab/quantitykind/Area> ;
           {S223["hasValue"]} 150.0 ;
           {QUDT["hasUnit"]} {UNIT["M2"]} .
        {space2} {S223["hasProperty"]} {area2}
    }

    # Create a Window with multiple properties
    window1 = EX["Window1"]
    g += g{ {window1} <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> {S223["Window"]} }

    # Window area
    window_area = EX["Window1_Area"]
    g += g{
        {window_area} <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> {S223["QuantifiableObservableProperty"]} ;
           {QUDT["hasQuantityKind"]} <http://qudt.org/vocab/quantitykind/Area> ;
           {S223["hasValue"]} 10.0 ;
           {QUDT["hasUnit"]} {UNIT["FT2"]} .
        {window1} {S223["hasProperty"]} {window_area}
    }

    # Window azimuth
    window_azimuth = EX["Window1_Azimuth"]
    g += g{
        {window_azimuth} <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> {S223["QuantifiableObservableProperty"]} ;
           {QUDT["hasQuantityKind"]} <http://qudt.org/vocab/quantitykind/Azimuth> ;
           {S223["hasValue"]} 180.0 ;
           {QUDT["hasUnit"]} {UNIT["DEG"]} .
        {window1} {S223["hasProperty"]} {window_azimuth}
    }

    # Window tilt
    window_tilt = EX["Window1_Tilt"]
    g += g{
        {window_tilt} <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> {S223["QuantifiableObservableProperty"]} ;
           {QUDT["hasQuantityKind"]} <http://qudt.org/vocab/quantitykind/Tilt> ;
           {S223["hasValue"]} 90.0 ;
           {QUDT["hasUnit"]} {UNIT["DEG"]} .
        {window1} {S223["hasProperty"]} {window_tilt}
    }

    return g
