@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

def getNarrower(g, v, r):
    @graph g
    if v is None:
        qres = s{ SELECT ?s WHERE { ?s skos:broader {(r)} . } }
    else:
        qres = s{ SELECT ?s WHERE { ?s skos:inScheme {v} . ?s skos:broader {(r)} . } }
    return [row[0] for row in qres]
