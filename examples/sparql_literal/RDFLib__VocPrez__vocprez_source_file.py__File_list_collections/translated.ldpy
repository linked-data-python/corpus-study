@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

def list_collections(self):
    q = s{
        SELECT *
        WHERE {
          ?c a skos:Concept .
          ?c rdfs:label ?l .
        }
    }
    return [(x["c"], x["l"]) for x in q(self.gr)]
