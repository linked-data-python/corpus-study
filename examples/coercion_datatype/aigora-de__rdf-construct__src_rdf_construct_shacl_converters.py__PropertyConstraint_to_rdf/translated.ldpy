from rdflib import BNode, Graph, Literal, Namespace, RDF, RDFS, URIRef, XSD
from context_shim import _create_rdf_list  # context shim, see meta.json
@prefix sh: <http://www.w3.org/ns/shacl#> .

def to_rdf(self, shapes_graph: Graph) -> BNode:
    """Convert constraint to RDF representation.

    Creates a blank node with sh:property predicates.

    Args:
        shapes_graph: Graph to add triples to.

    Returns:
        Blank node representing the property shape.
    """
    @graph shapes_graph
    prop_shape = BNode()

    +{ {prop_shape} sh:path {self.path} }

    if self.node_class:
        +{ {prop_shape} sh:class {self.node_class} }

    if self.datatype:
        +{ {prop_shape} sh:datatype {self.datatype} }

    if self.min_count is not None:
        +{ {prop_shape} sh:minCount {self.min_count} }

    if self.max_count is not None:
        +{ {prop_shape} sh:maxCount {self.max_count} }

    if self.node_kind:
        +{ {prop_shape} sh:nodeKind {self.node_kind} }

    if self.name:
        +{ {prop_shape} sh:name {self.name} }

    if self.description:
        +{ {prop_shape} sh:description {self.description} }

    if self.in_values:
        # Create an RDF list for sh:in
        in_list = _create_rdf_list(shapes_graph, self.in_values)
        +{ {prop_shape} sh:in {in_list} }

    if self.pattern:
        +{ {prop_shape} sh:pattern {self.pattern} }

    if self.min_inclusive is not None:
        +{ {prop_shape} sh:minInclusive {self.min_inclusive} }

    if self.max_inclusive is not None:
        +{ {prop_shape} sh:maxInclusive {self.max_inclusive} }

    if self.order is not None:
        +{ {prop_shape} sh:order {self.order} }

    return prop_shape
