from rdflib import (
    BNode,
    Literal,
    Namespace,
    RDF,
    RDFS,
    URIRef,
    Variable
)

def _set_identifier(self, i):
    assert i
    @graph self.graph
    if i != self.__identifier:
        oldStmtsOut = list(m{ {self.__identifier} ?p ?o })
        oldStmtsIn = list(m{ ?s ?p {self.__identifier} })
        -{ {self.__identifier} ?p ?o }
        -{ ?s ?p {self.__identifier} }
        self.__identifier = i
        for p1, o1 in oldStmtsOut:
            +{ {i} {p1} {o1} }
        for s1, p1 in oldStmtsIn:
            +{ {s1} {p1} {i} }
    if not isinstance(i, BNode):
        try:
            prefix, uri, localName = self.graph.compute_qname(i)
            self.qname = u':'.join([prefix, localName])
        except:
            pass
