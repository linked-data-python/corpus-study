# Input graph for alganet__apysource__apysource_verification.py___cite_sites
@prefix ex: <http://example.org/> .
@prefix sv: <https://alganet.github.io/apysource/vocab.ttl#> .

# ex:doc1 has THREE citing sites -- several solutions of the sv:citedBy join:
ex:doc1 sv:citedBy ex:site_a, ex:site_b, ex:site_c .

# site_a: complete record (file + line).
ex:site_a sv:citingFile "src/a.py" ;
          sv:citingLine 10 ;
          sv:unrelatedProp "noise -- must not affect the result" .

# site_b: file only -- line stays None (CiteSite.line is optional).
ex:site_b sv:citingFile "src/b.py" .

# site_c: no sv:citingFile at all -- `file is None` must skip it entirely,
# even though it IS a citedBy node and DOES have a citingLine.
ex:site_c sv:citingLine 42 .

# Neighbourhood that must NOT match: a different cited resource with its own
# citing site -- proves the join is anchored on the given urn, not global.
ex:doc_other sv:citedBy ex:site_other .
ex:site_other sv:citingFile "other.py" ;
              sv:citingLine 1 .

# ex:doc_no_sites is a valid subject with no sv:citedBy at all: the
# zero-solution case for a urn that IS in the graph but has nothing citing it.
ex:doc_no_sites a ex:SomeType .

# Added by the 2026-10-31 mutation audit. ex:doc_falsy is cited from blank
# nodes, as the repository mints its cite sites (yaml_input.py `_anon`), and
# carries the falsy values a truthiness test would drop: `line: 0` is accepted
# by yaml_input.py (an int, not None) and becomes Literal(0); a parsed Turtle
# source can hold an empty sv:citingFile "". The third site has TWO
# sv:citingLine values and the fourth TWO sv:citingFile values: g.value() keeps
# only one, so a join that absorbed either read would yield two CiteSites.
ex:doc_falsy sv:citedBy
    [ sv:citingFile "" ; sv:citingLine 0 ] ,
    [ sv:citingFile "src/zero.py" ; sv:citingLine 0 ] ,
    [ sv:citingFile "src/two.py" ; sv:citingLine 7 , 5 ] ,
    [ sv:citingFile "src/dup_a.py" , "src/dup_b.py" ; sv:citingLine 3 ] .
