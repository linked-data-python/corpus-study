# Input graph for ksahlmann__myno__myno-agriculture_virtual-device_aggregatPreload.py__get_event_functions — written during translation.
# It must cover: several solutions of the pattern the region reads, the
# zero-solution case, and neighbouring triples that must NOT match.
@prefix ex: <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix base: <http://yang-netconf-mqtt#> .
@prefix onem2m: <http://www.onem2m.org/ontology/Base_Ontology/base_ontology#> .

# Solution 1: a full device -> functionality -> service -> data point -> topic chain.
ex:device1 onem2m:hasFunctionality ex:func1 .
ex:func1 rdf:type base:EventFunctionality .
ex:serv1 onem2m:exposesFunctionality ex:func1 .
ex:serv1 onem2m:hasOutputDataPoint ex:dp1 .
ex:dp1 base:mqttTopic "topic/1" .

# Solution 2: a second, independent chain.
ex:device2 onem2m:hasFunctionality ex:func2 .
ex:func2 rdf:type base:EventFunctionality .
ex:serv2 onem2m:exposesFunctionality ex:func2 .
ex:serv2 onem2m:hasOutputDataPoint ex:dp2 .
ex:dp2 base:mqttTopic "topic/2" .

# Neighbour that must NOT match: same shape, but the functionality is not
# typed base:EventFunctionality.
ex:device3 onem2m:hasFunctionality ex:func3 .
ex:func3 rdf:type base:OtherFunctionality .
ex:serv3 onem2m:exposesFunctionality ex:func3 .
ex:serv3 onem2m:hasOutputDataPoint ex:dp3 .
ex:dp3 base:mqttTopic "topic/3" .

# Neighbour that must NOT match: an EventFunctionality with no service
# exposing it, so the join dead-ends (zero solutions for this arm).
ex:device4 onem2m:hasFunctionality ex:func4 .
ex:func4 rdf:type base:EventFunctionality .

# --- Added by the repair of 2026-10-30 (triage: weak-oracle) ---------------

# Duplicate row: a second device carries the same functionality, so the
# query (no DISTINCT) yields (func1, "topic/1") TWICE.  A DISTINCT added to
# the translation drops one copy and the multiset comparison sees it.
ex:device1b onem2m:hasFunctionality ex:func1 .

# Neighbour that must NOT match: a typed EventFunctionality exposed by a
# service with a data point and a topic, but no device has it.  Removing the
# ?device onem2m:hasFunctionality ?eventfunc pattern would let it through.
ex:func5 rdf:type base:EventFunctionality .
ex:serv5 onem2m:exposesFunctionality ex:func5 .
ex:serv5 onem2m:hasOutputDataPoint ex:dp5 .
ex:dp5 base:mqttTopic "topic/5" .

# Neighbour that must NOT match: a data point of a matching chain also has
# another predicate; widening base:mqttTopic to a variable would add a row.
ex:dp2 base:otherTopic "not-a-topic" .

# Neighbour that must NOT match: a matching service with a data point that
# has no mqttTopic at all (the last pattern dead-ends).
ex:device6 onem2m:hasFunctionality ex:func6 .
ex:func6 rdf:type base:EventFunctionality .
ex:serv6 onem2m:exposesFunctionality ex:func6 .
ex:serv6 onem2m:hasOutputDataPoint ex:dp6 .

# Neighbour that must NOT match: the service is linked to the data point by
# another predicate than hasOutputDataPoint.
ex:device7 onem2m:hasFunctionality ex:func7 .
ex:func7 rdf:type base:EventFunctionality .
ex:serv7 onem2m:exposesFunctionality ex:func7 .
ex:serv7 onem2m:hasInputDataPoint ex:dp7 .
ex:dp7 base:mqttTopic "topic/7" .
