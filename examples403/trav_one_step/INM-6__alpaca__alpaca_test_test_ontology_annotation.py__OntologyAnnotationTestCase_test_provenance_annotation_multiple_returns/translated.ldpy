import io
from rdflib import Literal, URIRef, Namespace, Graph, RDF, PROV
from alpaca import activate, deactivate, Provenance, save_provenance
from alpaca.ontology import ALPACA
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .


def test_provenance_annotation_multiple_returns(self):
    activate(clear=True)
    input_object = InputObject()
    name, output_object = process_multiple(input_object, 45)
    deactivate()

    prov_data = save_provenance()

    # Read PROV information as RDF
    prov_graph = Graph()
    with io.StringIO(prov_data) as data_stream:
        prov_graph.parse(data_stream, format='turtle')

    @graph prov_graph

    # Check that the annotations exist (1 per class is expected. None
    # are expected for the classes of `process`)
    self.assertEqual(
        len(list(m{ ?s rdf:type {self.ONTOLOGY.Parameter} })), 1)
    self.assertEqual(
        len(list(m{ ?s rdf:type {self.ONTOLOGY.ProcessFunctionMultiple} })), 1)
    self.assertEqual(
        len(list(m{ ?s rdf:type {self.ONTOLOGY.ProcessedDataMultiple} })), 1)
    self.assertEqual(
        len(list(m{ ?s rdf:type {self.ONTOLOGY.InputObject} })), 1)
    self.assertEqual(
        len(list(m{ ?s rdf:type {self.ONTOLOGY.OutputObject} })), 1)
    self.assertEqual(
        len(list(m{ ?s rdf:type {self.ONTOLOGY.ProcessFunction} })), 0)
    self.assertEqual(
        len(list(m{ ?s rdf:type {self.ONTOLOGY.ProcessedData} })), 0)

    # FunctionExecution is ProcessFunctionMultiple
    execution_uri = list(
        m{ ?s rdf:type {ALPACA.FunctionExecution} })[0]
    self.assertTrue(bool(m{ {execution_uri} rdf:type
                     {self.ONTOLOGY.ProcessFunctionMultiple} }))

    # Check parameter name
    parameter_node = list(
        m{ ?s rdf:type {self.ONTOLOGY.Parameter} })[0]
    self.assertTrue(bool(m{ {parameter_node}
                     {ALPACA.pairName} "param_1" }))
    self.assertTrue(bool(m{ {parameter_node}
                     {ALPACA.pairValue} 45 }))

    # Check returned value
    output_node = list(
        m{ ?s rdf:type {self.ONTOLOGY.ProcessedDataMultiple} })[0]
    self.assertTrue(bool(m{ {output_node}
                     prov:wasGeneratedBy {execution_uri} }))
    self.assertTrue(bool(m{ {output_node}
                     rdf:type {ALPACA.DataObjectEntity} }))
    self.assertTrue(bool(m{ {output_node}
                     rdf:type {self.ONTOLOGY.OutputObject} }))

    # Check attributes of returned value
    expected_attributes = {
        'name': "SpikeTrain#2",
        'channel': 34,
    }
    for attribute in m{ {output_node} {ALPACA.hasAttribute} ?a }:
        name = m{ {attribute} {ALPACA.pairName} ?v }.first().toPython()
        value = m{ {attribute} {ALPACA.pairValue} ?v }.first().toPython()
        self.assertEqual(value, expected_attributes[name])

        # Check if attribute annotation is present for `name`
        if name == 'name':
            self.assertTrue(bool(m{ {attribute} rdf:type
                             {self.ONTOLOGY.Attribute} }))

    # Check input value
    input_node = list(
        m{ ?s rdf:type {self.ONTOLOGY.InputObject} })[0]
    self.assertTrue(bool(m{ {execution_uri}
                     prov:used {input_node} }))
    self.assertTrue(bool(m{ {input_node}
                     rdf:type {ALPACA.DataObjectEntity} }))
    self.assertTrue(bool(m{ {output_node}
                     prov:wasDerivedFrom {input_node} }))
