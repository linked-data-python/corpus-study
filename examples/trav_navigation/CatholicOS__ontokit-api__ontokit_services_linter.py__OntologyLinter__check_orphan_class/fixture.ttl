# Input graph for CatholicOS__ontokit-api__ontokit_services_linter.py__OntologyLinter__check_orphan_class
@prefix ex: <http://example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Several solutions: two plain orphans -- typed owl:Class, no meaningful
# parent, no child.
ex:OrphanA a owl:Class ;
    rdfs:label "Orphan A" .
ex:OrphanB a owl:Class .

# A third orphan whose only "parent" is owl:Thing -- must still count: the
# region excludes owl:Thing from the parents list explicitly.
ex:OrphanThingOnly a owl:Class ;
    rdfs:subClassOf owl:Thing .

# owl:Thing itself: typed owl:Class here (as real ontologies often assert),
# so it would otherwise pass the parent/child test -- must NOT match, since
# the region skips it by identity before even looking at parents/children.
owl:Thing a owl:Class .

# Neighbourhood that must NOT match:
# has a real parent -- not an orphan.
ex:HasParent a owl:Class ;
    rdfs:subClassOf ex:Base .
# ex:Base has a child (ex:HasParent) -- not an orphan either, despite having
# no parent of its own.
ex:Base a owl:Class .

# typed owl:Class but as a blank node: excluded by the isinstance(URIRef)
# guard on the class candidate itself (a check `m{ }` has no term-kind filter
# for, so it stays a plain Python guard -- see meta.json).
_:bc a owl:Class .

# not typed owl:Class at all -- never even a candidate.
ex:NotAClass a ex:SomeOtherType .

# --- Neighbourhood added by the repair (2026-10-30), one triple per mutant
# that the fixture above left green (see triage.json and meta.json repair).

# Another predicate than rdfs:subClassOf pointing AT an orphan: ex:OrphanB
# must stay an orphan. Kills the children island widened to `?s ?r {class_uri}`.
ex:Rel ex:seeAlso ex:OrphanB .

# A class whose only parent is a blank node (an OWL restriction, the usual
# case in real ontologies): the `isinstance(p, URIRef)` guard drops it, so
# ex:BnParented IS an orphan. Kills the removal of that guard.
ex:BnParented a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ; owl:onProperty ex:p ] .

# Children that are NOT typed owl:Class (a URIRef and a blank node): any
# subject of rdfs:subClassOf counts as a child, so ex:Lonely and ex:LonelyB
# are NOT orphans. Kills a children island restricted to typed classes.
ex:Lonely a owl:Class .
ex:Kid rdfs:subClassOf ex:Lonely .
ex:LonelyB a owl:Class .
_:kidb rdfs:subClassOf ex:LonelyB .

# owl:Class as the object of another predicate than rdf:type: ex:Meta is not
# a candidate. Kills the candidate island widened to `?class_uri ?r owl:Class`.
ex:Meta ex:relatedTo owl:Class .
