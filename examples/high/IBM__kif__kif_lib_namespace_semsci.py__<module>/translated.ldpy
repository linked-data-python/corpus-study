class SIO:
    """The SEMSCI's SIO namespace."""
    has_attribute = semsci:SIO_000008
    has_value = semsci:SIO_000300
    is_attribute_of = semsci:SIO_000011

# --- demo harness, added identically to both representations (see meta.json).
# The module only declares namespace classes, so the demo makes the resulting
# name -> IRI table observable to the comparison harness.
demo_terms = {name: str(value)
              for cls in (CHEMINF, SIO)
              for name, value in vars(cls).items()
              if isinstance(value, URIRef)}
print(len(demo_terms))
for name in sorted(demo_terms):
    print(name, demo_terms[name])
