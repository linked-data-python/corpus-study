from rdflib import Namespace, Literal
@prefix nswl: <http://www.weblyzard.com/2005/03/31/wl#> .
@prefix nsrdfs: <http://www.w3.org/2000/01/rdf-schema#> .


@staticmethod
def _addOntologyStatement( ontology, s, p, o ):
    """ adds the given statement to the ontology using the
        wl-syntax 
    """
    # ignore statements with empty s, p, or o.
    if not p or not s or not o:
        return

    # returns the resource's identifier
    rid = lambda r: NS_WL[ XCL2RDF._getIdentifier(r)] 

    # define labels
    ontology += g{
        {rid(s)} nsrdfs:label {Literal(s)} .
        {rid(o)} nsrdfs:label {Literal(o)} .
        {rid(p)} nsrdfs:label {Literal(p)} .
        {rid(s)} {rid(p)} {rid(o)}
    }
