from rdflib.namespace import DC, DCTERMS, DOAP, FOAF, SKOS, OWL, RDF, RDFS, VOID, XMLNS, XSD
from rdflib import Graph, URIRef, Literal, Namespace # here is some error
from  validate import containsNumber , returnValue, check_type, remove_alphaNumeric, is_date, clean_sentences ,wikidata_id_toText
@prefix prop: <https://reld.dice-research.org/schema/> .
@prefix res: <https://reld.dice-research.org/resource/> .
@prefix dataseturi: <https://reld.dice-research.org/> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xmlns: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

output = {}
subject_dict = {}
object_dict = {}
g = Graph()

for i, (rel,info) in enumerate(output.items()):
    #rel = rel[0]
    print(rel)
    ID = rel_data.loc[rel_data['RE-SemEval-Relation'] == rel, 'Srid'].iloc[0]
    print(ID)
    relation = res+"R-"+str(ID)
    g += g{ {URIRef(datasetURI+dsName)} {URIRef(prop+"hasRelation")} {URIRef(relation)} }
    if rel in list_Others:
        rel == 'RE-SemEval-Relation_Other'
        g += g{ {URIRef(res+""+rel)} rdfs:label "Other" }

    else:
        relation_text = rel#rel_data.loc[rel_data['WikidataIds'] == rel, 'RE-WikiRE-Relation'].iloc[0] 

        g += g{ {URIRef(relation)} rdfs:label {Literal(relation_text)} }

    for index, val in enumerate(info): # Code for Sentence and relevant info

        g += g{ {URIRef(relation)} {URIRef(prop+'distribution')} {Literal(val[4],datatype=XSD.string)} }

        for ind, v in enumerate(val[2]):
            sent_id = res+"S_"+dsName+"_"+ str(sent_counter) # will go to all code
            sent_counter = sent_counter + 1
            g += g{
                {URIRef(relation)} {URIRef(prop+'hasSentence')} {URIRef(sent_id)} .
                {URIRef(sent_id)} {URIRef(prop+'hasText')} {Literal(v[0],lang='en')}
            }
            for key , value in v[1].items(): # code for named entities
                if key == "listOfNamedEntities":
                    for nam_e in value:
                        ne_id = res+'ne_s' + str(ne_counter)
                        #ne_id = res+ str(nam_e[0]).strip().replace(' ','_')+str(ne_counter)
                        ne_counter = ne_counter + 1
                        g += g{
                            {URIRef(sent_id)} {URIRef(prop+'hasNamedEntity')} {URIRef(ne_id)} .
                            {URIRef(ne_id)} a {URIRef(dbo+remove_alphaNumeric(nam_e[1]))} ;
                               rdfs:label {Literal(nam_e[0],lang='en')}
                        }
                else:
                    g += g{ {URIRef(sent_id)} {URIRef(prop+key)} {Literal(value,datatype=XSD.integer)} }
        ################ Subject Object Code ##################
        g += g{ {URIRef(sent_id)} {URIRef(prop+'numOfRelation')} {Literal(val[3],datatype=XSD.integer)} }
        subject_string = returnValue(subject_dict,val[0])
        sub_id = res+'sub_'+dsName+str(val[0])
        g += g{ {URIRef(sent_id)} {URIRef(prop+'hasSubject')} {URIRef(sub_id)} }
        if containsNumber(str(subject_string)):
            g += g{ {URIRef(sub_id)} rdfs:label {Literal(subject_string,datatype=XSD.string)} }


        elif check_type(str(subject_string)):
            g += g{ {URIRef(sub_id)} rdfs:label {Literal(subject_string,datatype=XSD.string)} }

        else:
            g += g{ {URIRef(sub_id)} rdfs:label {Literal(remove_alphaNumeric(subject_string),datatype=XSD.string)} }
        object_string = returnValue(object_dict,val[1])#remove_alphaNumeric(val[1])
        obj_id = res + 'obj_'+dsName+str(val[1])
        g += g{ {URIRef(sent_id)} {URIRef(prop+'hasObject')} {URIRef(obj_id)} }
        if containsNumber(str(object_string)):
            g += g{ {URIRef(obj_id)} rdfs:label {Literal(object_string,datatype=XSD.string)} }

        elif check_type(str(object_string)):
            g += g{ {URIRef(obj_id)} rdfs:label {Literal(object_string,datatype=XSD.string)} }
        else:
            g += g{ {URIRef(obj_id)} rdfs:label {Literal(remove_alphaNumeric(object_string),datatype=XSD.string)} }
