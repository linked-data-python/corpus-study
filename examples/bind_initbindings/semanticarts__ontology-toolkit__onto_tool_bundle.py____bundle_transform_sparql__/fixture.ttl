@prefix ex: <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# two solutions of the pattern the SPARQL UPDATE reads (?s rdfs:label "old")
ex:a rdfs:label "old" .
ex:b rdfs:label "old" .

# neighbouring triple that must NOT match (different label value)
ex:c rdfs:label "keep" .

# ex:d has no rdfs:label at all -- exercises the "no match" case within the
# same update (it is simply untouched)
ex:d ex:unrelated "value" .
