# Fixture for driver.py (see meta.json): a small VoID-described dataset that
# exercises every SPARQL query of the region (title, subject, description,
# vocabularies, classes, properties, labels, TLDs, endpoint, creator,
# licence, owl:sameAs links).  Written for this evaluation, not taken from
# the source repository.
@prefix void:    <http://rdfs.org/ns/void#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix foaf:    <http://xmlns.com/foaf/0.1/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix ex:      <http://example.org/vocab#> .
@prefix data:    <http://data.example.net/id/> .

data:dataset a void:Dataset ;
    dcterms:title "Example dataset"@en ;
    dcterms:description "A tiny dataset used to exercise the region."@en ;
    dcterms:creator <http://data.example.net/id/alice> ;
    dcterms:license <http://creativecommons.org/licenses/by/4.0/> ;
    dcterms:subject <http://example.org/topic/Geography> ;
    void:sparqlEndpoint <http://data.example.net/sparql> .

data:alice a foaf:Person ;
    foaf:name "Alice"@en ;
    rdfs:label "Alice Example"@en ;
    ex:worksAt data:acme ;
    owl:sameAs <http://dbpedia.org/resource/Alice> .

data:acme a ex:Organisation ;
    rdfs:label "ACME"@en ;
    skos:prefLabel "ACME Corporation"@en ;
    rdfs:comment "Fictional organisation."@en ;
    ex:homepage <http://acme.example.org/> ;
    owl:sameAs <http://www.wikidata.org/entity/Q123> .

data:place a ex:Place ;
    rdfs:label "Saint-Étienne"@fr ;
    ex:country <http://example.org/country/fr> .
