@prefix sstim: <https://w3id.org/sstim#> .
@prefix sstimv: <https://w3id.org/sstim/vocab#> .
@prefix sstimex: <https://w3id.org/sstim/exposure#> .

# alphaOscillation: two evidence assessments (meets its expected count of 2).
sstim:study1 sstim:evaluatesSubject sstimv:alphaOscillation .
sstim:study2 sstim:evaluatesSubject sstimv:alphaOscillation .

# betaOscillation: one dated knowledge-status assertion (meets its expected
# count of 1).
sstimv:betaOscillation sstimex:hasKnowledgeStatusAssertion sstim:statusAssertion1 .

# deltaOscillation, thetaOscillation, smrOscillation, gammaOscillation:
# deliberately left with no recorded association at all, so both versions
# must report the same "association silently dropped" failures.
