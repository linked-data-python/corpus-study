**Task 04: Graph querying**
"""

from rdflib import Graph

# Context shim (see meta.json): the notebook parses "../rdf/example3.rdf",
# a file that is not shipped with the extracted region. Substituted here
# with the local fixture.ttl written for this region so the region can
# execute; the query logic below is unmodified.
g = Graph()
g.parse("fixture.ttl", format="turtle")

"""Listamos todos los recursos que contienen la propiedad VCARD:FN"""

@prefix vcard: <http://www.w3.org/2001/vcard-rdf/3.0#> as VCARD .

q1 = s{
  SELECT
    ?Subject
  WHERE {
    ?Subject vcard:FN ?FullName.
  }
}

for r in q1(g):
  print(r)

"""Repetimos la anterior consulta, pero pidiendo ahora además los nombres completos de los sujetos"""

q2 = s{
  SELECT
    ?Subject ?FullName
  WHERE {
    ?Subject vcard:FN ?FullName.
  }
}

for r in q2(g):
  print(r)

"""Obtenemos todos los recursos que contienen "Smith" como nombre de familia"""

@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# initBindings stratum: q3 is a basic graph pattern, so m{ } (not s{ }); the
# bound term is written directly in the pattern. The projected ?x of the
# original never occurs in its WHERE clause (always unbound) and is never
# read, so it has no counterpart.
for r in m{ ?Subject vcard:Family "Smith"^^xsd:string }(g):
  print(r)

"""Obtenemos todos los elementos que contienen un email asociado"""

@prefix foaf: <http://xmlns.com/foaf/0.1/> .

q4 = s{
  SELECT
    ?Subject ?Email
  WHERE {
    ?Subject foaf:email ?Email.
  }
}

for q in q4(g):
  print(q.Subject, q.Email)

"""Consultamos todos los que conocen (FOAF:knows) a "Jane Smith" y obtenemos sus nombres de pila (VCARD:Given)"""

# q5 is a basic graph pattern too: m{ }. ?JaneSmith is only a join variable
# (never projected), so it is a blank node, which m{ } matches without
# projecting and without merging duplicate solutions.
for r in m{ ?Subject foaf:knows [ vcard:FN "Jane Smith"^^xsd:string ] ;
                                  vcard:Given ?Given }(g):
  print(r.Subject, VCARD.Given, r.Given)
