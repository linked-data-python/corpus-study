# Input graph for synaptixs__ontomesh__src_materializer.py__explain_triple.
# Covers: two derivations for the same reified statement (several
# solutions), a fully-formed premise and an incomplete one (missing
# object, must be skipped), a second reified statement for a DIFFERENT
# triple (neighbour that must not match), and a plain rdf:Statement with
# no prov:wasDerivedFrom at all (zero solutions for that path).
@prefix ex: <http://example.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix toolkit: <https://ontology.example.com/toolkit/materializer/> .

# The target triple ex:s1 ex:p1 ex:o1, explained by two derivations.
ex:stmt1 a rdf:Statement ;
    rdf:subject ex:s1 ;
    rdf:predicate ex:p1 ;
    rdf:object ex:o1 ;
    prov:wasDerivedFrom ex:deriv1, ex:deriv2 .

ex:deriv1 toolkit:rule "ruleA" ;
    toolkit:engine "engineA" ;
    toolkit:bindings "{\"x\": 1}" ;
    toolkit:premise ex:prem1, ex:prem2 .

ex:prem1 rdf:subject ex:s0 ; rdf:predicate ex:p0 ; rdf:object ex:o0 .
# ex:prem2 is missing rdf:object on purpose: it must be excluded from
# the "premises" list built by explain_triple.
ex:prem2 rdf:subject ex:s0b ; rdf:predicate ex:p0b .

ex:deriv2 toolkit:rule "ruleB" ;
    toolkit:engine "engineB" ;
    toolkit:bindings "{}" .

# Neighbouring statement for a DIFFERENT triple: must not match a query
# for (ex:s1, ex:p1, ex:o1).
ex:stmt2 a rdf:Statement ;
    rdf:subject ex:s2 ;
    rdf:predicate ex:p2 ;
    rdf:object ex:o2 ;
    prov:wasDerivedFrom ex:deriv3 .

ex:deriv3 toolkit:rule "ruleC" ;
    toolkit:engine "engineC" .

# A reified statement with no lineage at all: matches the (s, p, o)
# pattern but yields zero derivations.
ex:stmt3 a rdf:Statement ;
    rdf:subject ex:s3 ;
    rdf:predicate ex:p3 ;
    rdf:object ex:o3 .

# Near-miss statements: each differs from (ex:s1, ex:p1, ex:o1) in ONE term
# only, and carries a derivation, so a guard that is dropped or widened
# lets it through and the output changes.  Each also holds the missing
# term under ANOTHER predicate (rdfs:seeAlso), so a guard whose predicate
# is widened to a variable matches it too.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# same subject and predicate, other object (tests the rdf:object guard)
ex:stmtA a rdf:Statement ;
    rdf:subject ex:s1 ;
    rdf:predicate ex:p1 ;
    rdf:object ex:oX ;
    rdfs:seeAlso ex:o1 ;
    prov:wasDerivedFrom ex:derivA .
ex:derivA toolkit:rule "ruleNearObject" ; toolkit:engine "engineA" .

# same subject and object, other predicate (tests the rdf:predicate guard)
ex:stmtB a rdf:Statement ;
    rdf:subject ex:s1 ;
    rdf:predicate ex:pX ;
    rdf:object ex:o1 ;
    rdfs:seeAlso ex:p1 ;
    prov:wasDerivedFrom ex:derivB .
ex:derivB toolkit:rule "ruleNearPredicate" ; toolkit:engine "engineB" .

# same predicate and object, other subject (tests the rdf:subject guard)
ex:stmtC a rdf:Statement ;
    rdf:subject ex:sX ;
    rdf:predicate ex:p1 ;
    rdf:object ex:o1 ;
    rdfs:seeAlso ex:s1 ;
    prov:wasDerivedFrom ex:derivC .
ex:derivC toolkit:rule "ruleNearSubject" ; toolkit:engine "engineC" .

# Not typed rdf:Statement, yet reifies (s1, p1, o1) with a derivation: the
# outer rdf:type traversal must not pick it up.
ex:stmtUntyped rdf:subject ex:s1 ;
    rdf:predicate ex:p1 ;
    rdf:object ex:o1 ;
    prov:wasDerivedFrom ex:derivU .
ex:derivU toolkit:rule "ruleUntyped" .

# Derivation linked to stmt1 through another predicate: never a derivation.
ex:stmt1 prov:wasInfluencedBy ex:derivI .
ex:derivI toolkit:rule "ruleInfluence" .

# A second rule, engine and bindings on deriv1: next(g.objects(...), None)
# keeps the first in store order, so must .first().
ex:deriv1 toolkit:rule "ruleA2" ; toolkit:engine "engineA2" ;
    toolkit:bindings "{\"y\": 2}" .
