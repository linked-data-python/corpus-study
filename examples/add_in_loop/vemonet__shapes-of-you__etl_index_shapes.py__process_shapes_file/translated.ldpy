for shape in g.subjects(rdf:type, shex:ShapeAnd):
    shape_found = True
    shapes_graph += g{
        {file_uri} a schema:SoftwareSourceCode ;
           a shex:Schema ;
           rdfs:label {Literal(rdf_file_path.name)} ;
