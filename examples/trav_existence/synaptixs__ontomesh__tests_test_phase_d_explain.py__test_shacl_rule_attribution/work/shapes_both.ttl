# Two rules on t1: :MarkShape (processed first) derives (:t1, :mark) with an id
# that does not mention "Trigger", :TriggerShape derives (:t1, :flag). The
# statement to pick is the second whatever order the lineage file lists them.
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix : <https://test.example/phased#> .
:MarkShape
  a sh:NodeShape ;
  sh:targetClass :Trigger ;
  sh:rule [
    a sh:TripleRule ;
    sh:subject sh:this ;
    sh:predicate :mark ;
    sh:object true ;
  ] .
:TriggerShape
  a sh:NodeShape ;
  sh:targetClass :Trigger ;
  sh:rule [
    a sh:TripleRule ;
    sh:subject sh:this ;
    sh:predicate :flag ;
    sh:object true ;
  ] .
