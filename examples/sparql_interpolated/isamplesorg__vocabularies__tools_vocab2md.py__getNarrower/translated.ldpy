import rdflib.plugins.sparql  # what `import navocab` (vocab2md.py:10) brings in: navocab/__init__.py:11

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

def getNarrower(g, v, r):
    @graph g
    if v is None:
        qres = s{ SELECT ?s
        WHERE {
            ?s skos:broader {(r)} .
        }}
    else:
        qres = s{ SELECT ?s
        WHERE {
            ?s skos:inScheme {v} .
            ?s skos:broader {(r)} .
        }}
    res = []
    for row in qres:
        res.append(row[0])
    return res
