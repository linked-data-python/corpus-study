from rdflib import Graph, Namespace, RDF, RDFS, OWL, XSD, Literal
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .


def check_domain_violations(g: Graph):
    @graph g
    violations = []
    for prop in set(m{ ?s a rdf:Property }).union(m{ ?s a owl:ObjectProperty }):
        for s, o in m{ ?s {prop} ?o }:
            for domain in m{ {prop} rdfs:domain ?d }:
                if not m{ {s} a {domain} }:
                    violations.append((s, prop, "Expected domain", domain))
    return violations
