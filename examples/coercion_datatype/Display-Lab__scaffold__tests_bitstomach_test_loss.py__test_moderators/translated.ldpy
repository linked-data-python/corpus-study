@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
from rdflib import RDF, BNode, Graph, Literal
from src.bitstomach.signals import Loss
from src.utils.namespace import FHIR, PSDO, SLOWMO


def test_moderators():
    gap = -0.02
    prior_gap = 0.03
    slope = -0.1
    graph = Graph()
    @graph graph
    r = graph.resource(BNode())
    # add loss types
    +{ {r.identifier} a {PSDO.performance_gap_content} ;
                       a {PSDO.performance_trend_content} ;
                       a {PSDO.loss_content} }

    # add loss properites
    +{ {r.identifier} {SLOWMO.PerformanceGapSize} {gap} ;
                       {SLOWMO.PerformanceTrendSlope} {slope} ;
                       {SLOWMO.PriorPerformanceGapSize} {prior_gap} ;
                       {SLOWMO.StreakLength} {3} ;
                       {SLOWMO.RegardingMeasure} {BNode("PONV05")} }

    # Add the comparator
    c = graph.resource(BNode())
    +{ {c.identifier} a {PSDO.peer_90th_percentile_benchmark} ;
                       rdf:value {95.0} }
    +{ {r.identifier} {SLOWMO.RegardingComparator} {c.identifier} }

    moderators = Loss.moderators([r])

    moderator = [
        moderator
        for moderator in moderators
        if moderator["comparator_type"] == PSDO.peer_90th_percentile_benchmark
    ][0]

    assert moderator["comparison_size"] == abs(gap)
    assert moderator["trend_size"] == abs(slope) * 2
    assert moderator["prior_comparison_size"] == abs(prior_gap)
