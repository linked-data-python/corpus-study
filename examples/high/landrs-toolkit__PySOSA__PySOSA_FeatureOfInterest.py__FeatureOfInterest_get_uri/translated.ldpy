from rdflib import Graph, BNode, Literal, RDF, RDFS
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

obsgraph = Graph()

def get_uri(self):
    """
    get uri of a feature of interest
    """
    return self.feature_of_interest_id
    # `obsgraph += g{...}` is an augmented assignment, so unlike the
    # original's `obsgraph.add(...)` it needs `obsgraph` declared global.
    global obsgraph
    obsgraph += g{
        {self.feature_of_interest_id} a {sosa.FeatureOfInterest} ;
            rdfs:comment {self.comment} ;
            rdfs:label {self.label}
    }
