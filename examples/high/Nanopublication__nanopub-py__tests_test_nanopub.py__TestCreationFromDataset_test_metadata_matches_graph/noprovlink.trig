# Data fixture (see meta.json): invalid/plain/noprovlink.trig from the
# Nanopublication test suite (github.com/Nanopublication/nanopub-testsuite,
# MIT, (c) 2022 Tobias Kuhn) -- the entry the real NanopubTestSuite index
# returns for get_by_nanopub_uri("http://example.org/nanopub-validator-example/").
# Copied verbatim apart from this header; read identically by both sides.
@prefix : <http://example.org/nanopub-validator-example/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dc: <http://purl.org/dc/terms/> .
@prefix pav: <http://purl.org/pav/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix ex: <http://example.org/> .

:Head {
	: np:hasAssertion :assertion ;
		np:hasProvenance :provenance ;
		np:hasPublicationInfo :pubinfo ;
		a np:Nanopublication .
}

:assertion {
	ex:mosquito ex:transmits ex:malaria .
}

:provenance {
	:assertionFoo prov:hadPrimarySource <http://dx.doi.org/10.3233/ISU-2010-0613> .
}

:pubinfo {
	: dc:created "2014-07-24T18:05:11+01:00"^^xsd:dateTime ;
		pav:createdBy <http://orcid.org/0000-0002-1267-0234> ;
		a npx:ExampleNanopub .
}
