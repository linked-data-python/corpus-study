# region: EnumeratedClass.serialize (lines 1424-1434, band medium)
# licence of the source repository: see meta.json
#
# Nothing in this region is written in island notation, on purpose: every
# term it asserts is computed at run time (the predicate is self._operator,
# i.e. owl:oneOf reached through the instance, and the copy loop republishes
# triples read from another graph), and the owl:oneOf list is grown one
# member at a time, which the `( … )` collection syntax cannot express.
# Islands would only add `{ }` around names.
from rdflib import (
    BNode,
    Literal,
    Namespace,
    RDF,
    RDFS,
    URIRef,
    Variable
)
from rdflib.collection import Collection
from infixowl_context import CastClass

def serialize(self, graph):
    clonedList = Collection(graph, BNode())
    for cl in self._rdfList:
        clonedList.append(cl)
        CastClass(cl, self.graph).serialize(graph)

    graph.add((self.identifier, self._operator, clonedList.uri))
    for s, p, o in self.graph.triples((self.identifier, None, None)):
        if p != self._operator:
            graph.add((s, p, o))
    self._serialize(graph)
