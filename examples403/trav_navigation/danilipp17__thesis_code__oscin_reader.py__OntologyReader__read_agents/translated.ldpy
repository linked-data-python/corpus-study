for rp_uri in self.g.objects(
    agent_uri, agentoscin:employsReasoningPattern
):
    for rp_type in self.g.objects(rp_uri, rdf:type):
        name = _rp_type_map.get(str(rp_type))
        if name:
            reasoning_pattern = name
            break
    if reasoning_pattern:
        break
