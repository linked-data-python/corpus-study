from rdflib import collection, BNode, Literal, RDF
from kindynsyn.namespaces import GEOM_ENT, GEOM_REL, GEOM_COORD, RBDYN_ENT, \
    RBDYN_COORD, RBDYN_OP, QUDT_SCHEMA, QUDT_QKIND, QUDT_UNIT
from kindynsyn.namespaces import geom_coord:, rbdyn_coord:, rbdyn_op:, qudt_schema:, qudt_unit:
from kindynsyn.rdflib_tools.helpers import uuid_ref
def inertial_wrench(self, rigid_body_inertia, velocity_twist, wrench):
    @graph self.g
    assert m{ {rigid_body_inertia} rbdyn_coord:as-seen-by ?v }.first() == m{ {velocity_twist} geom_coord:as-seen-by ?v }.first()
    assert m{ {rigid_body_inertia} rbdyn_coord:as-seen-by ?v }.first() == m{ {wrench} rbdyn_coord:as-seen-by ?v }.first()
    assert self.g.value(rigid_body_inertia, RBDYN_COORD["of-inertia"] / RBDYN_ENT["about"]) == self.g.value(velocity_twist, GEOM_COORD["of-velocity"] / GEOM_REL["reference-point"])
    assert self.g.value(rigid_body_inertia, RBDYN_COORD["of-inertia"] / RBDYN_ENT["about"]) == self.g.value(wrench, RBDYN_COORD["of-wrench"] / RBDYN_ENT["reference-point"])
    assert self.g.value(rigid_body_inertia, RBDYN_COORD["of-inertia"] / RBDYN_ENT["of-body"]) == self.g.value(velocity_twist, GEOM_COORD["of-velocity"] / GEOM_REL["of"])
    assert self.g.value(rigid_body_inertia, RBDYN_COORD["of-inertia"] / RBDYN_ENT["of-body"]) == self.g.value(wrench, RBDYN_COORD["of-wrench"] / RBDYN_ENT["acts-on"])
    assert bool(m{ {rigid_body_inertia} qudt_schema:unit qudt_unit:KiloGM })
    assert bool(m{ {rigid_body_inertia} qudt_schema:unit qudt_unit:M-KiloGM })
    assert bool(m{ {rigid_body_inertia} qudt_schema:unit qudt_unit:KiloGM-M2 })
    assert bool(m{ {velocity_twist} qudt_schema:unit qudt_unit:RAD-PER-SEC })
    assert bool(m{ {velocity_twist} qudt_schema:unit qudt_unit:M-PER-SEC })
    assert bool(m{ {wrench} qudt_schema:unit qudt_unit:N-M })
    assert bool(m{ {wrench} qudt_schema:unit qudt_unit:N })
    id_ = uuid_ref()
    +{ {id_} a rbdyn_op:InertialWrench ;
           rbdyn_op:rigid-body-inertia {rigid_body_inertia} ;
           rbdyn_op:velocity-twist {velocity_twist} ;
           rbdyn_op:wrench {wrench} }
    return id_
