# Stands in for the schema.ttl the script reads (generated by the neXtProt
# build, not in the repository).  Written against the region, in the shape the
# sibling script retrieve-schema-labels-comments.py queries: owl:Class /
# owl:ObjectProperty declarations carrying rdfs:label and rdfs:comment.
#
# It covers, for the three goo files copied verbatim from the repository:
#   * entities to hide (status Private):  :AntibodyIntegrationLevel, :EVocCv,
#     :antibodiesAcc, :Integrated — each appears BOTH as a subject and as an
#     object, the two wildcard removals of the region;
#   * entities to change:  :Annotation, :DevelopmentalStageInfo,
#     :absorptionMax, :Colocalizes_with;
#   * the zero case:  :UniprotHistory is in the goo file and NOT here, so the
#     count query returns 0 and the script prints "### Unknown uri";
#   * neighbourhood that must survive:  :antibodiesAcc used as a PREDICATE
#     (the region only removes it in subject and object position), and classes
#     that no goo file mentions.
@prefix :     <http://nextprot.org/rdf#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

<http://nextprot.org/rdf> a owl:Ontology ;
    rdfs:label "neXtProt schema" .

:Annotation a owl:Class ;
    rdfs:label "Annotation type" ;
    rdfs:comment "Most generic annotation class" .

:DevelopmentalStageInfo a owl:Class ;
    rdfs:subClassOf :Annotation ;
    rdfs:label "Developmental stage" ;
    rdfs:comment "Expression of the gene product according to the cell stage and/or tissue or organism development" .

:AntibodyIntegrationLevel a owl:Class ;
    rdfs:label "Antibody integration level" ;
    rdfs:comment "Antibody integration level" .

:Cv a owl:Class ;
    rdfs:label "controlled vocabulary term" .

:EVocCv a owl:Class ;
    rdfs:subClassOf :Cv ;
    rdfs:label "eVOC term" .

:Isoform a owl:Class ;
    rdfs:label "isoform" .

:absorptionMax a owl:ObjectProperty ;
    rdfs:label "absorption max" ;
    rdfs:comment "Links an isoform to an annotation" ;
    rdfs:domain :Isoform ;
    rdfs:range :Annotation .

:antibodiesAcc a owl:DatatypeProperty ;
    rdfs:label "antibodies acc" ;
    rdfs:domain :Antibody ;
    rdfs:range xsd:string .

:Antibody a owl:Class ;
    rdfs:label "antibody" ;
    :antibodiesAcc "HPA000001" ;
    :integrationLevel :AntibodyIntegrationLevel .

:GoQualifier a owl:Class ;
    rdfs:label "GO qualifier" .

:Colocalizes_with a owl:NamedIndividual, :GoQualifier ;
    rdfs:label "Colocalizes with" .

:EvidenceIntegrationLevel a owl:Class ;
    rdfs:label "evidence integration level" .

:Integrated a owl:NamedIndividual, :EvidenceIntegrationLevel ;
    rdfs:label "Integrated" ;
    rdfs:comment "Integrated" .

:Evidence a owl:Class ;
    rdfs:label "evidence" ;
    :integrationLevel :Integrated .

:ExpressionInfo a owl:Class ;
    rdfs:subClassOf :Annotation ;
    rdfs:label "expression information" ;
    rdfs:comment "no goo file mentions this one" .
