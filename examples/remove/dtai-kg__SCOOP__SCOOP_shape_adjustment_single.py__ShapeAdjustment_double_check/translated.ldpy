def double_check(self):
    @graph self.adjusted_graph
    double_check_list = [sh:datatype, sh:in, sh:languageIn, sh:minCount, sh:maxCount, sh:minLength, sh:maxLength, sh:maxExclusive, sh:minExclusive, sh:maxInclusive, sh:minInclusive, sh:pattern, sh:uniqueLang]
    for identifier in self.adjusted_identifier:
        if "NodeShape" in identifier:
            for p, o in m{ {identifier} ?p ?o }:
                if p in double_check_list:
                    -{ {identifier} {p} {o} }
