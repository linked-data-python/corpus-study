from infixowl_context import classOrIdentifier

@prefix owl: <http://www.w3.org/2002/07/owl#> .

def _set_equivalentClass(self, other):
    if not other:
        return
    for sc in other:
        self.graph += g{ {self.identifier}
                       owl:equivalentClass {classOrIdentifier(sc)} }
