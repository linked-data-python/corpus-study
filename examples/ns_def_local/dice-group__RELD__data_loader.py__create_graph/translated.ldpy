from rdflib import Graph, URIRef, Literal, Namespace # here is some error

def create_graph():
    g = Graph()
    @prefix reld: <http://reld.dice-research.org/schema/> .
    @prefix reldr: <http://reld.dice-research.org/resource/> .
    #datasetURI = Namespace("https://reld.dice-research.org/")
    @prefix dbo: <http://dbpedia.org/ontology/> .
    @prefix freebase: <http://rdf.freebase.com/ns> .
    @prefix ps: <http://www.wikidata.org/prop/statement/> .
    @prefix owl: <http://www.w3.org/2002/07/owl#> .
    @prefix dc: <http://purl.org/dc/elements/1.1/> .
    @prefix dcterms: <http://purl.org/dc/terms/> .
    @prefix nif: <http://persistence.uni-leipzig.org/nlp2rdf/ontologies/nif-core#> .
    @prefix prov: <http://www.w3.org/ns/prov#> .
    @prefix dbpedia: <http://dbpedia.org/property/> as dbpedia .
    @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

    # @graph adds the block's prefixes to g without overwriting a binding it
    # already has; the second bind of "dbo" (to the property namespace, which
    # rdflib files as dbo1) is a rebinding, so it stays a call.
    @graph g
    g.bind('dbo',dbpedia)


    return g
