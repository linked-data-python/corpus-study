# Extracted from Haigutus/triplets@7cf62970e8 : triplets/validation/shacl_ir.py
# region: _sparql_rows (lines 357-385, stratum trav_single_value)
# licence of the source repository: see meta.json
def _sparql_rows(graph, SH, shape_uri, meta):
    """sh:sparql constraints. params carries everything an engine needs to run
    the query without rdflib:

        {"select":   SELECT text ($this / $PATH placeholders kept),
         "prefixes": resolved "PREFIX ..." header lines (sh:prefixes → sh:declare),
         "path":     full IRI of the owning shape's sh:path, or None}

    The sparql node's own sh:message overrides the shape's.
    """
    @graph graph

    rows = []
    path = m{ {shape_uri} {SH.path} ?o }.first()
    for sparql in m{ {shape_uri} {SH.sparql} ?sparql }:
        select = m{ {sparql} {SH.select} ?o }.first()
        if select is None:
            continue
        # An island cannot appear inside an f-string interpolation hole (see
        # translation_notes): `m{ }.first()` is hoisted out of the f-string
        # into `prefix`/`namespace` below, and the nested genexp becomes an
        # equivalent nested for-loop -- same two graph.value reads, same
        # join, same order, per declaration.
        prefix_lines = []
        for ontology in m{ {sparql} {SH.prefixes} ?ontology }:
            for declaration in m{ {ontology} {SH.declare} ?declaration }:
                prefix = m{ {declaration} {SH.prefix} ?o }.first()
                namespace = m{ {declaration} {SH.namespace} ?o }.first()
                prefix_lines.append(f"PREFIX {prefix}: <{namespace}>\n")
        prefixes = "".join(prefix_lines)
        message = m{ {sparql} {SH.message} ?o }.first()
        row = {**meta, "component": "sh:sparql",
               "params": {"select": str(select), "prefixes": prefixes,
                          # $PATH substitution needs the full IRI; only direct paths qualify
                          "path": str(path) if type(path).__name__ == "URIRef" else None}}
        if message is not None:
            row["message"] = str(message)
        rows.append(row)
    return rows
