# Miniature stand-in for the lmss_graph.ttl the region's LMSSSearch loads.
# The upstream repository does not ship it (app/lmss/ is generated by
# run_parser.py); this file mirrors the class hierarchy of LMSS.owl.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix ex:   <http://example.org/ontology#> .

ex:ParentClass a owl:Class ;
    rdfs:label "Parent Class" .

ex:ChildClass a owl:Class ;
    rdfs:label "Child Class" ;
    rdfs:subClassOf ex:ParentClass .

ex:AnotherClass a owl:Class ;
    rdfs:label "Another Class" .
