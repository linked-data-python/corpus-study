@prefix srns: <http://example.org/semtech/research#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
from rdflib import Graph, Namespace, URIRef, Literal
from rdflib.namespace import RDF, RDFS, OWL, SKOS, DCTERMS, XSD, PROV
from context_predecl import BASEDIR, load
eo = load("enrichment_o", "v6_1_0")
g1 = Graph().parse(f"{BASEDIR}/01-research/semtech_research_v6_8_0.ttl")
RO_PUB = <http://example.org/rdodi/research-ontology#Publication>
corpus = srns:ResearchCorpus

@graph g1
for key, e in eo.EXT8.items():
    pub = srns:{f"Pub_{key.replace(chr(45), chr(95))}"}
    +{ {corpus} rdfs:member {pub} }
    +{ {pub} a {RO_PUB} ;
             a owl:NamedIndividual ;
             rdfs:label {e["cite"][:180]}@en ;
             dcterms:source {e["cite"]}@en ;
             skos:note {f"Verification level {e['level']}: {e['ev']}"}@en ;
             rdfs:seeAlso f<{e["url"]}> }
