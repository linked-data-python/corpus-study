import rdflib
from acro.ontology_handler import (
    PREFIX,
    is_uri,
    make_ischeckedby,
    make_ismitigatedby,
    make_save_analyses,
    make_save_risks,
    make_save_statbarns,
    populate_useful_dicts,
    print_nested_dict,
)

def _build_minimal_graph() -> rdflib.Graph:
    """Build a minimal RDF graph that satisfies ontology_handler expectations."""
    g = rdflib.Graph()
    p = rdflib.Namespace(PREFIX)
    skos = rdflib.Namespace("http://www.w3.org/2004/02/skos/core#")
    rdfs = rdflib.Namespace("http://www.w3.org/2000/01/rdf-schema#")
    dpv_owl = rdflib.Namespace("https://w3id.org/dpv/owl#")

    risk_uri = p.LowCount
    g += g{
        {risk_uri} {rdfs.subClassOf} {dpv_owl.Risk} ;
           {skos.definition} "Low count risk" ;
           {skos.prefLabel} "LowCount"
    }

    barn_uri = p.Frequencies
    g += g{
        {barn_uri} {rdfs.subClassOf} {p.Statbarn} ;
           {skos.definition} "Frequency statbarn" ;
           {skos.prefLabel} "Frequencies"
    }

    analysis_uri = p.FrequencyTable
    g += g{
        {analysis_uri} {rdfs.subClassOf} {barn_uri} ;
           {skos.definition} "Frequency table analysis" ;
           {skos.prefLabel} "FrequencyTable"
    }

    check_uri = p.MinimumThresholdCheck
    g += g{
        {check_uri} {rdfs.subClassOf} <https://w3id.org/dpv/risk/owl#RiskEvaluation> ;
           {skos.definition} "Minimum threshold check def" ;
           {skos.prefLabel} "MinimumThresholdCheck"
    }

    return g
