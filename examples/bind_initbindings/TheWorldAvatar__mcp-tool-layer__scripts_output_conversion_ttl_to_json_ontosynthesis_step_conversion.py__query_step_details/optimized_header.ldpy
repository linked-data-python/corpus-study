from step_conversion_context import graph, step_uri
@prefix ontosyn: <https://www.theworldavatar.com/kg/OntoSyn/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

vessel_type_result = list(s{ SELECT DISTINCT ?vesselTypeLabel
    WHERE {
        f<{step_uri}> ontosyn:hasVessel ?vessel .
        ?vessel ontosyn:hasVesselType ?vesselType .
        ?vesselType rdfs:label ?vesselTypeLabel .
    } }(graph))
