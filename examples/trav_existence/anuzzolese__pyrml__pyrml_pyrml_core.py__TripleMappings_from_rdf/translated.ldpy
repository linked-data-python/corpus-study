#
# `tps = g.triples((tm, rml_vocab.RML_NS.logicalSource|rml_vocab.RR_NS.logicalTable, None))`
# stays plain rdflib: NOT expressible by any island (see meta.json). Two
# blockers compound: the predicate is a SPARQL property-path alternation
# (`|`), which querying.md lists explicitly under "What m{ } does not have";
# and the subject `tm` is `None` (a wildcard) exactly when `parent` is
# falsy, decided at RUNTIME by a Python condition -- the piege from
# INSTRUCTIONS_403 SS2 ("un motif recu en donnee est hors d'atteinte"): a
# joker is lexical (an unbound `?var` written in the pattern), never a
# value that happens to be `None`, so neither `m{ }` nor `s{ }`'s `{expr}`
# term-position interpolation can express "variable here if this Python
# value is None, else this bound term" in one pattern.
from typing import List
from rdflib import Graph, IdentifiedNode
from pyrml_context import rml_vocab, TermMap, TripleMappings
@prefix rr: <http://www.w3.org/ns/r2rml#> .

@staticmethod
def from_rdf(g: Graph, parent: IdentifiedNode = None) -> List[TermMap]:
    @graph g

    tm = None
    if parent:
        tm = m{ {parent} rr:parentTriplesMap ?tm }.first()

    tps = g.triples((tm, rml_vocab.RML_NS.logicalSource|rml_vocab.RR_NS.logicalTable, None))

    triple_mappings = []
    for tm,p,o in tps:
        if bool(m{ {tm} rr:subjectMap ?x }):
            triple_mappings.append(TripleMappings.__build(g, tm))
    return triple_mappings
