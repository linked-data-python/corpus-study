from rdflib import Graph, URIRef
from fdpneo_namespaces_context import DCAT, DCT
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
DIST = "https://fdp.example/data/dist-1"
RIGHTS = "https://fdp.example/offers/public"

def _graph(
    *, with_download: bool = True, with_access: bool = True, with_rights: bool = True
) -> Graph:
    @graph as g
    subject = URIRef(DIST)
    +{ {subject} dcat:Distribution <https://example.org/type> }  # marker triple
    if with_download:
        +{ {subject} dcat:downloadURL <https://files.example.org/d1.csv> }
    if with_access:
        +{ {subject} dcat:accessURL <https://fdp.example/data/dist-1/sparql> }
    if with_rights:
        +{ {subject} dct:rights {URIRef(RIGHTS)} }
    return g
