import rdflib
from context_shim import PREFIX  # context shim -- see meta.json

def _build_minimal_graph() -> rdflib.Graph:
    """Build a minimal RDF graph that satisfies ontology_handler expectations."""
    g = rdflib.Graph()
    @graph g
    @prefix p: f<{PREFIX}> .
    @prefix skos: <http://www.w3.org/2004/02/skos/core#> .
    @prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
    +{
        p:LowCount rdfs:subClassOf <https://w3id.org/dpv/owl#Risk> ;
            skos:definition "Low count risk" ;
            skos:prefLabel "LowCount" .
        p:Frequencies rdfs:subClassOf p:Statbarn ;
            skos:definition "Frequency statbarn" ;
            skos:prefLabel "Frequencies" .
        p:FrequencyTable rdfs:subClassOf p:Frequencies ;
            skos:definition "Frequency table analysis" ;
            skos:prefLabel "FrequencyTable" .
        p:MinimumThresholdCheck rdfs:subClassOf <https://w3id.org/dpv/risk/owl#RiskEvaluation> ;
            skos:definition "Minimum threshold check def" ;
            skos:prefLabel "MinimumThresholdCheck"
    }
    return g
