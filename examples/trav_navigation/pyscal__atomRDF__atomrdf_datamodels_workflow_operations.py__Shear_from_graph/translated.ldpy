from atomrdf_context import get_sample_object, classmethod, cmso:, prov:

@classmethod
def from_graph(cls, graph, activity_id):
    @graph graph
    activity = get_sample_object(activity_id)
    output_sample = m{ ?s prov:wasGeneratedBy {activity} }.first()
    input_sample = (
        m{ {output_sample} prov:wasDerivedFrom ?o }.first() if output_sample else None
    )

    shear_vector = None
    for vec in m{ {activity} cmso:hasVector ?vec }:
        x = m{ {vec} cmso:hasComponent_x ?x }.first()
        y = m{ {vec} cmso:hasComponent_y ?y }.first()
        z = m{ {vec} cmso:hasComponent_z ?z }.first()
        shear_vector = [x.toPython(), y.toPython(), z.toPython()]
        break

    normal_vector = None
    distance = None
    plane = m{ {activity} cmso:hasPlane ?plane }.first()
    if plane is not None:
        nv = m{ {plane} cmso:hasNormalVector ?nv }.first()
        if nv is not None:
            x = m{ {nv} cmso:hasComponent_x ?x }.first()
            y = m{ {nv} cmso:hasComponent_y ?y }.first()
            z = m{ {nv} cmso:hasComponent_z ?z }.first()
            normal_vector = [x.toPython(), y.toPython(), z.toPython()]
        d = m{ {plane} cmso:hasDistanceFromOrigin ?d }.first()
        if d is not None:
            distance = d.toPython()

    return cls(
        id=str(activity_id),
        input_sample=str(input_sample) if input_sample else None,
        output_sample=str(output_sample) if output_sample else None,
        shear_vector=shear_vector,
        normal_vector=normal_vector,
        distance=distance,
    )
