from rdflib import BNode, Graph, Literal, Namespace, URIRef
from rdflib.namespace import DCTERMS, OWL, RDF, RDFS, SH, SKOS, XSD
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

URI_BASE = "https://spdx.org/rdf/3/terms/"

def gen_rdf_individuals(model, g):
    def ci_ref(s):
        return URIRef(URI_BASE + "Core/" + s)

    for i in model.individuals.values():
        ci_node = URIRef("https://spdx.org/rdf/3.1/creationInfo_" + i.name)
        g += g{
            {ci_node} a {ci_ref("CreationInfo")} ;
               rdfs:comment "This individual element was defined by the spec."@en ;
               {ci_ref("created")} "2026-01-23T03:01:00Z"^^xsd:dateTimeStamp ;
               {ci_ref("createdBy")} {ci_ref("SpdxOrganization")} ;
               {ci_ref("specVersion")} "3.1"
        }
        node = URIRef(i.iri)
        g += g{
            {node} a owl:NamedIndividual ;
               {ci_ref("creationInfo")} {ci_node}
        }
        if i.summary:
            g += g{ {node} rdfs:comment {Literal(i.summary, lang="en")} }
        typ = i.metadata["type"]
        typename = "" if typ.startswith("/") else f"/{i.ns.name}/"
        typename += typ
        dt = model.types[typename]
        g += g{ {node} a {URIRef(dt.iri)} }
        custom_iri = i.metadata.get("IRI")
        if custom_iri and custom_iri != i.iri:
            g += g{ {node} owl:sameAs {URIRef(custom_iri)} }
