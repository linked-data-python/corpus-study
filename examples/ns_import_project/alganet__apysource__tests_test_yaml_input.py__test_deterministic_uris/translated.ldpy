#
# `from apysource.namespaces import OA, SCHEMA, SV` becomes a prefix import.
# The real module exports no `__namespaces__` registry, so the import points at
# apysource_ns_shim, which re-exports the package's own SV/OA/SCHEMA objects
# and adds the registry (see meta.json). `from rdflib.namespace import ...`
# cannot take `from ... import p:` (ldpy/012 point 21); only RDF is used in
# the body, so `@prefix rdf:` covers it. `g.subjects(RDF.type, SV.Source)` is
# a one-pattern read: `m{ ?s rdf:type sv:Source }(g)`.
from pathlib import Path
from rdflib.namespace import DCTERMS, RDF, RDFS
from apysource_ns_shim import oa:, schema:, sv:
from apysource.yaml_input import load_yaml, _slugify, _make_uri
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
SIMPLE_YAML = """\
sources:
  - label: "UN Charter"
    url: "https://www.un.org/en/about-us/un-charter/full-text"
    type: html
    language: en
    fragments:
      - label: "Preamble"
        selector: "p"
        snippet: "to save succeeding generations"
      - label: "Article 1"
        section: "Article 1"
        snippet: "The Purposes of the United Nations are"
"""


def _write_yaml(tmp_path: Path, content: str) -> Path:
    p = tmp_path / "sources.yaml"
    p.write_text(content)
    return p


def test_deterministic_uris(tmp_path):
    """Same YAML produces identical URIs on repeated loads."""
    g1 = load_yaml(_write_yaml(tmp_path, SIMPLE_YAML))
    g2 = load_yaml(_write_yaml(tmp_path, SIMPLE_YAML))

    sources1 = sorted(str(s) for s in m{ ?s rdf:type sv:Source }(g1))
    sources2 = sorted(str(s) for s in m{ ?s rdf:type sv:Source }(g2))
    assert sources1 == sources2
