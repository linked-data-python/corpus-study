from rdflib import Graph, Namespace, Literal, URIRef
from rdflib.namespace import RDF, DCTERMS, XSD, RDFS, FOAF
from config import Config
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .


def _generate_dcat_html_metadata(self):
    if 'http://www.w3.org/2004/02/skos/core#ConceptScheme' or 'http://www.w3.org/2004/02/skos/core#Collection' in \
            self.contained_item_classes:
        # If this register is rendering the view for skos:ConceptSchemes or skos:Collections,
        # then inject additional HTML.

        g = Graph()
        DCAT = Namespace('http://www.w3.org/ns/dcat#')

        # Catalog
        catalog = URIRef(self.request.base_url)
        g += g{
            {catalog} a {DCAT.Catalog} ;
               dcterms:title {Literal(Config.title)} ;
               rdfs:label {Literal(Config.title)} ;
               dcterms:description {Literal(Config.description)} ;
               foaf:homepage {URIRef(self.request.url_root)}
        }

        for item in self.register_items:
            # Dataset
            g += g{
                {item[0]} a {DCAT.Dataset} ;
                   dcterms:title {item[1]} ;
                   rdfs:label {item[1]} ;
                   dcterms:type <http://id.loc.gov/vocabulary/marcgt/dic> ;
                   {DCAT.landingPage} {URIRef('{}id/{}'.format(self.request.host_url, item[0]))} .
                {catalog} {DCAT.dataset} {item[0]}
            }

            if item[2][0][1]:
                # dcterms:created
                g += g{ {item[0]} {item[2][0][0]} {Literal(item[2][0][1], datatype=XSD.date)} }
            if item[2][1][1]:
                # dcterms:modified
                g += g{ {item[0]} {item[2][1][0]} {Literal(item[2][1][1], datatype=XSD.date)} }
            if item[2][2] and item[2][2][1]:
                # dcterms:description
                g += g{ {item[0]} {item[2][2][0]} {item[2][2][1]} }

            # Distribution
            subject = URIRef(self.request.host_url + '?_format=text/html&_view=skos')
            g += g{
                {subject} a {DCAT.Distribution} ;
                   {DCAT.downloadURL} {subject} ;
                   {DCAT.mediaType} <https://www.iana.org/assignments/media-types/text/html> .
                {catalog} {DCAT.distribution} {subject}
            }

            subject = URIRef(self.request.host_url + '?_format=text/turtle&_view=skos')
            g += g{
                {subject} a {DCAT.Distribution} ;
                   {DCAT.downloadURL} {subject} ;
                   {DCAT.mediaType} <https://www.iana.org/assignments/media-types/text/turtle> .
                {catalog} {DCAT.distribution} {subject}
            }

            subject = URIRef(self.request.host_url + '?_format=application/rdf+xml&_view=skos')
            g += g{
                {subject} a {DCAT.Distribution} ;
                   {DCAT.downloadURL} {subject} ;
                   {DCAT.mediaType} <https://www.iana.org/assignments/media-types/application/rdf+xml> .
                {catalog} {DCAT.distribution} {subject}
            }

            subject = URIRef(self.request.host_url + '?_format=application/ld+json&_view=skos')
            g += g{
                {subject} a {DCAT.Distribution} ;
                   {DCAT.downloadURL} {subject} ;
                   {DCAT.mediaType} <https://www.iana.org/assignments/media-types/application/ld+json> .
                {catalog} {DCAT.distribution} {subject}
            }

            subject = URIRef(self.request.host_url + '?_format=text/n3&_view=skos')
            g += g{
                {subject} a {DCAT.Distribution} ;
                   {DCAT.downloadURL} {subject} ;
                   {DCAT.mediaType} <https://www.iana.org/assignments/media-types/text/n3> .
                {catalog} {DCAT.distribution} {subject}
            }

            subject = URIRef(self.request.host_url + '?_format=application/n-triples&_view=skos')
            g += g{
                {subject} a {DCAT.Distribution} ;
                   {DCAT.downloadURL} {subject} ;
                   {DCAT.mediaType} <https://www.iana.org/assignments/media-types/application/n-triples> .
                {catalog} {DCAT.distribution} {subject}
            }

        additional_html = '<script type="application/ld+json">' + g.serialize(format='json-ld').decode('utf-8') + '</script>'
    else:
        additional_html = None

    return additional_html
