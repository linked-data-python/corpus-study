from rdflib import BNode, URIRef, Literal, RDF, RDFS, Namespace
from d3fend_context import get_attack_id, _xmlns as _XMLNS  # context shim, see meta.json
@prefix d3fend: <http://d3fend.mitre.org/ontologies/d3fend.owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

def update_definition(graph, tech, framework):
    @graph graph
    tech = tech["data"]
    attack_id = get_attack_id(tech, framework)
    attack_uri = URIRef(_XMLNS + attack_id)
    new = 0

    if bool(m{ ?s ?p {attack_id} }):

        def_property = m{ {attack_uri} d3fend:definition ?v }.first()
        # Check if tech already has definition
        if def_property is None:
            new = 1
            # Add definition
            +{ {attack_uri} d3fend:definition {tech["description"].strip().split("\n")[0].strip()} }
    return new
