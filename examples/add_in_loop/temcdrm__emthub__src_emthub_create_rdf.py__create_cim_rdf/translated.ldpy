import rdflib
from context_shim import g, CIM, dyn_models, uuids, model_types_used
CIM_NS = 'http://www.ucaiug.org/grid18v15#'
EMT_NS = 'http://opensource.ieee.org/emtiop01v01#'
@prefix cim: <http://www.ucaiug.org/grid18v15#> .
@prefix emt: <http://opensource.ieee.org/emtiop01v01#> .

@graph g
for key in model_types_used:
  model_type = dyn_models['DYR'][key]
  ID = model_type['mRID']
  uuids['NthAmDynamicModel' + ':' + key] = ID
  mtyp = f<{ID}>
  +{ {mtyp} a emt:NthAmDynamicModel ;
            cim:IdentifiedObject.name {key}^^cim:String ;
            cim:IdentifiedObject.mRID {ID}^^cim:String ;
            emt:NthAmDynamicModel.modelKind emt:{'NthAmModelKind.{:s}'.format(model_type['modelKind'])} ;
            emt:NthAmDynamicModel.nameKind emt:{'NthAmModelNameKind.{:s}'.format(model_type['nameKind'])} ;
            emt:NthAmDynamicModel.statusKind emt:{'NthAmModelStatusKind.{:s}'.format(model_type['statusKind'])} ;
            emt:NthAmDynamicModel.closestStandardModel {model_type['closestStandardModel']}^^cim:String }
  parms = model_type['parameterDescriptors']
  for i in range(3,len(parms)):
    ID = parms[i]['mRID']
    uuids['ParameterDescriptor' + ':' + '{:s}_{:s}'. format (key, parms[i]['name'])] = ID
    desc = f<{ID}>
    +{ {desc} a cim:ParameterDescriptor ;
              cim:IdentifiedObject.name {parms[i]['name']}^^cim:String ;
              cim:IdentifiedObject.mRID {ID}^^cim:String ;
              cim:DetailedModelDescriptor.DetailedModelTypeDynamics {mtyp} ;
              cim:ParameterDescriptor.typicalValue {parms[i]['typicalValue']}^^cim:String ;
              cim:ParameterDescriptor.engineeringUnit {parms[i]['engineeringUnit']}^^cim:String ;
              cim:ParameterDescriptor.sequenceNumber {parms[i]['sequenceNumber']}^^cim:Integer }
