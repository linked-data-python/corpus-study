from rdflib import URIRef, Graph, IdentifiedNode
from rdflib.namespace import RDF, Namespace, XSD
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


def to_rdf(self):
    @prefix sd: <http://www.w3.org/ns/sparql-service-description#> .

    g = g{ {self} a sd:Service }
    @graph g

    if self.endpoint:
        +{ {self} sd:endpoint {self.endpoint} }

    if self.result_format:
        +{ {self} sd:resultFormat {self.result_format} }

    return g
