# Input graph for ternaustralia__vocview__skos_concept.py__ConceptRenderer__render_skos_rdf.
# Loaded once (see config.py) into config.Config.g -- the shared graph the
# real app reads from. driver.py calls the region for three different URIs:
# ex:concept1 (several direct triples PLUS a blank-node object whose own
# triples must be pulled in too), ex:concept2 (the neighbourhood -- its
# triples must never appear when rendering concept1, and vice versa), and
# ex:absent (typed nowhere in this graph -- the zero-solution case).
@prefix ex: <http://example.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

ex:concept1 a skos:Concept ;
    skos:prefLabel "Concept One"@en ;
    skos:broader ex:concept2 ;
    skos:related _:b1 .

_:b1 a skos:Concept ;
    skos:prefLabel "Anonymous related concept"@en ;
    skos:note "reached only through concept1's blank node" .

# Neighbourhood: concept2's own triples must not leak into concept1's
# rendering, and concept1's must not leak into concept2's.
ex:concept2 a skos:Concept ;
    skos:prefLabel "Concept Two"@en ;
    skos:narrower ex:concept1 .
