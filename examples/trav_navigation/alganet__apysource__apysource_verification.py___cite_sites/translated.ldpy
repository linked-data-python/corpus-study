from rdflib import BNode, Graph, Literal, URIRef
from context_shim import PROV, SV, CheckResult, CiteSite, Failure, FetcherResult, RepoResult  # context shim -- see meta.json
@prefix sv: <https://alganet.github.io/apysource/vocab.ttl#> .


def _cite_sites(g: Graph, urn: str) -> list[CiteSite]:
    """The places that make this fragment's claim, as the graph holds them."""
    if not urn:
        return []
    @graph g

    sites = []
    for node in m{ {URIRef(urn)} sv:citedBy ?node }:
        file = m{ {node} sv:citingFile ?file }.first()
        if file is None:
            continue
        line = m{ {node} sv:citingLine ?line }.first()
        sites.append(CiteSite(file=str(file),
                              line=int(str(line)) if line is not None else None))

    return sorted(sites, key=lambda s: (s.file, s.line if s.line else 0))
