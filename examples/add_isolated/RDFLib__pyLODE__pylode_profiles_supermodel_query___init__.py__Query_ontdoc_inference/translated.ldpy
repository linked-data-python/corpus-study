from itertools import chain
from context_shim import g
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sdo: <https://schema.org/> .

@graph g
for s_, o in chain(
    m{ ?s dc:creator ?o },
    m{ ?s sdo:creator ?o },
    m{ ?s sdo:author ?o },
):
    -{ {s_} dc:creator {o} }
    -{ {s_} sdo:creator {o} }
    -{ {s_} sdo:author {o} }
    +{ {s_} dcterms:creator {o} }
