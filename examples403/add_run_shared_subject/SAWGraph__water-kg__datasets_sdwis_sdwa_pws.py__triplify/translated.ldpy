from rdflib.namespace import OWL, XMLNS, XSD, RDF, RDFS
from rdflib import URIRef, BNode, Literal
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xmlns: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

prefixes = {}

def triplify(df):
    kg = Initial_KG()
    for idx, row in df.iterrows():
        # get attributes
        pws = get_attributes(row)
        # get iris
        iris = get_iris(pws)
        #print(iris)

        #pws
        kg += g{ {iris['PWS']} a {prefixes['us_sdwis']['PublicWaterSystem']} }
        if pws['Type'] != "NP":
            kg += g{ {iris['PWS']} a {prefixes['us_sdwis'][str('PublicWaterSystem' + '-' + pws['Type'])]} }
        if 'Transient' in pws.keys():
            kg += g{ {iris['PWS']} a {prefixes['us_sdwis'][str('PublicWaterSystem' + '-' + pws['Transient'])]} }
        if 'GWSW' in pws.keys():
            kg += g{ {iris['PWS']} a {prefixes['us_sdwis'][str('PublicWaterSystem' + '-' + pws['GWSW'])]} }
        if 'Name' in pws.keys():
            kg += g{
                {iris['PWS']} {prefixes['us_sdwis']['pwsName']} {Literal(pws['Name'], datatype=XSD.string)} ;
                   rdfs:label {Literal(pws['Name'], datatype=XSD.string)}
            }

        #key data properties
        kg += g{
            {iris['PWS']} {prefixes['us_sdwis']['populationServed']} {Literal(pws['PopulationServed'], datatype=XSD.int)} ;
               {prefixes['us_sdwis']['serviceConnections']} {Literal(pws['Connections'], datatype=XSD.int)} ;
               {prefixes['us_sdwis']['hasActivity']} {Literal(pws['ActivityCodeLong'], datatype=XSD.string)}
        }
        #TODO season begin/end What datatype for recurring day-month date?

        #extra properties
        if 'Deactivation' in pws.keys():
            kg += g{ {iris['PWS']} {prefixes['us_sdwis']['deactivationDate']} {Literal(pws['Deactivation'], datatype=XSD.date)} }
        if 'Owner' in pws.keys():
            kg += g{ {iris['PWS']} {prefixes['us_sdwis']['hasOwnership']} {Literal(pws['Owner'], datatype=XSD.string)} }
        if 'SourceType' in pws.keys():
            #kg.add((iris['PWS'], prefixes['us_sdwis']['primarySource'], Literal(pws['Source'], datatype=xsd:string))) #old literal version
            kg += g{ {iris['PWS']} {prefixes['us_sdwis']['primarySourceType']} {iris['SourceType']} }
        kg += g{ {iris['PWS']} {prefixes['us_sdwis']['firstReport']} {Literal(pws['FirstReport'], datatype=XSD.date )} }
        if 'LastReport' in pws.keys():
            kg += g{ {iris['PWS']} {prefixes['us_sdwis']['lastReport']} {Literal(pws['LastReport'], datatype=XSD.date)} }


        #object properties
        ##combined distribution system
        if 'CDSID' in pws.keys():
            kg += g{
                {iris['CDS']} a {prefixes['us_sdwis']['CombinedDistributionSystem']} .
                {iris['PWS']} {prefixes['us_sdwis']['inCombinedSystem']} {iris['CDS']}
            }

    return kg
