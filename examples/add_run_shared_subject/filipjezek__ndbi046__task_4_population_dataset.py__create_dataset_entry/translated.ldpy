from rdflib import Graph, Literal, URIRef
from rdflib.namespace import DCAT, RDF, DCTERMS, RDFS
from cube_lib.namespaces import NSR
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix nsr: <https://filipjezek.github.io/resources/> .


def create_dataset_entry(collector: Graph):
    collector += g{
        nsr:PopulationDataCube a dcat:Dataset ;
           dcterms:title "Population data cube"@en ;
           rdfs:label "Population data cube"@en ;
           dcterms:description "A data cube containing mean population of Czech counties and regions in 2021"@en ;
           dcterms:spatial <http://publications.europa.eu/resource/authority/country/CZE> ;
           dcterms:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/NEVER>
    }
    me = <https://github.com/filipjezek>
    collector += g{
        nsr:PopulationDataCube dcterms:publisher {me} ;
           dcterms:creator {me} ;
           dcat:keyword "population"@en ;
           dcat:keyword "region"@en ;
           dcat:keyword "district"@en ;
           dcat:theme <http://eurovoc.europa.eu/2908>
    }

    distribution = nsr:PopulationDataCube.ttl
    collector += g{
        nsr:PopulationDataCube dcat:distribution {distribution} .
        {distribution} a dcat:Distribution ;
           dcat:accessURL {distribution} ;
           dcterms:format <http://publications.europa.eu/resource/authority/file-type/RDF_TURTLE> ;
           dcat:mediaType <http://www.iana.org/assignments/media-types/text/turtle>
    }
