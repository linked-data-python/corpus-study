import urllib.parse
from collections.abc import Iterable, Set
from typing import Any, cast

from neat_ctx import Row, RowList          # shim: cognite.client.data_classes
from neat_ctx import SequenceNotStr        # shim: cognite.client.utils.useful_types
from rdflib import Namespace, URIRef

from neat_ctx import NeatClient            # shim: ..._client
from neat_ctx import DEFAULT_RAW_URI       # shim: ..._constants
from neat_ctx import Triple                # shim: ..._shared

from neat_ctx import BaseExtractor          # shim: ._base
from neat_ctx import DEFAULT_EMPTY_VALUES, DictExtractor  # shim: ._dict
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .


class RAWExtractor(BaseExtractor):
    def __init__(
        self,
        client: NeatClient,
        db_name: str,
        table_name: str,
        table_type: str | None = None,
        foreign_keys: str | SequenceNotStr[str] | None = None,
        namespace: Namespace | None = None,
        empty_values: Set[str] = DEFAULT_EMPTY_VALUES,
        str_to_ideal_type: bool = False,
        unpack_json: bool = False,
    ) -> None:
        self.client = client
        self.db_name = db_name
        self.table_name = table_name
        self.table_type = table_type
        self.foreign_keys = {foreign_keys} if isinstance(foreign_keys, str) else set(foreign_keys or [])
        self.namespace = namespace or Namespace(DEFAULT_RAW_URI)
        self.empty_values = empty_values
        self.str_to_ideal_type = str_to_ideal_type
        self.unpack_json = unpack_json

    @property
    def _rdf_type(self) -> URIRef:
        return self.namespace[urllib.parse.quote(self.table_type or self.table_name)]

    def extract(self) -> Iterable[Triple]:
        for row in self.client.raw.rows(self.db_name, self.table_name, partitions=10, chunk_size=None):
            if isinstance(row, Row):
                yield from self._row2triples(row)
            elif isinstance(row, RowList):
                # Bug in SDK returning row list with chunk_size= None
                for item in row:
                    yield from self._row2triples(item)

    def _row2triples(self, row: Row) -> Iterable[Triple]:
        # The row is always set. It is just the PySDK that have it as str | None
        key, data = cast(tuple[str, dict[str, Any]], (row.key, row.columns))
        identifier = self.namespace[urllib.parse.quote(key)]
        yield identifier, rdf:type, self._rdf_type

        yield from DictExtractor(
            identifier,
            data,
            self.namespace,
            self.foreign_keys,
            self.empty_values,
            self.str_to_ideal_type,
            self.unpack_json,
        ).extract()

# --- demo harness: identical in original.py and translated.ldpy ---
# The region is a module defining an extractor class, so nothing observable
# happens on import; the harness compares module state, and this section
# gives it a graph to compare by running the extractor over a canned RAW
# table (one plain Row, and a RowList, covering both branches of extract()).
from rdflib import Graph

demo_client = NeatClient({
    "asset": [
        Row("row-one", {"name": "Pump 1", "pressure": 3.5, "tags": ["a", "b"],
                        "meta": {"x": 1}, "a_id": "row two"}),
        RowList([
            Row("row two", {"name": "Pump 2", "active": True}),
            Row("row/three", {"name": "Pump 3"}),
        ]),
    ]
})
demo_graph = Graph()
for triple in RAWExtractor(demo_client, "db", "asset", table_type="Asset",
                           foreign_keys="a_id").extract():
    demo_graph.add(triple)
print(len(demo_graph))
print(sorted(str(s) for s in set(demo_graph.subjects())))
