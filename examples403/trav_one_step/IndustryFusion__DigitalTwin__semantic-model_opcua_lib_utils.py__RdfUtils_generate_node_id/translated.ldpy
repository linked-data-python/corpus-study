from rdflib import URIRef, Namespace, Graph, Literal, BNode
from rdfutils_context import nodeId_to_iri

def generate_node_id(self, graph, rootentity, node, id):
    @graph graph
    node_id = m{ {node} {self.basens['hasNodeId']} ?v }.first()
    if node_id is None:
        node_id = 'unknown'
    idtype = m{ {node} {self.basens['hasIdentifierType']} ?v }.first()
    if idtype is None:
        idtype = 'unknown'
    rootns = m{ {rootentity} {self.basens['hasNamespace']} ?v }.first()
    if rootns is None:
        rootns = 'unknown'
    rootnsuri = m{ {rootns} {self.basens['hasUri']} ?v }.first()
    if rootnsuri is None:
        rootnsuri = 'unknown'
    ns = m{ {node} {self.basens['hasNamespace']} ?v }.first()
    if ns is None:
        ns = 'unknown'
    nsuri = m{ {ns} {self.basens['hasUri']} ?v }.first()
    if nsuri is None:
        nsuri = 'unknown'
    nsurins = Namespace(nsuri)
    result = nodeId_to_iri(nsurins, self.basens, node_id, idtype, id, is_entityns=(str(nsuri) == str(rootnsuri)))
    return result
