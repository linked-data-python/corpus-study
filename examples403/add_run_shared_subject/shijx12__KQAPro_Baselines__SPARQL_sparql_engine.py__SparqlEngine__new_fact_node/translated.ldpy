@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


def _new_fact_node(self, h, r, t):
    node = BNode()
    self.graph += g{
        {node} {self.nodes[SparqlEngine.PRED_FACT_H]} {h} ;
           {self.nodes[SparqlEngine.PRED_FACT_R]} {r} ;
           {self.nodes[SparqlEngine.PRED_FACT_T]} {t}
    }
