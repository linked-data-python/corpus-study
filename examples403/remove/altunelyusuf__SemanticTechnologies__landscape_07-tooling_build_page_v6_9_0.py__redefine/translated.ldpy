g = Graph().parse(f"{HERE}/04-page/semtech_page_abox_v6_8_0.ttl")

def redefine(iri, label=None, defn=None, note=None, scope=None):
    g += g{ {iri} rdfs:label {Literal(label, lang="en")} }
    g += g{ {iri} skos:definition {Literal(defn, lang="en")} }
    g += g{ {iri} skos:note {Literal(note, lang="en")} }
    g += g{ {iri} skos:scopeNote {Literal(scope, lang="en")} }
