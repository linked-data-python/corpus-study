def to_graph_calculated_properties(self, graph):
    if self.calculated_property:
        for param in self.calculated_property:
            param_uri = param.to_graph(graph)
            graph += g{ {URIRef(self.id)} asmo:hasCalculatedProperty {param_uri} }
