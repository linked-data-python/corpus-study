import yaml
from rdflib import DCAT, DCTERMS, SKOS, Graph, Literal, Namespace, URIRef
from rdflib.namespace import OWL, RDF, RDFS
@prefix nsos: <https://owaspsamm.org/model/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

BASEDIR = Path("external/samm-model")

def parse_stream(g):
    for f in (BASEDIR / "streams").glob("*.yml"):
        data = yaml.safe_load(f.read_text())
        id_ = data["id"]
        altLabel = f.name.replace(".yml", "")
        uri = URIRef(f"{NS_OS}{id_}")
        practice_uri = URIRef(NS_OS + data["practice"])
        g += g{
            {uri} a nsos:Stream ;
               rdfs:label {Literal(data["name"])} ;
               skos:altLabel {Literal(altLabel)} ;
               dcterms:identifier {Literal(id_)} ;
               dcterms:description {Literal(data["description"])} ;
               nsos:hasOrder {Literal(data["order"])} ;
               nsos:hasLetter {Literal(data["letter"])} ;
               nsos:hasPractice {practice_uri}
        }

        # Relation to practice
        if practice := g.value(practice_uri, skos:altLabel):
            g += g{ {uri} nsos:practice {practice} }
