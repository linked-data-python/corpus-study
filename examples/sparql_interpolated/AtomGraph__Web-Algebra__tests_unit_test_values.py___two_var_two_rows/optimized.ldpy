from rdflib import BNode, Graph, Literal, URIRef
EX_A = "http://ex/a"
EX_B = "http://ex/b"
EX_P = "http://ex/p"


def _two_var_two_rows():
    g = g{ f<{EX_A}> f<{EX_P}> "v1" .
           f<{EX_B}> f<{EX_P}> "v2" }
    return s{ SELECT ?s ?o WHERE { ?s f<{EX_P}> ?o } ORDER BY ?s }(g).execute()
