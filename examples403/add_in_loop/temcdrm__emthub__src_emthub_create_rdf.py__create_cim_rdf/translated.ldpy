import rdflib
CIM_NS = 'http://www.ucaiug.org/grid18v15#'
EMT_NS = 'http://opensource.ieee.org/emtiop01v01#'

for key in model_types_used:
  model_type = dyn_models['DYR'][key]
  ID = model_type['mRID']
  uuids['NthAmDynamicModel' + ':' + key] = ID
  mtyp = rdflib.URIRef (ID)
  g += g{
      {mtyp} {rdflib.RDF.type} {rdflib.URIRef (EMT_NS + 'NthAmDynamicModel')} ;
         {rdflib.URIRef (CIM_NS + 'IdentifiedObject.name')} {rdflib.Literal(key, datatype=CIM.String)} ;
         {rdflib.URIRef (CIM_NS + 'IdentifiedObject.mRID')} {rdflib.Literal(ID, datatype=CIM.String)} ;
         {rdflib.URIRef (EMT_NS + 'NthAmDynamicModel.modelKind')} {rdflib.URIRef (EMT_NS + 'NthAmModelKind.{:s}'.format(model_type['modelKind']))} ;
         {rdflib.URIRef (EMT_NS + 'NthAmDynamicModel.nameKind')} {rdflib.URIRef (EMT_NS + 'NthAmModelNameKind.{:s}'.format(model_type['nameKind']))} ;
         {rdflib.URIRef (EMT_NS + 'NthAmDynamicModel.statusKind')} {rdflib.URIRef (EMT_NS + 'NthAmModelStatusKind.{:s}'.format(model_type['statusKind']))} ;
         {rdflib.URIRef (EMT_NS + 'NthAmDynamicModel.closestStandardModel')} {rdflib.Literal(model_type['closestStandardModel'], datatype=CIM.String)}
  }
  parms = model_type['parameterDescriptors']
  for i in range(3,len(parms)):
    ID = parms[i]['mRID']
    uuids['ParameterDescriptor' + ':' + '{:s}_{:s}'. format (key, parms[i]['name'])] = ID
    desc = rdflib.URIRef (ID)
    g += g{
        {desc} {rdflib.RDF.type} {rdflib.URIRef (CIM_NS + 'ParameterDescriptor')} ;
           {rdflib.URIRef (CIM_NS + 'IdentifiedObject.name')} {rdflib.Literal(parms[i]['name'], datatype=CIM.String)} ;
           {rdflib.URIRef (CIM_NS + 'IdentifiedObject.mRID')} {rdflib.Literal(ID, datatype=CIM.String)} ;
           {rdflib.URIRef (CIM_NS + 'DetailedModelDescriptor.DetailedModelTypeDynamics')} {mtyp} ;
           {rdflib.URIRef (CIM_NS + 'ParameterDescriptor.typicalValue')} {rdflib.Literal(parms[i]['typicalValue'], datatype=CIM.String)} ;
           {rdflib.URIRef (CIM_NS + 'ParameterDescriptor.engineeringUnit')} {rdflib.Literal(parms[i]['engineeringUnit'], datatype=CIM.String)} ;
           {rdflib.URIRef (CIM_NS + 'ParameterDescriptor.sequenceNumber')} {rdflib.Literal(parms[i]['sequenceNumber'], datatype=CIM.Integer)}
    }
