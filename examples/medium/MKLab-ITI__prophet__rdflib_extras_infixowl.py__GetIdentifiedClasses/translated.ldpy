from rdflib import (
@prefix owl-ns: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

    BNode,
    Literal,
    Namespace,
    RDF,
    RDFS,
    URIRef,
    Variable
)

def GetIdentifiedClasses(graph):
    for c in graph.subjects(predicate=rdf:type, object=owl-ns:Class):
        if isinstance(c, URIRef):
            yield Class(c)
