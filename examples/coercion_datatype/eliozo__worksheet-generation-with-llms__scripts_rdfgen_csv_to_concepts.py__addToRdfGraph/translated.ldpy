import rdflib
eliozo_ns = "http://www.dudajevagatve.lv/eliozo#"
RDF_NS = "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
@prefix eliozo: <http://www.dudajevagatve.lv/eliozo#> .

def addToRdfGraph(g, conceptID, termLV, descLV, termEN=None):
    @graph g
    topic_node = eliozo:{"TRM-" + conceptID}
    +{ {topic_node} a eliozo:Concept }
    if not termEN:
        termEN = conceptID.replace("-", " ")
    +{
        {topic_node} eliozo:termEN {termEN}@en ;
                     eliozo:termLV {termLV}@lv ;
                     eliozo:conceptID {conceptID}@en
    }
    if descLV and descLV != "" and descLV != "NA":
        +{ {topic_node} eliozo:descLV {descLV}@lv }
