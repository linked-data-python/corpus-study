from infixowl_context import classOrIdentifier
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

def _set_subClassOf(self, other):
    if not other:
        return
    for sc in other:
        self.graph += g{
            {self.identifier} rdfs:subClassOf {classOrIdentifier(sc)} }
