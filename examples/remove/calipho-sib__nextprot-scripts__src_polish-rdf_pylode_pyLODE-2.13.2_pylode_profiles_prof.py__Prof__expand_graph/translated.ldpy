from rdflib.namespace import DC, DCTERMS, OWL, PROF, RDF, RDFS, SDO, SKOS
from itertools import chain
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdo: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .


def _expand_graph(self):
    @graph self.G
    # label
    for s, o in chain(
            m{ ?s dc:title ?o },
            m{ ?s skos:prefLabel ?o },
            m{ ?s dcterms:title ?o }
    ):
        -{ {s} dc:title {o} }
        -{ {s} skos:prefLabel {o} }
        -{ {s} dcterms:title {o} }
        +{ {s} rdfs:label {o} }

    # comment
    for s, o in chain(
            m{ ?s dc:description ?o },
            m{ ?s dcterms:description ?o },
            m{ ?s sdo:description ?o },
            m{ ?s skos:definition ?o },
    ):
        -{ {s} dc:description {o} }
        -{ {s} dcterms:description {o} }
        -{ {s} sdo:description {o} }
        -{ {s} skos:definition {o} }
        +{ {s} rdfs:comment {o} }

    # Agents
    # creator
    for s, o in chain(
            m{ ?s dc:creator ?o },
            m{ ?s sdo:creator ?o },
            m{ ?s sdo:author ?o }  # conflate sdo:author with dcterms:creator
    ):
        -{ {s} dc:creator {o} }
        -{ {s} sdo:creator {o} }
        -{ {s} sdo:author {o} }
        +{ {s} dcterms:creator {o} }

    # contributor
    for s, o in chain(
            m{ ?s dc:contributor ?o },
            m{ ?s sdo:contributor ?o }
    ):
        -{ {s} dc:contributor {o} }
        -{ {s} sdo:contributor {o} }
        +{ {s} dcterms:contributor {o} }

    # publisher
    for s, o in chain(
            m{ ?s dc:publisher ?o },
            m{ ?s sdo:publisher ?o }
    ):
        -{ {s} dc:publisher {o} }
        -{ {s} sdo:publisher {o} }
        +{ {s} dcterms:publisher {o} }

    # Resource Descriptors
    for s, o in m{ ?s prof:hasResource ?o }:
        +{ {o} a prof:ResourceDescriptor }
