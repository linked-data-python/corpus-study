import hashlib
import json
from pathlib import Path
from rdflib import RDF, RDFS, XSD, Graph, Literal, Namespace, URIRef
from context import create_content_uuid, resolve_base_uri, METADATA, _read_source_project_version  # context shim, see meta.json
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ONTOUML_VOCABULARY_111 = <https://w3id.org/ontouml/vocabulary/v1.1.1>
IANA_MEDIA_TYPES = "https://www.iana.org/assignments/media-types/"

def test_embedded_metadata_describes_the_transformation(tmp_path: Path) -> None:
    """Verify the complete, opt-in embedded provenance profile."""
    input_file = write_cardinality_project(tmp_path, "0..1")

    result = run_metadata_cli(input_file, tmp_path, "embedded")

    assert result.returncode == 0, result.stderr
    output_file = tmp_path / "cardinality.ttl"
    output_graph = Graph().parse(output_file, format="turtle")
    @graph output_graph
    output_artifact = get_output_artifact(output_graph)
    transformation = m{ {output_artifact} prov:wasGeneratedBy ?v }.first()

    assert bool(m{ {output_artifact} a prov:Entity })
    assert bool(m{ {output_artifact} dcterms:title {output_file.name} })
    assert bool(m{ {output_artifact} dcterms:format {URIRef(IANA_MEDIA_TYPES + "text/turtle")} })
    assert bool(m{ {output_artifact} dcterms:conformsTo {ONTOUML_VOCABULARY_111} })
    assert bool(m{ {transformation} a prov:Activity })

    generation_time = m{ {output_artifact} prov:generatedAtTime ?v }.first()
    assert generation_time.datatype == xsd:dateTime
    assert generation_time.toPython().utcoffset().total_seconds() == 0

    software_agents = set(m{ {transformation} prov:wasAssociatedWith ?v })
    assert len(software_agents) == 1
    software_agent = next(iter(software_agents))
    assert bool(m{ {software_agent} a prov:SoftwareAgent })
    assert bool(m{ {software_agent} dcterms:title {METADATA["Name"]} })
    assert set(m{ {software_agent} dcterms:identifier ?v }) == {
        Literal(f"{METADATA['Name']}/{METADATA['Version']}")
    }

    used_entities = set(m{ {transformation} prov:used ?v })
    source_artifact = next(
        entity for entity in used_entities if bool(m{ {entity} dcterms:title {input_file.name} })
    )
    configuration_entity = next(entity for entity in used_entities if bool(m{ {entity} prov:value ?o }))
    expected_digest = hashlib.sha256(input_file.read_bytes()).hexdigest()

    assert bool(m{ {source_artifact} a prov:Entity })
    assert bool(m{ {source_artifact} dcterms:identifier {f"sha256:{expected_digest}"} })
    assert bool(m{ {source_artifact} dcterms:format {URIRef(IANA_MEDIA_TYPES + "application/json")} })

    configuration = get_recorded_configuration(output_graph)
    expected_base_uri = resolve_base_uri(json.loads(input_file.read_text(encoding="utf-8")))
    assert configuration == {
        "append_content_hash": False,
        "base_uri": None,
        "correct": False,
        "effective_base_uri": expected_base_uri,
        "format": "ttl",
        "invalid_cardinality_policy": "preserve",
        "invalid_stereotype_policy": "preserve",
        "language": "",
        "model_only": False,
        "path_order_policy": "warn",
        "property_assignment_policy": "warn",
        "transformation_metadata": "embedded",
        "unresolved_model_element_policy": "omit",
    }
    assert bool(m{ {configuration_entity} dcterms:format {URIRef(IANA_MEDIA_TYPES + "application/json")} })
    assert str(tmp_path) not in " ".join(str(value) for s, p, value in m{ ?s ?p ?value })
    assert not (tmp_path / "cardinality.provenance.ttl").exists()
