def load_brick_schema(self):
    self.statusBar().showMessage("Loading Brick Schema & Initializing Namespaces... Please wait.")
    from PyQt5.QtWidgets import QApplication

    QApplication.setOverrideCursor(Qt.WaitCursor)

    try:
        brick_type = self.settings.value("brick_source_type", "url")
        brick_path = (
            self.settings.value("brick_url", "https://brickschema.org/schema/1.4.4/Brick.ttl")
            if brick_type == "url"
            else self.settings.value("brick_local_path", "")
        )

        if not brick_path:
            raise ValueError("Brick schema path is empty. Please configure it in Settings.")

        self.brick_ontology = Graph()
        self.brick_ontology.parse(brick_path, format="turtle")

        # Instantiating customizable dynamic namespace structures
        self.BRICK = Namespace(self.settings.value("ns_brick", "https://brickschema.org/schema/Brick#"))
        self.REF = Namespace(self.settings.value("ns_ref", "https://brickschema.org/schema/Brick/ref#"))
        self.INST = Namespace(self.settings.value("ns_inst", "http://example.org/project#"))
        self.IFC_NS = Namespace(
            self.settings.value(
                "ns_ifc", "http://standards.buildingsmart.org/IFC/RELEASE/IFC4/Ontology#"
            )
        )

        self.rebuild_output_graph()
        self.build_brick_internal_map()

        self.brick_loaded = True
        self.statusBar().showMessage("Brick Schema and custom namespaces applied successfully!")

    except Exception as e:
        self.brick_loaded = False
        self.statusBar().showMessage("Error loading Brick Schema.")
        QMessageBox.critical(self, "Schema Load Error", f"Failed to load Brick schema.\n\n{str(e)}")
    finally:
        QApplication.restoreOverrideCursor()
