import rdflib
from src.app.items import EntityItem, ConnectionItem, PortItem, JointItem
from src.ontologies.namespaces import RDF, BLDG, REC, BRICK, BRICK_REF, VISU, BACNET, bind_namespaces, short_uuid
@prefix bldg: <http://example.org/building#> .
@prefix rec: <https://w3id.org/rec#> .
@prefix brickref: <https://brickschema.org/schema/Brick/ref#> .
@prefix visu: <http://example.org/visualization#> .
@prefix bacnet: <http://data.ashrae.org/bacnet/2020#> .


for item in self.scene.items():
    if isinstance(item, ConnectionItem) and item.source_port and item.target_port:
        source_uri = item.get_source_entity_uri()
        target_uri = item.get_target_entity_uri()

        if source_uri and target_uri:
            g += g{
                {source_uri} {item.relationship_type} {target_uri} .
                {item.instance_uri} {rdflib.RDF.type} visu:Connection ;
                   visu:sourceEntity {source_uri} ;
                   visu:targetEntity {target_uri} ;
                   visu:relationshipType {item.relationship_type}
            }

            color = item.pen().color()
            color_node = rdflib.BNode()

            g += g{
                {item.instance_uri} visu:color {color_node} .
                {color_node} visu:red {rdflib.Literal(color.red(), datatype=rdflib.XSD.integer)} ;
                   visu:green {rdflib.Literal(color.green(), datatype=rdflib.XSD.integer)} ;
                   visu:blue {rdflib.Literal(color.blue(), datatype=rdflib.XSD.integer)}
            }

            pen_style = item.pen().style()
            g += g{ {item.instance_uri} visu:lineStyle {rdflib.Literal(int(pen_style), datatype=rdflib.XSD.integer)} }

            pen_width = item.pen().width()
            g += g{ {item.instance_uri} visu:lineWidth {rdflib.Literal(pen_width, datatype=rdflib.XSD.integer)} }

            for i, joint in enumerate(item.joints):
                joint_node = rdflib.BNode()
                g += g{
                    {item.instance_uri} visu:hasJoint {joint_node} .
                    {joint_node} visu:jointIndex {rdflib.Literal(i, datatype=rdflib.XSD.integer)}
                }

                joint_pos = joint.scenePos()
                g += g{
                    {joint_node} visu:x {rdflib.Literal(float(joint_pos.x()), datatype=rdflib.XSD.float)} ;
                       visu:y {rdflib.Literal(float(joint_pos.y()), datatype=rdflib.XSD.float)}
                }
