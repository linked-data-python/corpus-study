# Scenario with no Done feature: done is empty and ev_ok is True (all() of
# nothing). The only b2:hasState b2:Done is on a subject that is not a
# feature, so a widened subject would make every feature Done.
@prefix b2: <http://example.org/backlog#> .

b2:F1 a b2:Feature ;
    b2:hasState b2:InProgress ;
    b2:hasEvidence b2:Ev1 .

b2:F2 a b2:Feature .

b2:Task9 b2:hasState b2:Done .
