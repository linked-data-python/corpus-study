from rdflib import Graph, Literal, URIRef, Variable

def get_bind_tests():
    base = "http://example.org/"
    g = Graph()
    @graph g
    +{ {URIRef(base + "thing")} {URIRef(base + "ns#comment")} "anything" }

    def check(expr, var, obj):
        r = g.query(
            """
                prefix : <http://example.org/ns#>
                select * where { ?s ?p ?o . %s } """
            % expr
        )
        assert r.bindings[0][Variable(var)] == obj

    yield (check, 'bind("thing" as ?name)', "name", Literal("thing"))

    yield (
        check,
        "bind(<http://example.org/other> as ?other)",
        "other",
        <http://example.org/other>,
    )

    yield (
        check,
        "bind(:Thing as ?type)",
        "type",
        <http://example.org/ns#Thing>,
    )
