# Verbatim copy of tests/data/rdf/cases/15_4.trig from
# ArangoDB-Community/ArangoRDF@48cfed903a: the graph the real test reads
# (conftest.py get_rdf_graph parses a .trig into a ConjunctiveGraph).
@prefix ex: <http://example.com/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# << ex:Mary ex:likes ex:Matt >> ex:certainty 0.5 .
# << ex:Mary ex:likes ex:Matt >> ex:certainty 0.75 .
# << ex:Mary ex:likes ex:Matt >> ex:certainty 1 .
# << ex:John ex:said << ex:Mary ex:likes ex:Matt >> >> ex:foo "bar" .

ex:Graph1 {
    ex:mary_likes_matt_05 a rdf:Statement;
        rdf:subject ex:Mary;
        rdf:predicate ex:likes;
        rdf:object ex:Matt;
        ex:certainty 0.5 .
}

ex:Graph2 {
    [] a rdf:Statement;
        rdf:subject ex:Mary;
        rdf:predicate ex:likes;
        rdf:object ex:Matt;
        ex:certainty 0.75 .

    [] a rdf:Statement;
        rdf:subject ex:John;
        rdf:predicate ex:said;
        rdf:object ex:mary_likes_matt_05;
        ex:foo "bar" .
}

[] a rdf:Statement;
        rdf:subject ex:Mary;
        rdf:predicate ex:likes;
        rdf:object ex:Matt;
        ex:certainty 1 .
