from time import time
from leveldb_shim import logging, URIRef  # context shim, see meta.json
log = logging.getLogger(__name__)
michel = <urn:michel>
likes = <urn:likes>
pizza = <urn:pizza>
graphuri = <urn:graph>

def testNamedGraphUpdateWithInitBindings(self):
    t0 = time()
    g = self.graph.get_context(graphuri)
    @graph g
    s{ INSERT { {michel} {likes} {pizza} } WHERE {} }.execute()
    self.assertEqual(
        set(g.triples((None, None, None))),
        set([(michel, likes, pizza)]),
        "only michel likes pizza",
    )
    t1 = time()
    log.debug(
        f"testNamedGraphUpdateWithInitBindings {self.store}: {t1 - t0:.5f}"
    )
