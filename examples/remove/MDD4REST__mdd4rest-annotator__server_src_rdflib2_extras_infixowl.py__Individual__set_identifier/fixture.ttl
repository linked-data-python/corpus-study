# The graph of an infixowl Individual whose identifier is renamed.
# ex:old is the node renamed in most calls: it has statements OUT (URI,
# plain / language / typed literals, a blank node, a statement about itself)
# and statements IN (from two URIs and from a blank node).
# ex:other and ex:neighbour must come out untouched.
@prefix ex: <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:old  a ex:Thing ;
        rdfs:label "old", "vieux"@fr ;
        ex:size "12"^^xsd:integer ;
        ex:partOf ex:whole ;
        ex:self ex:old ;
        ex:detail [ ex:note "blank detail" ] .

# ex:x has another ex:knows statement: removing (ex:x ex:knows ?) would take it too
ex:x     ex:knows ex:old, ex:other ; ex:partOf ex:old .
ex:old   ex:partOf ex:other .
ex:y     ex:knows ex:old ; ex:likes ex:old .
[]       ex:ref ex:old .

# the blank node that is itself an identifier in one call
ex:holder ex:has _:anon .
_:anon   ex:colour "red" ; ex:inside ex:whole .

# neighbours: share predicates and objects with ex:old, must not move
ex:other     a ex:Thing ; rdfs:label "other" ; ex:partOf ex:whole ; ex:knows ex:x .
ex:neighbour ex:knows ex:other ; ex:partOf ex:whole .
ex:whole     rdfs:label "whole" .
