@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix sdo: <https://schema.org/> .
@prefix oldsdo: <http://schema.org/> .
@prefix ex: <http://example.org/> .

# the three predicates the region rewrites
ex:onto1 dc:creator ex:alice , "Bob the Literal" .
ex:onto2 sdo:creator ex:carol .
ex:onto3 sdo:author ex:dave .
# the same object under two of the predicates
ex:onto4 dc:creator ex:erin ; sdo:author ex:erin ; sdo:creator ex:erin .
# neighbours that must NOT be touched
ex:onto5 dc:contributor ex:frank ;
         dcterms:creator ex:grace ;
         oldsdo:creator ex:heidi ;
         sdo:name "not an author" ;
         dc:title "title" .
ex:onto6 dcterms:creator ex:ivan .
ex:alice dc:creator ex:onto1 .
