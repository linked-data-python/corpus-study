# Extracted from MaxBerktoldRWTH/BRICKbuilder@28f0710933 : src/app/ifc_populate_window.py
# region: IfcBrickAnnotator.rebuild_output_graph (lines 484-550, stratum ns_def_local)
# licence of the source repository: see meta.json
import rdflib
from rdflib import Graph, Namespace, RDF
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

def rebuild_output_graph(self):
    """Clears and re-serializes components according to active configuration settings mapping definitions."""
    self.output_graph = Graph()

    # Consistent prefix generation definitions
    base_inst = self.settings.value("ns_inst", "http://example.org/project#")
    if not str(base_inst).endswith(('#', '/')):
        base_inst = str(base_inst) + '#'

    # Every prefix of this function is a DYNAMIC one — its IRI is a runtime
    # value (a Qt setting, an attribute of self) — so each is declared with a
    # formatted IRI, and `as` keeps the Namespace OBJECT, which the loops
    # below index by a runtime key (`ifc_inst_ns[data["eq_guid"]]`).
    @prefix brick:     f<{self.BRICK}> as _brick .
    @prefix ref:       f<{self.REF}> as _ref .
    @prefix ifcInst:   f<{base_inst}ifcInst:> as ifc_inst_ns .
    @prefix brickInst: f<{base_inst}brickInst:> as brick_inst_ns .
    @prefix bacnet:    <http://buildingsmart.org/bacnet#> as bacnet_ns .
    @prefix bldg:      f<{base_inst}bldg:> as bldg_ns .
    @prefix ifc:       f<{self.settings.value("ns_ifc", "http://standards.buildingsmart.org/IFC/RELEASE/IFC4/Ontology#")}> as ifc_core_ns .

    # The seven `self.output_graph.bind(...)` calls of the original are gone:
    # a graph DESIGNATED by `@graph` inherits the prefixes in scope at that
    # point (record ldpy/027), which is why the designation now follows the
    # declarations instead of preceding them.
    @graph self.output_graph

    # 2. Sequential structural iteration over individual items
    # add_in_loop (this region's second stratum): self.annotations_registry
    # is a dict of dicts (one row of fields per annotation), and `_key` was
    # never read in the original body -- iterating .values() drops exactly
    # that, nothing else. `.raw[...]`/`.raw.get(...)` read the fields the
    # same way `data[...]`/`data.get(...)` did (namespace-subscript keys,
    # a Python truthiness test, string munging: all need the raw value, not
    # an RDF term -- INSTRUCTIONS.md §2 bis on `b.raw`).
    for @bindings as data in self.annotations_registry.values():
        eq_uri = ifc_inst_ns[data.raw["eq_guid"]]
        ifc_type_name = data.raw["ifc_type"] if data.raw.get("ifc_type") else "IfcSensor"
        pt_uri = brick_inst_ns[data.raw["point_id"]]

        +{ {eq_uri} rdf:type {ifc_core_ns[ifc_type_name]} }

        # Link Brick point to physical asset -- two .add() sharing subject
        # pt_uri, fused per add_run_shared_subject's construction.
        +{
            {pt_uri} rdf:type {self.BRICK[data.raw["point_type"]]} ;
                     {self.BRICK.isPointOf} {eq_uri}
        }

        # 3. Handle BACnet nested blank node structures
        if data.raw.get("bacnet_name"):
            bacnet_bnode = rdflib.BNode()

            +{ {pt_uri} {self.REF.hasExternalReference} {bacnet_bnode} }

            raw_type = (
                str(data.raw.get("bacnet_type", ""))
                .lower()
                .replace("analoginput", "analog-input")
                .replace("analogvalue", "analog-value")
            )
            obj_id_string = f"{raw_type},{data.raw.get('bacnet_instance')}"

            # Four .add() sharing subject bacnet_bnode, fused the same way.
            # rdflib.Literal(obj_id_string, datatype=bacnet_ns.objectIdentifier)
            # is a typed literal whose text is computed -- the quoted part
            # must be an f-string (f"{obj_id_string}", not a bare
            # "{obj_id_string}") for `{expr}` to interpolate there.
            # rdflib.Literal(data.get("bacnet_name")) is exactly what
            # `?bacnet_name` (the current @bindings, coerced) already is: a
            # plain literal from the row's raw string.
            +{
                {bacnet_bnode} rdf:type {self.REF.BACnetReference} ;
                    {bacnet_ns["object-identifier"]} f"{obj_id_string}"^^{bacnet_ns.objectIdentifier} ;
                    {bacnet_ns["object-name"]} ?bacnet_name ;
                    {bacnet_ns["objectOf"]} {bldg_ns["sample-device"]}
            }
