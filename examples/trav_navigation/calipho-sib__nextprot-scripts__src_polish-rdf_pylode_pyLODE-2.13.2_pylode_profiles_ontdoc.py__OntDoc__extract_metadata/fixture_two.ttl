# Two ontologies in one graph: the loop runs twice, imports accumulate, the
# URI and the version info are those of the one visited last, and the title
# placeholder is only set for an ontology visited while no title is known.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sdo: <https://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix ex: <http://example.org/onto#> .

<http://example.org/first> a owl:Ontology ;
    owl:imports <http://example.org/a#> ;
    dcterms:title "First" ;
    owl:versionInfo "1" .
<http://example.org/second> a owl:Ontology ;
    owl:imports <http://example.org/b#> ;
    owl:versionInfo "2" .
