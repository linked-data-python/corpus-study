from rdflib import Graph

def createTriples():

    #Empty graph
    g = Graph()

    #Special namspaces to create  
    @prefix city: <http://www.example.org/university/london/city#> .
    @prefix dbpo: <http://dbpedia.org/ontology/> .
    @prefix foaf: <http://xmlns.com/foaf/0.1/> .
    @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
    @prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
    @prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

    #Prefixes (the designated graph inherits the block's prefixes)
    @graph g

    #These lines are equivalent:    
    #ernesto = URIRef("http://www.example.org/university/london/city#ernesto")
    #city.ernesto

    #print(city.ernesto)

    +{
        city:inm713 a city:Module .
        city:ernesto a city:Lecturer ;
            foaf:name "Ernesto Jimenez-Ruiz"^^xsd:string ;
            city:teaches city:inm713 .
        city:Lecturer rdfs:subClassOf foaf:Person .
        [ a rdf:Statement ;
            rdf:subject city:ernesto ;
            rdf:predicate city:teaches ;
            rdf:object city:inm713 ;
            dbpo:year "2024"^^xsd:gYear ] .
    }

    print("Saving graph to 'lab2_example_rdflib.ttl':")

    print(g.serialize(format="turtle"))    
    g.serialize(destination='./data/lab2_example_rdflib.ttl', format='ttl')
