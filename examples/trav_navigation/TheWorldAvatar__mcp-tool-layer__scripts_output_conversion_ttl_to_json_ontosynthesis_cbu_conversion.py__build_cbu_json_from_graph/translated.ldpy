@prefix ontomops: <https://www.theworldavatar.com/kg/ontomops/> .
@prefix ontosyn:  <https://www.theworldavatar.com/kg/OntoSyn/> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .

# Extracted from TheWorldAvatar/mcp-tool-layer@c440a33e08 : scripts/output_conversion_ttl_to_json/ontosynthesis_cbu_conversion.py
# region: build_cbu_json_from_graph (lines 287-377, stratum trav_navigation)
# licence of the source repository: see meta.json
#
# graph/mop_type_uri/procedures/direct_mops_found are restored from the
# enclosing function build_cbu_json_from_graph (the region extractor could
# not carry them: mop_type_uri lives above the region's own line range,
# line 280 of the real file; `procedures`/`direct_mops_found` are
# initialised at lines 276/286, just above; `graph` is the enclosing
# function's own parameter, so the region is itself a nested closure over
# it). The three helper closures the region calls (_is_guest_mop,
# _collect_input_aliases_for_mop, _augment_cbu_names) keep their real logic
# verbatim in mop_helpers.py (see that file's header) -- they read the same
# `graph` through m{ }-free, untouched rdflib calls, so they cannot diverge
# between the two sides. Graph/URIRef/RDFS/Literal from the original's
# import line are gone: nothing in this region's own body needs the raw
# rdflib names once every read is an island.
from mop_helpers import make_helpers

mop_type_uri = ontomops:MetalOrganicPolyhedron


def run(graph):
    @graph graph
    _is_guest_mop, _collect_input_aliases_for_mop, _augment_cbu_names = make_helpers(graph)
    procedures = []
    direct_mops_found = 0

    for mop in m{ ?mop rdf:type {mop_type_uri} }:
        print(f"Found MOP: {mop}")
        direct_mops_found += 1
        if _is_guest_mop(mop):
            continue
        ccdc_val = m{ {mop} ontomops:hasCCDCNumber ?v }.first()
        ccdc = str(ccdc_val) if ccdc_val else "N/A"

        if ccdc == "N/A":
            continue

        direct_mops_found += 1
        print(f"Found MOP {mop} with CCDC {ccdc}")

        aliases = _collect_input_aliases_for_mop(mop)

        # Get all CBUs for this MOP
        cbu_formulas = []
        cbu_names = []

        for cbu in m{ {mop} ontomops:hasChemicalBuildingUnit ?cbu }:
            # Get the formula -- kept as a materialised list (not .first()):
            # it is printed verbatim in the debug line below, and .first()
            # would silently change what that line prints (None vs [])
            # without changing anything the region actually computes.
            formula_vals = list(m{ {cbu} ontomops:hasCBUFormula ?v })
            formula = str(formula_vals[0]) if formula_vals else "N/A"

            print(f"Debug: CBU {cbu}, formula_vals: {formula_vals}, formula: {formula}")

            # Get names from labels
            names = []
            for label in m{ {cbu} rdfs:label ?v }:
                names.append(str(label))

            # Get alternative names - each should be a separate literal
            for alt_name_literal in m{ {cbu} ontosyn:hasAlternativeNames ?v }:
                alt_name_str = str(alt_name_literal).strip()
                # Remove surrounding quotes if present
                if alt_name_str.startswith('"') and alt_name_str.endswith('"'):
                    alt_name_str = alt_name_str[1:-1]
                if alt_name_str and alt_name_str not in names:
                    names.append(alt_name_str)

            # Get chemical formula if available
            for chem_formula in m{ {cbu} ontosyn:hasChemicalFormula ?v }:
                chem_formula_str = str(chem_formula).strip()
                if chem_formula_str and chem_formula_str not in names:
                    names.append(chem_formula_str)

            # Also check owl:sameAs links to chemical inputs for additional information
            for chem_input in m{ {cbu} owl:sameAs ?v }:
                # Additional labels from chemical inputs
                for ci_label in m{ {chem_input} rdfs:label ?v }:
                    ci_label_str = str(ci_label).strip()
                    if ci_label_str and ci_label_str not in names:
                        names.append(ci_label_str)

                # Alternative names from chemical inputs
                for ci_alt_literal in m{ {chem_input} ontosyn:hasAlternativeNames ?v }:
                    alt_name_str = str(ci_alt_literal).strip()
                    # Remove surrounding quotes if present
                    if alt_name_str.startswith('"') and alt_name_str.endswith('"'):
                        alt_name_str = alt_name_str[1:-1]
                    if alt_name_str and alt_name_str not in names:
                        names.append(alt_name_str)

                # Chemical formula from chemical inputs
                for ci_formula in m{ {chem_input} ontosyn:hasChemicalFormula ?v }:
                    ci_formula_str = str(ci_formula).strip()
                    if ci_formula_str and ci_formula_str not in names:
                        names.append(ci_formula_str)

            cbu_formulas.append(formula)
            cbu_names.append(names)

        # Sort CBUs by formula for consistency
        cbu_data = list(zip(cbu_formulas, cbu_names))
        cbu_data.sort(key=lambda x: x[0])

        if len(cbu_data) >= 1:
            cbu_data[0] = (cbu_data[0][0], _augment_cbu_names(cbu_data[0][0], cbu_data[0][1], aliases))
        if len(cbu_data) >= 2:
            cbu_data[1] = (cbu_data[1][0], _augment_cbu_names(cbu_data[1][0], cbu_data[1][1], aliases))

        entry = {
            "mopCCDCNumber": ccdc,
            "cbuFormula1": cbu_data[0][0] if len(cbu_data) > 0 else "N/A",
            "cbuSpeciesNames1": cbu_data[0][1] if len(cbu_data) > 0 else [],
            "cbuFormula2": cbu_data[1][0] if len(cbu_data) > 1 else "N/A",
            "cbuSpeciesNames2": cbu_data[1][1] if len(cbu_data) > 1 else [],
        }

        procedures.append(entry)

    return procedures
