#
# Test harness only (see meta.json): TestSocSciMapsMarcXmlToEDM.test_cho_language
# is a unittest.TestCase method that only asserts and returns None, and it
# needs `self.edm[ids].graph` and `self.cho[ids]` (bound in the real class's
# setUp, from the MARC conversion) and `self.assertEqual`.  driver.py supplies
# a real unittest.TestCase instance carrying them.  `demo` (identical on both
# sides) turns a failed assertion into a comparable value: the message of
# assertEqual shows the value the region read.
from rdflib import Literal, URIRef
@prefix dc: <http://purl.org/dc/elements/1.1/> .

def test_cho_language(self):
    """get dc:language from MARC to DC converter."""

    ids = '7641168,3451312'

    @graph self.edm[ids].graph
    self.assertEqual(
        m{ {self.cho[ids]} dc:language ?v }.first(),
        Literal('en')
    )


def demo(self) -> object:
    try:
        test_cho_language(self)
        return "ok"
    except AssertionError as e:
        return ("assertion-failed", str(e))
