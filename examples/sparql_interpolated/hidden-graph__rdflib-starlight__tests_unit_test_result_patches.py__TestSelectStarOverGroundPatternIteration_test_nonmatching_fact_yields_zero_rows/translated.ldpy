#
# Context restored (see meta.json): `_graph_with_one_fact()` comes from
# graph_shim.py, as in original.py.
#
# Translation note (see meta.json): the original builds its query text by
# splicing already-bracketed IRI syntax (`EX_A = "<http://example/a>"`)
# straight into an f-string -- not interpolating a DATA value in term
# position. `s{ }`'s `{expr}` holes are never textual substitution: they
# become an initBindings entry, coercing whatever Python value they see into
# an RDF term. Interpolating `{EX_A}` here would coerce the *string*
# "<http://example/a>" into a Literal, not the URIRef the bracket syntax
# denotes -- silently wrong for a query that is supposed to test ground-
# pattern matching. Since the three IRIs are compile-time constants, not
# data, the faithful reading is to write them directly as terms in the
# island; see translation_notes for what this loses.
from graph_shim import _graph_with_one_fact

def test_nonmatching_fact_yields_zero_rows(self) -> None:
    g = _graph_with_one_fact()
    r = s{ SELECT * WHERE { <http://example/a> <http://example/b> <http://example/nope> . } }(g).execute()
    assert list(r) == []
    assert r.bindings == []
    assert len(r) == 0
