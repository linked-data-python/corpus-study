# prov:wasGeneratedBy with no sdo:codeRepository to overwrite it: the repository
# is the one behind the generating activity. Another activity, not referred to
# by the ontology, has its own.
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sdo: <https://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix ex: <http://example.org/onto#> .

<http://example.org/gen-only> a owl:Ontology ;
    dcterms:title "Generated" ;
    prov:wasGeneratedBy <http://example.org/run> .
<http://example.org/run> doap:repository <http://example.org/run-repo> .
<http://example.org/other-run> doap:repository <http://example.org/decoy-repo> .
