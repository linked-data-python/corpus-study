@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex: <http://example.org/> .

# --- Shape1: URIRef sh:path, three sh:sparql children ----------------------
ex:Shape1 sh:path ex:hasName .

# 1a. a sh:sparql target with NO sh:select at all -- must be skipped
#     entirely (zero-solution .first() on sh:select).  Carries a
#     sh:message as neighbourhood noise that must never surface: it
#     is only read once select is known non-None.
ex:Shape1 sh:sparql ex:SparqlNoSelect .
ex:SparqlNoSelect sh:message "should never surface: no sh:select" .

# 1b. a sh:sparql target with sh:select + sh:message + TWO prefix
#     declarations under one sh:prefixes ontology -- exercises the nested
#     ontology -> declare loop with more than one declaration.
ex:Shape1 sh:sparql ex:SparqlFull .
ex:SparqlFull sh:select "SELECT ?this WHERE { ?this ex:p ex:o }" .
ex:SparqlFull sh:message "custom violation message" .
ex:SparqlFull sh:prefixes ex:Onto1 .
ex:Onto1 sh:declare ex:DeclEx, ex:DeclFoaf .
ex:DeclEx sh:prefix "ex" ; sh:namespace "http://example.org/" .
ex:DeclFoaf sh:prefix "foaf" ; sh:namespace "http://xmlns.com/foaf/0.1/" .

# 1c. a sh:sparql target with sh:select but NO sh:prefixes (prefixes must
#     come back "") and NO sh:message (row must have no "message" key at
#     all -- not even message=None).
ex:Shape1 sh:sparql ex:SparqlBare .
ex:SparqlBare sh:select "SELECT ?this WHERE { ?this a ex:C }" .

# --- Shape2: blank-node sh:path -> "path" must come back None, and the
# shape has NO sh:sparql children at all -> rows == [] ----------------------
ex:Shape2 sh:path _:seqPath .
_:seqPath rdf:first ex:step ;
          rdf:rest  rdf:nil .

# --- neighbourhood noise: another shape's own sh:sparql/prefixes must
# never leak into Shape1's or Shape2's rows ----------------------------------
ex:OtherShape sh:path ex:decoyPath .
ex:OtherShape sh:sparql ex:SparqlDecoy .
ex:SparqlDecoy sh:select "SELECT ?this WHERE { ?this ex:decoy ex:d }" .
ex:SparqlDecoy sh:prefixes ex:OntoDecoy .
ex:OntoDecoy sh:declare ex:DeclDecoy .
ex:DeclDecoy sh:prefix "decoy" ; sh:namespace "http://decoy.example/" .

# --- Added by the mutation audit of 2026-10-31 -------------------------------
# Shape3: a NODE shape (no sh:path at all, as _node_expansion passes it,
# shacl_ir.py:96) -- the zero-solution case of the `path` read, which kills
# `.one()` / `next(iter(...))` there; a decoy-first store order means a
# widened `[] sh:path ?o` would pick Shape1's path instead of None.  Its one
# sh:sparql child carries an EMPTY sh:select (falsy but not None: the row
# must be kept, `if not select` would drop it) and an EMPTY sh:message (the
# row must carry message "").  Its declarations: one with TWO sh:prefix and
# TWO sh:namespace values (rdflib's value() takes the first, `.one()` would
# raise) and one with no sh:namespace at all ("<None>" in the header).
ex:Shape3 sh:sparql ex:SparqlEdge .
ex:SparqlEdge sh:select "" ;
    sh:message "" ;
    sh:prefixes ex:Onto3 .
ex:Onto3 sh:declare ex:DeclTwo, ex:DeclNoNs .
ex:DeclTwo sh:prefix "a", "b" ;
    sh:namespace "http://a.example/", "http://b.example/" .
ex:DeclNoNs sh:prefix "nons" .

# Shape4: TWO sh:path IRIs (value() takes the first, `.one()` would raise),
# one sh:sparql child with TWO sh:select and TWO sh:message values.
ex:Shape4 sh:path ex:pathA, ex:pathB ;
    sh:sparql ex:SparqlTwo .
ex:SparqlTwo sh:select "SELECT ?this WHERE { ?this ex:a ex:b }",
                       "SELECT ?this WHERE { ?this ex:c ex:d }" ;
    sh:message "first message", "second message" .

# A BLANK-NODE property shape (the usual form of a sh:property, which
# _shape_rows hands to _sparql_rows, shacl_ir.py:53): the call fetches it
# with graph.value(ex:Holder, sh:property), so the region's subject is a
# BNode, as in the repository.
ex:Holder sh:property [
    sh:path ex:bnPath ;
    sh:sparql ex:SparqlBn
] .
ex:SparqlBn sh:select "SELECT ?this WHERE { ?this ex:bn ex:x }" .
