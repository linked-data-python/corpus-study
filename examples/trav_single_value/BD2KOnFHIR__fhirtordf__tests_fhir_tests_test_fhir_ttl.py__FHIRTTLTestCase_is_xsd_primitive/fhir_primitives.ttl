# Repository-shape input (mutation audit 2026-10-31): the 21 subjects of
# `rdfs:subClassOf fhir:Primitive` in BD2KOnFHIR/fhirtordf@05b23ba1df
# tests/data/fhir_metadata_vocabulary/fhir.ttl (the FHIR metadata
# vocabulary FHIRGraph loads for test_primitives), with every
# rdfs:subClassOf of theirs and the blank-node closure below it, extracted
# by rdflib and re-serialised unchanged (5 MB source, 168 triples kept).
# All use the someValuesFrom/onDatatype shape; fhir:integer64 is the
# FHIRCat #35 case reached through that fallback.
@prefix fhir: <http://hl7.org/fhir/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

fhir:base64Binary rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality 1 ;
            owl:onProperty fhir:value ;
            owl:someValuesFrom [ a rdfs:Datatype ;
                    owl:onDatatype xsd:base64Binary ] ],
        fhir:Primitive .

