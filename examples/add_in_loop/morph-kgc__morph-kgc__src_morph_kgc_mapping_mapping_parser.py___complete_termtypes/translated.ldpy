# Extracted from morph-kgc/morph-kgc@a2122e88bb : src/morph_kgc/mapping/mapping_parser.py
# region: _complete_termtypes (lines 231-291, stratum add_in_loop)
# licence of the source repository: see meta.json
import rdflib
from rml_constants import (
    RML_QUOTED_TRIPLES_MAP, RML_TERM_TYPE, RML_RDF_STAR_TRIPLE,
    RML_CONSTANT, RML_BLANK_NODE, RML_LITERAL, RML_OBJECT_MAP,
    RML_REFERENCE, RML_EXECUTION, RML_LANGUAGE_MAP, RML_DATATYPE_MAP,
    RML_PARENT_TRIPLES_MAP, RML_SUBJECT_MAP, RML_IRI,
    RML_PREDICATE_MAP, RML_GRAPH_MAP,
)

def _complete_termtypes(mapping_graph):
    """
    Completes term types of mapping rules that do not have rr:termType property as indicated in R2RML specification
    (https://www.w3.org/2001/sw/rdb2rdf/r2rml/#termtype).
    """
    @graph mapping_graph

    # add missing RDF-star triples termtypes (in the subject and object maps)
    for term_map, _ in s{ SELECT DISTINCT ?term_map ?quoted_triples_map WHERE {
            ?term_map {rdflib.term.URIRef(RML_QUOTED_TRIPLES_MAP)} ?quoted_triples_map .
            OPTIONAL { ?term_map {rdflib.term.URIRef(RML_TERM_TYPE)} ?termtype . } .
            FILTER ( !bound(?termtype) ) } }:
        +{ {term_map} {rdflib.term.URIRef(RML_TERM_TYPE)} {rdflib.term.URIRef(RML_RDF_STAR_TRIPLE)} }

    # add missing blanknode termtypes in the constant-valued object maps
    for term_map, _ in s{ SELECT DISTINCT ?term_map ?constant WHERE {
            ?term_map {rdflib.term.URIRef(RML_CONSTANT)} ?constant .
            OPTIONAL { ?term_map {rdflib.term.URIRef(RML_TERM_TYPE)} ?termtype . } .
            FILTER ( !bound(?termtype) && isBlank(?constant) ) } }:
        +{ {term_map} {rdflib.term.URIRef(RML_TERM_TYPE)} {rdflib.term.URIRef(RML_BLANK_NODE)} }

    # add missing literal termtypes in the constant-valued object maps
    for term_map, _ in s{ SELECT DISTINCT ?term_map ?constant WHERE {
            ?term_map {rdflib.term.URIRef(RML_CONSTANT)} ?constant .
            OPTIONAL { ?term_map {rdflib.term.URIRef(RML_TERM_TYPE)} ?termtype . } .
            FILTER ( !bound(?termtype) && isLiteral(?constant) ) } }:
        +{ {term_map} {rdflib.term.URIRef(RML_TERM_TYPE)} {rdflib.term.URIRef(RML_LITERAL)} }

    # add missing literal termtypes in the object maps
    for om, _ in s{ SELECT DISTINCT ?om ?pom WHERE {
            ?pom {rdflib.term.URIRef(RML_OBJECT_MAP)} ?om .
            OPTIONAL { ?om {rdflib.term.URIRef(RML_TERM_TYPE)} ?termtype . } .
            OPTIONAL { ?om {rdflib.term.URIRef(RML_REFERENCE)} ?reference . } .
            OPTIONAL { ?om {rdflib.term.URIRef(RML_EXECUTION)} ?execution . } .
            OPTIONAL { ?om {rdflib.term.URIRef(RML_LANGUAGE_MAP)} ?language . } .
            OPTIONAL { ?om {rdflib.term.URIRef(RML_DATATYPE_MAP)} ?datatype . } .
            FILTER ( !bound(?termtype) && (
            bound(?reference) || bound(?execution) || bound(?language) || bound(?datatype) ) ) } }:
        +{ {om} {rdflib.term.URIRef(RML_TERM_TYPE)} {rdflib.term.URIRef(RML_LITERAL)} }

    # complete referencing object maps with the termtype coming from the subject of the parent
    for term_map, termtype in s{ SELECT DISTINCT ?term_map ?termtype WHERE {
            ?term_map {rdflib.term.URIRef(RML_PARENT_TRIPLES_MAP)} ?parent_tm .
            ?parent_tm {rdflib.term.URIRef(RML_SUBJECT_MAP)} ?parent_subject_map .
            ?parent_subject_map {rdflib.term.URIRef(RML_TERM_TYPE)} ?termtype . } }:
        +{ {term_map} {rdflib.term.URIRef(RML_TERM_TYPE)} {rdflib.term.URIRef(termtype)} }

    # now all missing termtypes are IRIs
    for term_map_property in [RML_SUBJECT_MAP, RML_PREDICATE_MAP, RML_OBJECT_MAP, RML_GRAPH_MAP]:
        for term_map, _ in s{ SELECT DISTINCT ?term_map ?x WHERE {
                ?x {rdflib.term.URIRef(term_map_property)} ?term_map .
                OPTIONAL { ?term_map {rdflib.term.URIRef(RML_TERM_TYPE)} ?termtype . } .
                FILTER ( !bound(?termtype) ) } }:
            +{ {term_map} {rdflib.term.URIRef(RML_TERM_TYPE)} {rdflib.term.URIRef(RML_IRI)} }

    return mapping_graph
