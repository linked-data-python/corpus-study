from rdflib import Graph, Literal, URIRef, Namespace
from rdflib.namespace import RDF, RDFS, SDO
@prefix ssnextend: <https://w3id.org/tinyml-schema/neural-network-schema/ssn_extend/> .
@prefix sosaextend: <https://w3id.org/tinyml-schema/neural-network-schema/sosa_extend/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sdo: <https://schema.org/> .

g = Graph()

for i, value in enumerate(sensor_list_):
    sensorOfNN = URIRef("https://w3id.org/tinyml-schema/neural-network-schema/neuralnetwork/sensor" + "_" + "{}".format(i + 1) + "_" + idOfNN)
    g += g{
        {sensorOfNN} a {addHardware(value)} ;
           a sdo:Sensor ;
           sosaextend:hasSensorInfo {Literal(sensor_info_)} ;
           ssnextend:provideInput {inputOfNN}
    }
