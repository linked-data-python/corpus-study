from rdflib import Graph, Namespace, Literal, URIRef, BNode
from rdflib.namespace import OWL, RDF, RDFS
import lib.utils as utils
from lib.utils import RdfUtils, nodeId_to_iri
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


def add_nodeid_to_class(self, node, nodeclasstype, xml_ns):
    nid, index, bn_name, bn_index, idtype = self.get_nid_ns_and_name(node)
    rdf_namespace = self.get_rdf_ns_from_ua_index(index)
    bn_namespace = self.get_rdf_ns_from_ua_index(bn_index)
    classiri = nodeId_to_iri(rdf_namespace, self.rdf_ns['base'], nid, idtype)
    self.g += g{
        {classiri} {self.rdf_ns['base']['hasNodeId']} {Literal(nid)} ;
           {self.rdf_ns['base']['hasIdentifierType']} {idtype} ;
           {self.rdf_ns['base']['hasBrowseName']} {Literal(bn_name)} ;
           {self.rdf_ns['base']['hasBrowseNameNamespace']} {self.known_ns_classes[str(utils.normalize_namespaceuri(bn_namespace))]}
    }
    namespace = self.opcua_ns[index]
    self.g += g{
        {classiri} {self.rdf_ns['base']['hasNamespace']} {self.known_ns_classes[str(utils.normalize_namespaceuri(namespace))]} ;
           a {self.rdf_ns['opcua'][nodeclasstype]}
    }
    self.nodeIds[index][nid] = classiri
    displayname_node = node.find('opcua:DisplayName', xml_ns)
    self.g += g{ {classiri} {self.rdf_ns['base']['hasDisplayName']} {Literal(displayname_node.text)} }
    symbolic_name = node.get('SymbolicName')
    if symbolic_name is not None:
        self.g += g{ {classiri} {self.rdf_ns['base']['hasSymbolicName']} {Literal(symbolic_name)} }
    description_node = node.find('opcua:Description', xml_ns)
    if description_node is not None:
        description = description_node.text
        self.g += g{ {classiri} {self.rdf_ns['base']['hasDescription']} {Literal(description)} }
    isSymmetric = node.get('Symmetric')
    if isSymmetric is not None:
        self.g += g{ {classiri} {self.rdf_ns['base']['isSymmetric']} {Literal(isSymmetric)} }
    minimum_sampling_interval = node.get('MinimumSamplingInterval')
    if minimum_sampling_interval is not None:
        self.g += g{ {classiri} {self.rdf_ns['base']['hasMinimumSamplingInterval']} {Literal(float(minimum_sampling_interval))} }

    historizing = node.get('Historizing')
    if historizing is not None:
        self.g += g{ {classiri} {self.rdf_ns['base']['isHistorizing']} {Literal(bool(historizing))} }
    return rdf_namespace, classiri
