def test_update_insert_data(backend):
    backend.update(
        s{ INSERT DATA { <http://example.org/s> <http://example.org/p> "v" } }
    )
    result = backend.query(s{ CONSTRUCT { ?s ?p ?o } WHERE { ?s ?p ?o } })
    assert len(result) == 1
