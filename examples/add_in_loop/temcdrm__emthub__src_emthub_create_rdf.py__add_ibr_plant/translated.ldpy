import rdflib
from context_shim import g, d, dll, dllID, seq, CIM, get_dll_cim_parameter_kind
EMT_NS = 'http://opensource.ieee.org/emtiop01v01#'
@prefix emt: <http://opensource.ieee.org/emtiop01v01#> .
@prefix cim: <http://www.ucaiug.org/grid18v15#> .

@graph g
for parm in d['ParametersInfo']:
  kind = get_dll_cim_parameter_kind (parm['DataType'])
  val = str(parm['DefaultValue'])
  #print (seq, kind, val)
  ptID = dllID+'_{:d}'.format(seq)
  pt = f<{ptID}>
  +{ {pt} a emt:IEEECigreDLLParameter ;
          emt:IEEECigreDLLParameter.IEEECigreDLL {dll} ;
          emt:IEEECigreDLLParameter.dllSequenceNumber {seq}^^cim:Integer ;
          emt:IEEECigreDLLParameter.value {val}^^cim:String ;
          emt:IEEECigreDLLParameter.dllParameterKind emt:{'IEEECigreDLLParameterKind.{:s}'.format(kind)} }
  # make an info class
  infID = ptID + '_info'
  inf = f<{infID}>
  +{ {pt} emt:IEEECigreDLLParameter.IEEECigreDLLParameterInfo {inf} .
     {inf} a emt:IEEECigreDLLParameterInfo ;
           emt:IEEECigreDLLParameterInfo.dllName {parm['Name']}^^cim:String ;
           emt:IEEECigreDLLParameterInfo.dllGroupName {parm['GroupName']}^^cim:String ;
           emt:IEEECigreDLLParameterInfo.dllDescription {parm['Description']}^^cim:String ;
           emt:IEEECigreDLLParameterInfo.dllUnit {parm['Unit']}^^cim:String ;
           emt:IEEECigreDLLParameterInfo.dllDefaultValue {str(parm['DefaultValue'])}^^cim:String ;
           emt:IEEECigreDLLParameterInfo.dllMinValue {str(parm['MinValue'])}^^cim:String ;
           emt:IEEECigreDLLParameterInfo.dllMaxValue {str(parm['MaxValue'])}^^cim:String }
  bFixed = False
  if parm['FixedValue'] != 0:
    bFixed = True
  +{ {inf} emt:IEEECigreDLLParameterInfo.dllFixedValue {bFixed}^^cim:Boolean }
  seq += 1
