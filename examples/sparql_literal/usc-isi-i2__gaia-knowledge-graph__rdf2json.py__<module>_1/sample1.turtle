# Fixture graph for usc-isi-i2__gaia-knowledge-graph__rdf2json.py__<module>_1
# — written during translation. Covers: several reified statements matched by
# the query's pattern (several solutions, two encodings of a "statement": an
# explicit rdf:Statement with rdf:predicate, and a node whose own rdf:type is
# the predicate), and neighbouring triples that must NOT match (a plain
# triple with no reification, and an rdf:Statement missing rdf:object so it
# stays outside both UNION branches).
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex: <http://example.org/> .

_:st1 a rdf:Statement ;
    rdf:predicate ex:worksFor ;
    rdf:subject ex:alice ;
    rdf:object ex:acme .

_:st2 a ex:locatedIn ;
    rdf:subject ex:acme ;
    rdf:object ex:springfield .

_:st3 a rdf:Statement ;
    rdf:predicate ex:hasRole ;
    rdf:subject ex:alice ;
    rdf:object ex:manager .

# neighbouring triples that must not contribute a solution
ex:alice ex:name "Alice" .

_:incomplete a rdf:Statement ;
    rdf:predicate ex:hasRole ;
    rdf:subject ex:bob .

# Added at repair (2026-10-30), each one aimed at a part of the query that the
# nodes above did not pin down:
# - carries the reification triples but has no rdf:type at all: matches
#   nothing, so dropping the `?s rdf:type rdf:Statement` anchor shows;
_:untyped rdf:predicate ex:knows ;
    rdf:subject ex:carol ;
    rdf:object ex:dave .

# - linked to rdf:Statement by another predicate than rdf:type: matches
#   nothing, so widening rdf:type into a variable shows;
_:otherlink ex:kind rdf:Statement ;
    rdf:predicate ex:likes ;
    rdf:subject ex:carol ;
    rdf:object ex:erin .

# - typed with something other than rdf:Statement AND carrying rdf:predicate:
#   only the second UNION branch matches (pred = ex:Claim, not ex:says), so
#   widening the object rdf:Statement into a variable shows;
_:claim a ex:Claim ;
    rdf:predicate ex:says ;
    rdf:subject ex:dave ;
    rdf:object ex:frank .

# - a second statement node giving the same (sub, pred, obj) as _:st1: DISTINCT
#   keeps a single ex:acme in alice's worksFor list.
_:st1dup a rdf:Statement ;
    rdf:predicate ex:worksFor ;
    rdf:subject ex:alice ;
    rdf:object ex:acme .
