import pandas as pd
from rdflib import Graph, RDF, RDFS, URIRef, Literal, XSD
@prefix owl: <http://www.w3.org/2002/07/owl> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

base_domain = "https://purl.archive.org/purl/net/poi_sardegna_sicilia/risorse"
dbpedia = "http://dbpedia.org/resource/"
cis = Namespace(cis_link)
clvapit = Namespace(clvapit_link)
geo = Namespace(geo_link)

def add_poi_data(csv, g):
    data_frame = pd.read_csv(csv, encoding="utf-8")
    institutes = retrieve_institutes()
    for _, row in data_frame.iterrows():
        region_uri = URIRef(base_domain + "/regioni/" + row["Regione"].lower())
        city_uri = URIRef(base_domain + "/comuni/" + our_urify_string(urify_string(row["Comune"])))
        address_uri = URIRef(base_domain + "/indirizzi/" + our_urify_string(urify_string(row["Indirizzo"])))
        site_uri = URIRef(base_domain + "/sedi/" + our_urify_string(urify_string(row["Denominazione"] + "_" + row["Contatti"] + "_" + row["Indirizzo"] + "_SITE")))
        cultural_institute_uri = URIRef(base_domain + "/poi/cultural_institute/" + our_urify_string(urify_string(row["Denominazione"] + "_" + row["Contatti"] + "_" + row["Indirizzo"]+ "_INSTITUTE")))
        contact_point_uri = URIRef(base_domain + "/punti_contattabili/" + our_urify_string(urify_string(row["Denominazione"] + "_" + row["Contatti"] + "_" + row["Indirizzo"] + "_CONTACTS")))
        price_specification_uri = URIRef(base_domain + "/specifiche_prezzo/" + our_urify_string(urify_string(row["Denominazione"] + "_" + row["Contatti"] + "_" +  row["Indirizzo"] + "_PRICESPEC")))
        offer_uri = URIRef(base_domain + "/offerte/" + our_urify_string(urify_string(row["Denominazione"] + row["Contatti"] + row["Indirizzo"] + "_OFFER")))
        ticket_uri = URIRef(base_domain + "/biglietti/" + our_urify_string(urify_string(row["Denominazione"] + row["Contatti"] + row["Indirizzo"] + "_TICKET")))

        g += g{
            {region_uri} a {clvapit.Region} ;
               rdfs:label {Literal(row["Regione"], datatype=XSD.string)} ;
               owl:sameAs {URIRef(dbpedia + row["Regione"])}
        }

        if ((city_uri, rdf:type, clvapit.City)) not in g:
            g += g{
                {city_uri} a {clvapit.City} ;
                   rdfs:label {Literal(row["Comune"], datatype=XSD.string)}
            }
            #Interlinking with DBPedia
            if is_city(urify_string(row["Comune"])) == True:
                g += g{ {city_uri} owl:sameAs {URIRef(dbpedia + urify_string(row["Comune"]))} }
            elif row["Regione"] == "Sardegna" and is_city(urify_string(row["Comune"]) + ",_Sardinia") == True:
                g += g{ {city_uri} owl:sameAs {URIRef(dbpedia + urify_string(row["Comune"]) + ",_Sardinia")} }
            elif row["Regione"] == "Sicilia" and is_city(urify_string(row["Comune"]) + ",_Sicily") == True:
                g += g{ {city_uri} owl:sameAs {URIRef(dbpedia + urify_string(row["Comune"]) + ",_Sicily")} }

        g += g{
            {address_uri} a {clvapit.Address} ;
               {clvapit.hasRegion} {region_uri} ;
               {clvapit.hasCity} {city_uri} .
            {contact_point_uri} a {cis.ContactPoint} ;
               rdfs:label {Literal("Contatti: " + row["Denominazione"], datatype=XSD.string)}
        }
        if row["Contatti"] != "NON REGISTRATO":
            contatti = row["Contatti"].split("//")
            for contatto in contatti:
                g += g{ {contact_point_uri} {cis.hasTelephone} {URIRef(base_domain + "/contatti/" + contatto)} }

        g += g{
            {site_uri} a {cis.Site} ;
               {cis.isSiteOf} {cultural_institute_uri} ;
               {cis.hasAddress} {address_uri} ;
               {cis.hasContactPoint} {contact_point_uri} .
            {cultural_institute_uri} a {cis.CulturalInstituteOrSite} ;
               rdfs:label {Literal("Istituto della cultura: " + row["Denominazione"], datatype=XSD.string)} ;
               {cis.hasSite} {site_uri} ;
               {cis.institutionalName} {Literal(row["Denominazione"], datatype=XSD.string)} ;
               {cis.hasContactPoint} {contact_point_uri} ;
               {cis.hasTicket} {ticket_uri} ;
               {geo.lat} {Literal(row["Latitudine"], datatype=XSD.float)} ;
               {geo.long} {Literal(row["Longitudine"], datatype=XSD.float)}
        }
        if row["Categoria"] == "museo, galleria, raccolta":
            g += g{ {cultural_institute_uri} {cis.hasCISType} {cis.Museum} }
        elif row["Categoria"] == "area o parco archeologico":
            g += g{ {cultural_institute_uri} {cis.hasCISType} {cis.ArchaeologicalArea} }
        else:
            g += g{ {cultural_institute_uri} {cis.hasCISType} {cis.MonumentalArea} }

        #Interlinking with MiC catalogue
        if institutes != False:
            for hit in institutes["results"]["bindings"]:
                if hit["l"]["value"] == row["Denominazione"]:
                    g += g{ {cultural_institute_uri} owl:sameAs {URIRef(hit["i"]["value"])} }

        g += g{
            {price_specification_uri} a {cis.PriceSpecification} ;
               {cis.hasCurrency} {cis.Euro} ;
               {cis.hasCurrencyValue} {Literal(row["Prezzo"], datatype=XSD.float)} .
            {ticket_uri} a {cis.Ticket} ;
               rdfs:label {Literal("Biglietto intero per accedere a: " + row["Denominazione"], datatype=XSD.string)} ;
               {cis.forAccessTo} {cultural_institute_uri} .
            {offer_uri} a {cis.Offer} ;
               {cis.hasPriceSpecification} {price_specification_uri} ;
               {cis.includes} {ticket_uri}
        }
    #Interlinkng particular cities
    g += g{
        {URIRef(base_domain + "/luoghi/" + urify_string("Siracusa"))} owl:sameAs {URIRef(dbpedia + "Syracuse,_Sicily")} .
        {URIRef(base_domain + "/luoghi/" + urify_string("Campobello di Mazara"))} owl:sameAs {URIRef(dbpedia + urify_string("Campobello di Mazara"))}
    }

    return g
