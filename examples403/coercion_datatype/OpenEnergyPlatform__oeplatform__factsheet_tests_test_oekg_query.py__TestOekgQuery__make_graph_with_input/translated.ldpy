from rdflib import RDF, Graph, Literal, URIRef
from factsheet.oekg import namespaces
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .


def _make_graph_with_input(self, table_iri_literal: str):
    g = Graph()
    bundle = <https://oekg.test/bundle1>
    scenario = <https://oekg.test/scenario/A>
    input_ds = <https://oekg.test/dataset/in1>

    g += g{
        {bundle} a {namespaces.OEO.OEO_00020227} ;
           {namespaces.OBO.BFO_0000051} {scenario} .
        {scenario} {namespaces.OEO.OEO_00020437} {input_ds} .
        {input_ds} {namespaces.OEO.OEO_00390094} {Literal(table_iri_literal)}
    }
    return g, bundle, scenario
