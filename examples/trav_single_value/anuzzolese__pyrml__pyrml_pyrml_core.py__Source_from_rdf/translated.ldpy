from rdflib import URIRef, Graph, IdentifiedNode
from rdflib.namespace import RDF, Namespace, XSD
from rdflib.term import Node, BNode, Literal, Identifier, URIRef, _is_valid_langtag, _castPythonToLiteral, _castLexicalToPython
from context_shim import rml_vocab, Source, SQLSource  # see meta.json: context shim


@staticmethod
def from_rdf(g: Graph, parent: IdentifiedNode) -> 'Source':
    term_maps = []
    sources = g.objects(parent, rml_vocab.RML_NS.source, True)

    for source in sources:

        sourcetype = None

        if isinstance(source, Literal):
            sourcetype = Literal('plain')
        elif m{ {source} {rml_vocab.CSVW_NS.url} ?v }(g).first():
            sourcetype = Literal('table')
        elif m{ {source} {rml_vocab.SD_NS.endpoint} ?v }(g).first():
            sourcetype = Literal('sparql')
        elif m{ {source} {rml_vocab.D2RQ_NS.jdbcDSN} ?v }(g).first():
            sourcetype = Literal('sql')
        else:
            # NOT translated to m{ }.first(): the 4th positional argument
            # here is g.value's `default` parameter (subject, predicate,
            # object, default, any), not a `unique`/`any` flag -- a bug in
            # the source (it means g.value(..., default=True), so an
            # unmatched pattern returns True, not None) that m{ }.first()
            # cannot reproduce (it has no `default=`). Preserved verbatim
            # so both sides keep the same buggy behaviour.
            db = g.value(None, RDF.type, rml_vocab.D2RQ_NS.Database, True)
            if db:
                return [SQLSource.from_rdf(g, db)]

        if sourcetype:
            term_maps.append(Source.__build(g, parent, source, sourcetype))

    return term_maps
