from rdflib import Graph
from rdflib import URIRef, BNode, Literal
from rdflib import Namespace
from rdflib.namespace import OWL, RDF, RDFS, FOAF, XSD
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


def Solution_Task2_3():

    #Empty graph
    g = Graph()

    #Special namspaces to create
    #The URI created for city is new created as example   
    city = Namespace("http://www.example.org/university/london/city#")

    #These URI namespaces exists in the DBPedia KG
    dbo = Namespace("http://dbpedia.org/ontology/")
    dbp = Namespace("http://dbpedia.org/property/")
    dbr = Namespace("http://dbpedia.org/resource/")

    #Prefixes
    g.bind("foaf", FOAF) #FOAF is given as default rdflib Namespace
    g.bind("city", city) #city is a newly created rdflib Namespace
    g.bind("dbo", dbo) #dbo is a newly created rdflib Namespace
    g.bind("dbp", dbp) #dbp is a newly created rdflib Namespace
    g.bind("dbr", dbr) #dbr is a newly created rdflib Namespace 

    #These lines are equivalent:    
    #ernesto = <http://www.example.org/university/london/city#ernesto>
    #city.ernesto

    #print(city.ernesto)

    bnode1 = BNode()  # a GUID is generated
    bnode2 = BNode()

    #We define literals
    family_name = Literal('Jiménez-Ruiz', datatype=xsd:string)  # lang="en" for language tags
    name = Literal('Ernesto', datatype=xsd:string)
    year = Literal('2024', datatype=xsd:gYear)  # lang="en" for language tags
    date = Literal('2019-09-23T00:00:00', datatype=xsd:Date)

    #The "," gives problems otherwise if added as dbr.City,_University_of_London
    city_university = <http://dbpedia.org/resource/City,_University_of_London>

    g += g{
        {city.inm713} a {city.Module} .
        {city.ernesto} a foaf:Person ;
           foaf:familyName {family_name} ;
           foaf:givenName {name} ;
           {city.speaks} {dbr.Spanish_language} ;
           {city.speaks} {dbr.Italian_language} ;
           {city.speaks} {dbr.English_language} ;
           {dbo.birthPlace} {dbr.Castellón_de_la_Plana} ;
           {dbo.nationality} {dbr.Spain} ;
           {city.teaches} {city.inm713} .
        {bnode1} a rdf:Statement ;
           rdf:subject {city.ernesto} ;
           rdf:predicate {city.teaches} ;
           rdf:object {city.inm713} ;
           {dbo.year} {year} .
        {city.ernesto} {dbp.employer} {city_university} .
        {bnode2} a rdf:Statement ;
           rdf:subject {city.ernesto} ;
           rdf:predicate {dbp.employer} ;
           rdf:object {city_university} ;
           {dbo.startDate} {date}
    }

    print("Saving graph to 'Solution_Task2.3_rdflib.ttl':")

    #print(g.serialize(format="turtle").decode("utf-8"))    
    g.serialize(destination='Solution_Task2.3_rdflib.ttl', format='ttl')
