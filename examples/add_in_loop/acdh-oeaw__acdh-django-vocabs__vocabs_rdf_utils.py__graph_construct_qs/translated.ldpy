if obj.has_notes.all():
    for note in obj.has_notes.all():
        if note.note_type == 'note':
            g += g{ {concept} skos:note {Literal(note.name, lang=note.language)} }
        elif note.note_type == 'scopeNote':
            g += g{ {concept} skos:scopeNote {Literal(note.name, lang=note.language)} }
        elif note.note_type == 'changeNote':
            g += g{ {concept} skos:changeNote {Literal(note.name, lang=note.language)} }
        elif note.note_type == 'editorialNote':
            g += g{ {concept} skos:editorialNote {Literal(note.name, lang=note.language)} }
        elif note.note_type == 'historyNote':
            g += g{ {concept} skos:historyNote {Literal(note.name, lang=note.language)} }
        elif note.note_type == 'definition':
            g += g{ {concept} skos:definition {Literal(note.name, lang=note.language)} }
        elif note.note_type == 'example':
            g += g{ {concept} skos:example {Literal(note.name, lang=note.language)} }
        else:
            g += g{ {concept} skos:note {Literal(note.name, lang=note.language)} }
