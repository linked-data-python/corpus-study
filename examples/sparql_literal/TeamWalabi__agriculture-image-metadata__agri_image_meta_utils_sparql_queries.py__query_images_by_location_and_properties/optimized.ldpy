from rdflib import Graph
@prefix agimage: <https://w3id.org/agri-image/> .
@prefix exif: <http://www.w3.org/2003/12/exif/ns#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

g = Graph().parse("fixture.ttl")
results = s{ SELECT ?image ?imageName ?imageNumber ?baseX ?baseY ?baseZ
                    ?serialNumber ?fieldID ?platformID ?plotID
             WHERE {
                 ?image a agimage:Image ; agimage:imageName ?imageName .
                 OPTIONAL { ?image agimage:imageNumber ?imageNumber }
                 OPTIONAL { ?image exif:SerialNumber ?serialNumber }
                 OPTIONAL { ?image agimage:fieldID ?fieldID }
                 OPTIONAL { ?image agimage:platformID ?platformID }
                 OPTIONAL { ?image agimage:plotID ?plotID }
                 OPTIONAL {
                     ?image agimage:baseXYZ [ rdf:first ?baseX ;
                         rdf:rest [ rdf:first ?baseY ; rdf:rest [ rdf:first ?baseZ ] ] ]
                 }
             }
             ORDER BY ?imageName }(g)
# Appended for the driver (see meta.json): a bare rdflib Result / lazy match
# is not something run_pair's module-state comparison can judge equal
# (rdfeval.harness._comparable), so both sides also materialise the rows
# actually produced. Identical on both sides.
rows = [tuple(r) for r in results]
