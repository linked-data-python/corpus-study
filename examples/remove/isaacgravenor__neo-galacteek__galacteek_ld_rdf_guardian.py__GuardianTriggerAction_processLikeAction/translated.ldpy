from rdflib import Graph
from rdflib import URIRef

async def processLikeAction(self, src: Graph, dst: Graph, s, p, o):
    lpred = <ips://galacteek.ld/likes>

    liked = src.value(
        subject=s,
        predicate=<ips://galacteek.ld/object>
    )
    agent = src.value(
        subject=s,
        predicate=<ips://galacteek.ld/agent>
    )

    # Like it or not, you'll only ever like it once
    dst.remove((
        agent,
        lpred,
        liked
    ))

    dst += g{ {agent} {lpred} {liked} }
