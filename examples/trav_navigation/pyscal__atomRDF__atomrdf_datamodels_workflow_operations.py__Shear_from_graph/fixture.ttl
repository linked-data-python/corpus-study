# Input graph for Shear.from_graph (atomRDF).  Each ex:actN is one call.
@prefix ex: <http://example.org/> .
@prefix cmso: <http://purls.helmholtz-metadaten.de/cmso/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# act1: complete shear (sample, vector, plane with normal vector and distance)
ex:out1 prov:wasGeneratedBy ex:act1 ; prov:wasDerivedFrom ex:in1 .
ex:act1 cmso:hasVector ex:vec1 ; cmso:hasPlane ex:plane1 .
ex:vec1 cmso:hasComponent_x "1.0"^^xsd:float ; cmso:hasComponent_y "2.0"^^xsd:float ; cmso:hasComponent_z "3.0"^^xsd:float .
ex:plane1 cmso:hasNormalVector ex:nv1 ; cmso:hasDistanceFromOrigin "4.5"^^xsd:float .
ex:nv1 cmso:hasComponent_x "0.0"^^xsd:float ; cmso:hasComponent_y "1.0"^^xsd:float ; cmso:hasComponent_z "0.0"^^xsd:float .

# act2: an output with no wasDerivedFrom; no vector; a plane with a distance
# but no normal vector
ex:out2 prov:wasGeneratedBy ex:act2 .
ex:act2 cmso:hasPlane ex:plane2 .
ex:plane2 cmso:hasDistanceFromOrigin "7"^^xsd:integer .

# act3: nothing generated by it, no vector, no plane (every read is empty)
ex:act3 a ex:Activity .

# act4: a plane with a normal vector but no distance; the vector has an
# extra component and a neighbour of the wrong kind
ex:out4 prov:wasGeneratedBy ex:act4 ; prov:wasDerivedFrom ex:in4 .
ex:act4 cmso:hasPlane ex:plane4 ; cmso:hasVector ex:vec4 .
ex:vec4 cmso:hasComponent_x "-1.5"^^xsd:float ; cmso:hasComponent_y "0.5"^^xsd:float ;
        cmso:hasComponent_z "9.25"^^xsd:float ; cmso:hasComponent_w "99"^^xsd:float .
ex:plane4 cmso:hasNormalVector ex:nv4 .
ex:nv4 cmso:hasComponent_x "5"^^xsd:integer ; cmso:hasComponent_y "6"^^xsd:integer ; cmso:hasComponent_z "7"^^xsd:integer .

# act5: a vector without hasComponent_y (the region raises on y.toPython())
ex:act5 cmso:hasVector ex:vec5 .
ex:vec5 cmso:hasComponent_x "1"^^xsd:float ; cmso:hasComponent_z "3"^^xsd:float .

# act6: a normal vector without hasComponent_z (raises on the normal path)
ex:out6 prov:wasGeneratedBy ex:act6 .
ex:act6 cmso:hasPlane ex:plane6 .
ex:plane6 cmso:hasNormalVector ex:nv6 ; cmso:hasDistanceFromOrigin "1"^^xsd:float .
ex:nv6 cmso:hasComponent_x "1"^^xsd:float ; cmso:hasComponent_y "1"^^xsd:float .

# act7: two vectors (the loop breaks after the first one) and two samples
# generated by the same activity (next(...) takes the first)
ex:out7a prov:wasGeneratedBy ex:act7 ; prov:wasDerivedFrom ex:in7a .
ex:out7b prov:wasGeneratedBy ex:act7 ; prov:wasDerivedFrom ex:in7b .
ex:act7 cmso:hasVector ex:vec7a , ex:vec7b .
ex:vec7a cmso:hasComponent_x "1"^^xsd:float ; cmso:hasComponent_y "1"^^xsd:float ; cmso:hasComponent_z "1"^^xsd:float .
ex:vec7b cmso:hasComponent_x "2"^^xsd:float ; cmso:hasComponent_y "2"^^xsd:float ; cmso:hasComponent_z "2"^^xsd:float .

# neighbours that must NOT match: the same predicates in the wrong direction
# or on another subject
ex:act1 prov:wasGeneratedBy ex:wrongdirection .
ex:wrongdirection prov:wasDerivedFrom ex:neverread .
ex:vec1 cmso:hasVector ex:act3 .
ex:plane1 cmso:hasPlane ex:act3 .
ex:otheract cmso:hasVector ex:vecX ; cmso:hasPlane ex:planeX .
ex:vecX cmso:hasComponent_x "100"^^xsd:float ; cmso:hasComponent_y "100"^^xsd:float ; cmso:hasComponent_z "100"^^xsd:float .
ex:planeX cmso:hasDistanceFromOrigin "100"^^xsd:float .
ex:outX prov:wasGeneratedBy ex:otheract ; prov:wasDerivedFrom ex:inX .
