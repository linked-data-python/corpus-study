from rdflib.namespace import OWL, XMLNS, XSD, RDF, RDFS
from rdflib import URIRef, BNode, Literal
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xmlns: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

prefixes = {}

def triplify(df):
    kg = Initial_KG()
    for idx, row in df.iterrows():
        # get attributes
        facility = get_attributes(row)
        # get iris
        iris = get_iris(facility)
        #print(iris)

        #facility
        kg += g{
            {iris['facility']} {prefixes['us_sdwis']['partOf']} {iris['PWS']} ;
               a {prefixes['us_sdwis']['PWS-SubFeature']} ;
               rdfs:label {Literal(facility['PWSID']+": "+facility['Facility_Id'], datatype=XSD.string)} ;
               {prefixes['us_sdwis']['hasFacilityId']} {Literal(facility['Facility_Id'], datatype=XSD.string)}
        }
        if 'State_Id' in facility.keys():
                kg += g{ {iris['facility']} {prefixes['us_sdwis']['hasStateFacilityId']} {Literal(facility['State_Id'], datatype=XSD.string)} }
        kg += g{ {iris['facility']} {prefixes['us_sdwis']['hasType']} {iris['type']} }
        if 'SourceType' in facility.keys():
            kg += g{ {iris['facility']} {prefixes['us_sdwis']['sourceType']} {iris['sourceType']} }

        #pws
        kg += g{
            {iris['PWS']} a {prefixes['us_sdwis']['PublicWaterSystem']} ;
               {prefixes['us_sdwis']['hasPart']} {iris['facility']}
        }
        if 'Source' in facility.keys():
            if 'Seller_PWSID' in facility.keys():
                #if source is just a connection to another system, make the connection directly 
                kg += g{
                    {iris['PWS']} {prefixes['us_sdwis']['buysFrom']} {iris['seller_PWS']} .
                    {iris['seller_PWS']} {prefixes['us_sdwis']['sellsTo']} {iris['PWS']} .
                    {iris['facility']} {prefixes['us_sdwis']['connectsTo']} {iris['seller_PWS']}
                }

            elif facility['Type'] in ['IG', 'IN', 'RC', 'RS', 'SP', 'WL']: #only count sources that are SW/GW types
                #find permanent (active) sources
                if facility['Availability']=='P': #note some of these may be inactive
                    kg += g{
                        {iris['PWS']} {prefixes['us_sdwis']['hasPermanentSource']} {iris['facility']} .
                        {iris['facility']} {prefixes['us_sdwis']['permanentSourceFor']} {iris['PWS']}
                    }
                else:
                    #TODO this could be expanded to specify other types (Emergency, interim, seasonal, other, unknown)
                    kg += g{
                        {iris['PWS']} {prefixes['us_sdwis']['hasSource']} {iris['facility']} .
                        {iris['facility']} {prefixes['us_sdwis']['sourceFor']} {iris['PWS']}
                    }



    return kg
