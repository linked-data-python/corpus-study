from rdflib import Graph, URIRef
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


def _generate_mem_profile_rdf(self):
    g = Graph()
    @graph g

    @prefix ldp: <http://www.w3.org/ns/ldp#> .

    @prefix xhv: <https://www.w3.org/1999/xhtml/vocab#> .

    u = URIRef(self.instance_uri)
    +{ {u} a rdf:Bag ;
           rdfs:label {self.label} ;
           rdfs:comment {self.comment}@en }
    for member in self.members:
        if "uri" in member:
            member_uri = URIRef(member["uri"])
            +{ {u} rdfs:member {member_uri} }
            +{ {member_uri} rdfs:label {member["title"]} }
        elif isinstance(member, tuple):
            member_uri = URIRef(member[0])
            +{ {u} rdfs:member {member_uri} }
            +{ {member_uri} rdfs:label {member[1]} }
        else:
            +{ {u} rdfs:member {URIRef(member)} }

    # other Query String Arguments
    other_qsas = [x + "=" + self.request.query_params[x] for x in self.request.query_params if x not in ["page", "per_page"]]
    if len(other_qsas) > 0:
        other_qsas_str = "&".join(other_qsas) + "&"
    else:
        other_qsas_str = ''

    page_uri_str = "{}?{}per_page={}&page={}".format(self.instance_uri, other_qsas_str, self.per_page, self.page)
    page_uri_str_nonum = "{}?{}per_page={}&page=".format(self.instance_uri, other_qsas_str, self.per_page)
    page_uri = URIRef(page_uri_str)

    # pagination
    # this page
    +{ {page_uri} a ldp:Page ;
           ldp:pageOf {u} ;
           xhv:first {URIRef(page_uri_str_nonum + '1')} ;
           xhv:last {URIRef(page_uri_str_nonum + str(self.last_page))} }

    if self.page != 1:
        +{ {page_uri} xhv:prev {URIRef(page_uri_str_nonum + str(self.page - 1))} }

    if self.page != self.last_page:
        +{ {page_uri} xhv:next {URIRef(page_uri_str_nonum + str(self.page + 1))} }

    if self.parent_container_uri is not None:
        +{ {URIRef(self.parent_container_uri)} rdf:Bag {u} ;
               rdfs:member {u} }
        if self.parent_container_label is not None:
            +{ {URIRef(self.parent_container_uri)} rdfs:label {self.parent_container_label} }
    return g
