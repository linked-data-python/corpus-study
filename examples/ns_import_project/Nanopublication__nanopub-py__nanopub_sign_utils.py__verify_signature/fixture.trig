    ns1:decoy3 ns2:hasSignature "ZGVjb3kzLXNpZw==" ;
        ns2:hasSignatureTarget <http://purl.org/nanopub/temp/other3#> .

    ns1:decoy4 ns2:hasAlgorithm "RSA" ;
        ns2:hasSignatureTarget <http://purl.org/nanopub/temp/other4#> .

    <https://w3id.org/np/RA_dolDZ74j-ElpKlO72TF7xOEBRjUmxS4iREudSfrJk0#sig> ns2:hasAlgorithm "RSA" ;
