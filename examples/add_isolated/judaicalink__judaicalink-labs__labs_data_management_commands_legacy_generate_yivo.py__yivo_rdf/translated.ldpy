import rdflib
import re
from urllib.parse import quote
from ._dataset_command import jlo, jld, skos, dcterms, void, foaf, rdf

def yivo_rdf(graph: rdflib.Graph, resource_dict: dict):
    subject = local(resource_dict["uri"])
    graph += g{
        {subject} {jlo.title} {rdflib.Literal(resource_dict['title'])} ;
           {jlo.describedAt} {rdflib.URIRef(resource_dict["uri"])} ;
           {skos.prefLabel} {rdflib.Literal(resource_dict["title"])}
    }
    for l in resource_dict["links"]:	
            graph += g{ {subject} {skos.related} {local(l["href"])} }
            if len(l["text"])>0:
                graph += g{ {local(l["href"])} {skos.altLabel} {rdflib.Literal(l["text"])} }
    graph += g{ {subject} {jlo.hasAbstract} {rdflib.Literal(resource_dict["abstract"], "en")} }
    for sc in resource_dict["subconcepts"]:
            scu = rdflib.URIRef(str(subject) + "/" + quote(re.sub("[ ]+", "_", sc)))
            graph += g{
                {scu} {rdf.type} {skos.Concept} ;
                   {skos.broader} {subject} ;
                   {skos.prefLabel} {rdflib.Literal(sc)} .
                {subject} {skos.narrower} {scu}
            }
    for sr in resource_dict["subrecords"]:
            graph += g{ {subject} {skos.narrower} {local(sr.href)} }
    if "broader" in resource_dict:
            graph += g{ {subject} {skos.broader} {rdflib.URIRef(resource_dict["broader"])} }
    return graph
