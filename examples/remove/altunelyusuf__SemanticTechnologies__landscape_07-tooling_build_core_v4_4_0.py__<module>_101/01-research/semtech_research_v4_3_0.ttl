# Fixture standing in for 01-research/semtech_research_v4_3_0.ttl (see
# meta.json).  Written against the region, which wipes every skos:note of the
# corpus node before re-stating one: the corpus carries two stale notes (the
# object wildcard must take both), it carries other predicates that must stay,
# and -- the trap -- every publication of the corpus carries a skos:note of its
# own, which the region must not touch.
#
# The ten @prefix lines are the real file's header, verbatim
# (landscape/01-research/semtech_research_v4_3_0.ttl at bad0fa7c46): the
# script serialises g1 right after the region (build_core_v4_4_0.py:113), so
# the bindings the parse gives g1 are part of what the region must leave
# alone, and the driver compares them.
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix res: <http://example.org/rdodi/research-ontology#> .
@prefix schema: <https://schema.org/> .
@prefix semtech: <http://example.org/semtech#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sr: <http://example.org/semtech/research#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

sr:ResearchCorpus
    a res:Corpus ;
    rdfs:label "Semantic technology research corpus"@en ;
    skos:note "Quality scorecard v4.1 (4 components): topic coverage, citation strength, methodology compliance, verification disclosure."@en ;
    skos:note "Quality scorecard v4.0 (superseded)."@en ;
    dcterms:modified "2026-07-30" ;
    rdfs:member sr:Pub_walmart_retail_graph, sr:Pub_gql_iso_39075 .

# neighbourhood: skos:note on other subjects -- a pattern that forgot to pin
# the subject would empty these too
sr:Pub_walmart_retail_graph
    a res:Publication, owl:NamedIndividual ;
    rdfs:label "Walmart Retail Graph case study"@en ;
    skos:note "Verification level A: vendor-published case study."@en .

sr:Pub_gql_iso_39075
    a res:Publication, owl:NamedIndividual ;
    rdfs:label "ISO/IEC 39075:2024 (GQL)"@en ;
    skos:note "Verification level A: ISO catalogue entry."@en .

# zero match: a node with no skos:note at all
sr:Scorecard
    rdfs:label "Scorecard components"@en .
