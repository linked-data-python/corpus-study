from app.models.sensor_node import SensorNodeDB, SensorNodeOutSlim, SensorNodeLocation, SensorNodeStateEnum, ConfigurableAssignment, ConfigurableTypeEnum, SensorNodeLogbookEntry, SensorNodeLogbookEnum, TimeseriesData, TimeseriesField
from rdflib import Graph, URIRef, Literal, RDF
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .


def create_sensor_node(self, sensor_node: SensorNodeDB) -> SensorNodeDB:
    g = Graph()
    g.bind('schema', self.schema)
    g.bind('bfh', self.bfh)

    sensor_uri = URIRef(f"http://data.bfh.ch/sensorNodes/{sensor_node.uuid}")

    # Basisdaten
    g += g{
        {sensor_uri} a {URIRef(self.bfh + "SensorNode")} ;
           {URIRef(self.bfh + "identifier")} {Literal(str(sensor_node.uuid))} ;
           {URIRef(self.schema + "name")} {Literal(sensor_node.name)}
    }
    if sensor_node.description:
        g += g{ {sensor_uri} {URIRef(self.schema + "description")} {Literal(sensor_node.description)} }
    g += g{
        {sensor_uri} {URIRef(self.bfh + "state")} {URIRef(sensor_node.state.rdf_uri)} ;
           {URIRef(self.bfh + "ttnDeviceLink")} {Literal(str(sensor_node.ttn_device_link))} ;
           {URIRef(self.bfh + "gitlabRef")} {Literal(sensor_node.gitlab_ref)}
    }

    # Standort
    if sensor_node.location.latitude is not None:
        g += g{ {sensor_uri} {URIRef(self.bfh + "latitude")} {Literal(sensor_node.location.latitude)} }
    if sensor_node.location.longitude is not None:
        g += g{ {sensor_uri} {URIRef(self.bfh + "longitude")} {Literal(sensor_node.location.longitude)} }
    if sensor_node.location.altitude is not None:
        g += g{ {sensor_uri} {URIRef(self.bfh + "altitude")} {Literal(sensor_node.location.altitude)} }
    if sensor_node.location.postalcode:
        g += g{ {sensor_uri} {URIRef(self.bfh + "postalcode")} {Literal(sensor_node.location.postalcode)} }

    # Verlinkung zum NodeTemplate
    g += g{
        {sensor_uri} {URIRef(self.bfh + "usesNodeTemplate")} {URIRef(f"http://data.bfh.ch/nodeTemplates/{sensor_node.node_template_uuid}")} ;
           {URIRef(self.bfh + "partOfProject")} {URIRef(f"http://data.bfh.ch/projects/{sensor_node.project_uuid}")}
    }

    # Configurables
    for idx, conf in enumerate(sensor_node.configurables):
        conf_uri = URIRef(f"{sensor_uri}/configurable/{idx}")
        g += g{
            {sensor_uri} {URIRef(self.bfh + "hasConfigurable")} {conf_uri} .
            {conf_uri} a {URIRef(self.bfh + "ConfigurableAssignment")} ;
               {URIRef(self.schema + "name")} {Literal(conf.name)} ;
               {URIRef(self.bfh + "type")} {URIRef(conf.type.rdf_uri)} ;
               {URIRef(self.schema + "value")} {Literal(conf.value)}
        }
        if conf.display_value:
            g += g{ {conf_uri} {URIRef(self.bfh + "displayValue")} {Literal(conf.display_value)} }

    # Logbuch
    for idx, entry in enumerate(sensor_node.logbook):
        log_uri = URIRef(f"{sensor_uri}/log/{idx}")
        g += g{
            {sensor_uri} {URIRef(self.bfh + "hasLogEntry")} {log_uri} .
            {log_uri} a {URIRef(self.bfh + "LogEntry")} ;
               {URIRef(self.bfh + "logType")} {Literal(entry.type.value)} ;
               {URIRef(self.schema + "dateCreated")} {Literal(entry.date.isoformat())} ;
               {URIRef(self.schema + "creator")} {URIRef(f"http://data.bfh.ch/users/{entry.user.uuid}")}
        }

    # Persistiere Graph
    query = f"""INSERT DATA {{ {g.serialize(format='nt')} }}"""
    self.triplestore_client.update(query)

    return self.find_sensor_node_by_uuid(sensor_node.uuid)
