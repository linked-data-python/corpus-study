# The EXISTING ontology of the merge (second argument of the region).
# Written during translation, against the region.  Its companions are
# fixture_new.ttl (the freshly generated graph) and fixture_empty.ttl (the
# zero-solution case).
#
# It covers, on purpose:
#   * a subject shared with the new graph, carrying an AUTHORITATIVE predicate
#     the new graph redefines (rdf:type, rdfs:subClassOf -> dropped here,
#     re-added from the new graph, and that is where the removals happen);
#   * a shared subject whose authoritative predicate the new graph does NOT
#     define (ex:Actuator rdfs:domain) -- the "keep existing if not in new"
#     branch;
#   * MERGEABLE predicates (rdfs:label, rdfs:comment) and a predicate that is
#     neither (dcterms:description) -- both preserved, by two different paths;
#   * neighbours that share TWO terms with a triple the region tests or
#     removes (ex:Sensor rdfs:seeAlso ex:Device, ex:Actuator rdfs:seeAlso
#     ex:Device against subClassOf; the rdfs:domain of ex:Actuator against the
#     rdfs:domain of ex:Sensor in the new graph), so that a pattern widened to
#     a wildcard on subject, predicate or object changes the merge;
#   * falsy literals ("") on authoritative predicates;
#   * a subject that exists only here -- preserved wholesale, and a control
#     that no removal ever reaches it.
@prefix ex:      <http://example.org/onto#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

ex:Sensor a owl:Class ;
    rdfs:subClassOf ex:Device ;
    rdfs:label "Sensor (hand-written)"@en ;
    rdfs:comment "Kept from the existing file."@en ;
    dcterms:description "Neither authoritative nor mergeable."@en ;
    # neighbours of the subClassOf triples under test: same subject and same
    # object, ANOTHER predicate (mergeable, so preserved into the merge)
    rdfs:seeAlso ex:Device, ex:Component, ex:Physical ;
    # authoritative, redefined by the new graph with the falsy literal ""
    rdfs:range ex:Value .

ex:Actuator a owl:Class ;
    rdfs:domain ex:System ;
    # same subject and object as the new graph's ex:Actuator rdfs:subClassOf
    rdfs:seeAlso ex:Device ;
    # falsy literal on an authoritative predicate the new graph gives another
    # value ("0"): the existing "" is dropped as updated
    rdfs:range "" ;
    rdfs:label "Actuator"@en .

ex:LegacyThing a owl:Class ;
    rdfs:subClassOf ex:Device ;
    rdfs:label "Legacy thing"@en .
